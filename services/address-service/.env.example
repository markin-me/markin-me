ADDRESS_SERVICE_PORT=3400
# Must match ADDRESS_SERVICE_TOKEN in the main app .env.
ADDRESS_SERVICE_INTERNAL_TOKEN=change-me

# For the provided docker-compose.yml, keep 127.0.0.1:54329.
# If the service runs inside the same Docker network as PostgreSQL,
# use ADDRESS_DB_HOST=address-db and ADDRESS_DB_PORT=5432 instead.
ADDRESS_DB_HOST=127.0.0.1
ADDRESS_DB_PORT=54329
ADDRESS_DB_NAME=markin_address
ADDRESS_DB_USER=postgres
ADDRESS_DB_PASSWORD=postgres
ADDRESS_DB_SSL=0

ADDRESS_SERVICE_QUERY_LIMIT=20
ADDRESS_SERVICE_QUERY_TIMEOUT_MS=5000
