PAYMENT_SERVICE_HOST=127.0.0.1
PAYMENT_SERVICE_PORT=3500
# Required: generate a random ASCII token of at least 32 characters.
PAYMENT_SERVICE_INTERNAL_TOKEN=
PAYMENT_SERVICE_SHUTDOWN_MS=15000
PAYMENT_DB_HOST=
PAYMENT_DB_PORT=3306
PAYMENT_DB_USER=
PAYMENT_DB_PASSWORD=
PAYMENT_DB_NAME=
PAYMENT_DB_POOL_SIZE=8
PAYMENT_DB_CONNECT_TIMEOUT_MS=5000
PAYMENT_CREDENTIALS_MASTER_KEY=
PAYMENT_CREDENTIALS_KEY_VERSION=1
PAYMENT_PROVIDER_TIMEOUT_MS=3000
PAYMENT_PROVIDER_TEST_ENABLED=0
PAYMENT_PROVIDER_TEST_RETURN_URL=
PAYMENT_CHECKOUT_ENABLED=0
PAYMENT_CHECKOUT_ENVIRONMENT=test
PAYMENT_CHECKOUT_ALLOW_LOCAL_RETURN=0
PAYMENT_WEBHOOKS_ENABLED=0
PAYMENT_WEBHOOK_PUBLIC_URL=
PAYMENT_WEBHOOK_DEV_TUNNEL=0
# Enable after migration and private Main Backend callback are configured.
PAYMENT_MAIN_EVENTS_URL=http://127.0.0.1:3000/internal/v1/payment-events
# Exact proxy peers only. Leave empty when connecting directly.
PAYMENT_WEBHOOK_TRUSTED_PROXIES=
# Optional comma-separated override; defaults to the official YooKassa IP ranges.
PAYMENT_WEBHOOK_SOURCE_CIDRS=
PAYMENT_DELIVERY_POLL_MS=1000
PAYMENT_DELIVERY_MAX_ATTEMPTS=20
PAYMENT_DELIVERY_TIMEOUT_MS=10000

# Enable manually ONLY after 2026-10-10_payment_reconciliation.sql.
PAYMENT_RECONCILIATION_ENABLED=0
PAYMENT_RECONCILIATION_POLL_MS=30000
PAYMENT_RECONCILIATION_BATCH_SIZE=25
PAYMENT_RECONCILIATION_CONCURRENCY=2
PAYMENT_RECONCILIATION_CREATED_DELAY_SECONDS=60
PAYMENT_RECONCILIATION_PENDING_DELAY_SECONDS=120
PAYMENT_RECONCILIATION_CAPTURE_DELAY_SECONDS=300
PAYMENT_RECONCILIATION_MAX_DELAY_SECONDS=3600
PAYMENT_RECONCILIATION_HORIZON_HOURS=72
PAYMENT_RECONCILIATION_MAX_ATTEMPTS=100
PAYMENT_RECONCILIATION_CONNECTION_COOLDOWN_SECONDS=900
PAYMENT_REFRESH_COOLDOWN_SECONDS=15

# Main Backend (copy these settings into its root .env):
# PAYMENT_SERVICE_URL=http://127.0.0.1:3500
# PAYMENT_SERVICE_INTERNAL_TOKEN=<same token as the service>
# PAYMENT_SERVICE_TIMEOUT_MS=5000
# PAYMENT_ORDER_RELEASE_WORKER_ENABLED=1
# PAYMENT_CHECKOUT_RETURN_ORIGINS_JSON={"1":"https://your-shop.example"}
# Local test only: set PAYMENT_CHECKOUT_ALLOW_LOCAL_RETURN=1 in both environments
# and set PAYMENT_CHECKOUT_RETURN_ORIGINS_JSON={"1":"http://localhost:3000"} in Main Backend.
# Receipt settings: Company -> Payment methods -> Online payment receipts.

# Production hardening; retain existing queues when disabling checkout.
# NODE_ENV=production
# PAYMENT_OUTBOX_ENABLED=1
# Enable after applying 2026-10-11_payment_refund_recovery_and_support.sql.
PAYMENT_REFUNDS_ENABLED=0
PAYMENT_REFUND_RECOVERY_ENABLED=0
PAYMENT_ABANDONED_ORDER_HOURS=72
# Main Backend: PAYMENT_ABANDONED_CLEANUP_ENABLED=1; same horizon; release worker enabled.
# Production only, after documented acceptance; never enable for local tests.
PAYMENT_LIVE_RELEASE_APPROVED=0
# JSON object mapping old key versions to hex keys. Server environment only.
# PAYMENT_CREDENTIALS_PREVIOUS_KEYS={}
# Retention is disabled until policy is explicitly selected. Only done jobs are deleted.
# PAYMENT_INBOX_RETENTION_DAYS=
# PAYMENT_OUTBOX_RETENTION_DAYS=
