<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= mode === 'register' ? 'Регистрация' : 'Вход' %></title>
    <link rel="stylesheet" href="<%= assetUrl('/static/css/style.css') %>">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
    <style>
        body {
            background: var(--color-bg, #F9FAFB);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }
        .auth-container {
            max-width: 400px;
            width: 100%;
            padding: 40px;
            background: var(--color-surface, #fff);
            border: 1px solid var(--color-border, #e5e7eb);
            border-radius: var(--radius-md, 12px);
            box-shadow: var(--shadow-sm, 0 4px 6px -1px rgba(0,0,0,.10));
        }
        .auth-container h2 {
            text-align: center;
            margin-bottom: 30px;
            color: var(--color-text, #1F2937);
            font-weight: 600;
        }
        .auth-input {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid var(--color-border, #e5e7eb);
            border-radius: var(--radius-md, 12px);
            font-size: 16px;
            box-sizing: border-box;
            background: var(--color-surface, #fff);
            color: var(--color-text, #1F2937);
            transition: border-color var(--dur-fast, 220ms) var(--ease-smooth, cubic-bezier(.2,.8,.2,1));
        }
        .password-field-wrapper {
            position: relative;
            margin-bottom: 15px;
        }
        .password-field-wrapper .auth-input {
            padding-right: 85px;
            margin-bottom: 0;
        }
        .password-field-wrapper:not(.has-indicator) .auth-input {
            padding-right: 45px;
        }
        .auth-input:focus {
            outline: none;
            border-color: var(--color-primary, #f97316);
        }
        .auth-button {
            width: 100%;
            padding: 12px;
            background: var(--color-primary, #f97316);
            color: var(--on-primary, #fff);
            border: none;
            border-radius: var(--radius-md, 12px);
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            margin-top: 10px;
            transition: background var(--dur-fast, 220ms) var(--ease-smooth, cubic-bezier(.2,.8,.2,1)), 
                        transform var(--dur-fast, 220ms) var(--ease-smooth, cubic-bezier(.2,.8,.2,1));
        }
        .auth-button:hover {
            background: var(--color-primary-hover, #ea580c);
            transform: translateY(-1px);
        }
        .auth-button:active {
            transform: translateY(0);
        }
        .auth-switch {
            text-align: center;
            margin-top: 20px;
            color: var(--color-text-muted, #4b5563);
        }
        .auth-switch a {
            color: var(--color-primary, #f97316);
            text-decoration: none;
            font-weight: 500;
            transition: color var(--dur-fast, 220ms) var(--ease-smooth, cubic-bezier(.2,.8,.2,1));
        }
        .auth-switch a:hover {
            color: var(--color-primary-hover, #ea580c);
            text-decoration: underline;
        }
        .error-message {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
            padding: 12px;
            border-radius: var(--radius-md, 12px);
            margin-bottom: 15px;
            border: 1px solid rgba(220, 53, 69, 0.2);
            display: none;
            font-size: 14px;
        }
        .error-message.show {
            display: block;
        }
        .success-message {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
            padding: 12px;
            border-radius: var(--radius-md, 12px);
            margin-bottom: 15px;
            border: 1px solid rgba(40, 167, 69, 0.2);
            display: none;
            font-size: 14px;
        }
        .success-message.show {
            display: block;
        }
        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--color-text-muted, #4b5563);
            cursor: pointer;
            padding: 5px;
            font-size: 16px;
            transition: color var(--dur-fast, 220ms) var(--ease-smooth, cubic-bezier(.2,.8,.2,1));
            z-index: 2;
        }
        .password-toggle:hover {
            color: var(--color-text, #1F2937);
        }
        .password-match-indicator {
            position: absolute;
            right: 45px;
            top: 50%;
            transform: translateY(-50%);
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            pointer-events: none;
            z-index: 1;
            transition: color var(--dur-fast, 220ms) var(--ease-smooth, cubic-bezier(.2,.8,.2,1));
        }
        .password-match-indicator.show {
            display: flex;
        }
        .password-match-indicator i {
            font-size: 18px;
        }
        .password-match-indicator {
            color: #28a745;
        }
        .password-match-indicator.error {
            color: #dc3545;
        }
        .password-match-indicator.error i::before {
            content: "\f00d";
        }
        .auth-stage { display: none; }
        .auth-stage.is-active { display: block; }
        .auth-password-cancel { display: block; margin-top: 12px; text-align: center; color: var(--color-text-muted, #4b5563); }
        .auth-stage-copy { margin: -12px 0 20px; color: var(--color-text-muted, #4b5563); text-align: center; line-height: 1.5; }
        .auth-role-list { display: grid; gap: 10px; }
        .auth-role-card { width: 100%; text-align: left; padding: 14px; border: 1px solid var(--color-border, #e5e7eb); border-radius: var(--radius-md, 12px); background: var(--color-surface-2, #f3f4f6); color: var(--color-text, #1f2937); cursor: pointer; }
        .auth-role-card:hover { border-color: var(--color-primary, #f97316); }
        .auth-role-name { display: block; font-weight: 700; margin-bottom: 4px; }
        .auth-role-description, .auth-role-route { display: block; color: var(--color-text-muted, #4b5563); font-size: 13px; }
    </style>
</head>
<body>

    <div class="auth-container">
        <h2><%= mode === 'register' ? 'Регистрация магазина' : 'Вход в систему' %></h2>
        
        <div class="error-message" id="errorMsg"></div>
        <div class="success-message" id="successMsg"></div>

        <% if (mode === 'register') { %>
            <form id="registerForm">
                <input type="text" name="name" placeholder="Ваше имя" class="auth-input" required>
                <input type="email" name="email" placeholder="Email" class="auth-input" required>
                
                <div class="password-field-wrapper">
                    <input type="password" name="password" id="passwordInput" placeholder="Пароль (минимум 6 символов)" class="auth-input" required minlength="6">
                    <button type="button" class="password-toggle" data-target="passwordInput" aria-label="Показать пароль">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                
                <div class="password-field-wrapper has-indicator">
                    <input type="password" name="password_confirm" id="passwordConfirmInput" placeholder="Подтвердите пароль" class="auth-input" required minlength="6">
                    <div class="password-match-indicator" id="passwordMatchIndicator">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <button type="button" class="password-toggle" data-target="passwordConfirmInput" aria-label="Показать пароль">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                
                <input type="text" name="shop_name" placeholder="Название магазина" class="auth-input" required>
                <input type="text" name="slug" placeholder="URL-адрес магазина (опционально)" class="auth-input">
                <button type="submit" class="auth-button" id="registerSubmitBtn">Зарегистрироваться</button>
            </form>
        <% } else { %>
            <form id="loginForm">
                <input type="text" name="login" placeholder="Логин сотрудника@компания или email владельца" class="auth-input" required autocomplete="username" autocapitalize="off">
                <div class="password-field-wrapper">
                    <input type="password" name="password" id="loginPasswordInput" placeholder="Пароль" class="auth-input" required>
                    <button type="button" class="password-toggle" data-target="loginPasswordInput" aria-label="Показать пароль">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <button type="submit" class="auth-button">Войти</button>
            </form>
            <div class="auth-stage" id="passwordChangeStage">
                <div class="auth-stage-copy">Смена пароля добровольная. Введите текущий пароль и задайте новый.</div>
                <form id="passwordChangeForm">
                    <div class="password-field-wrapper"><input type="password" name="current_password" id="currentPasswordInput" placeholder="Текущий пароль" class="auth-input" required autocomplete="current-password"><button type="button" class="password-toggle" data-target="currentPasswordInput" aria-label="Показать пароль"><i class="fas fa-eye"></i></button></div>
                    <div class="password-field-wrapper"><input type="password" name="new_password" id="newPasswordInput" placeholder="От 12 символов: A–Z, a–z и цифры" class="auth-input" required minlength="12" maxlength="72"><button type="button" class="password-toggle" data-target="newPasswordInput" aria-label="Показать пароль"><i class="fas fa-eye"></i></button></div>
                    <div class="password-field-wrapper"><input type="password" name="new_password_confirm" id="newPasswordConfirmInput" placeholder="Повторите новый пароль" class="auth-input" required minlength="12" maxlength="72"><button type="button" class="password-toggle" data-target="newPasswordConfirmInput" aria-label="Показать пароль"><i class="fas fa-eye"></i></button></div>
                    <button type="submit" class="auth-button">Сменить пароль</button>
                </form>
                <a class="auth-password-cancel" href="/login">Отмена — вернуться в CRM</a>
            </div>
            <div class="auth-stage" id="roleSelectionStage">
                <div class="auth-stage-copy">У вас назначено несколько ролей. Выберите, в каком режиме продолжить работу.</div>
                <div class="auth-role-list" id="authRoleList"></div>
            </div>
        <% } %>

        <div class="auth-switch">
            <% if (mode === 'register') { %>
                Уже есть аккаунт? <a href="/login">Войти</a>
            <% } else { %>
                Нет аккаунта? <a href="/register">Зарегистрироваться</a>
            <% } %>
        </div>
    </div>

    <script src="<%= assetUrl('/static/js/auth.js') %>"></script>
    <script src="<%= assetUrl('/static/js/admin-persistent-cache.js') %>"></script>
    <script src="<%= assetUrl('/static/js/admin-local-repository.js') %>"></script>
    <script>
        const mode = '<%= mode %>';
        const pageAccessError = <%- JSON.stringify(typeof pageAccessError === 'string' ? pageAccessError : '').replace(/</g, '\\u003c') %>;
        let requestedPasswordChange = mode === 'login' && new URLSearchParams(window.location.search).get('change-password') === '1';
        const form = document.getElementById(mode === 'register' ? 'registerForm' : 'loginForm');
        const errorMsg = document.getElementById('errorMsg');
        const successMsg = document.getElementById('successMsg');
        const authTitle = document.querySelector('.auth-container h2');
        if (pageAccessError) window.AdminLocalRepository.reset({forget:true,reason:'server-refusal'});
        const authSwitch = document.querySelector('.auth-switch');

        function showError(text) { errorMsg.textContent = text; errorMsg.classList.add('show'); successMsg.classList.remove('show'); }
        function showSuccess(text) { successMsg.textContent = text; successMsg.classList.add('show'); errorMsg.classList.remove('show'); }
        function errorText(code) {
            if (document.getElementById('passwordChangeStage')?.classList.contains('is-active') && code === 'PASSWORD_TOO_SHORT') return 'Новый пароль должен содержать минимум 12 символов.';
            if (code === 'PASSWORD_TOO_WEAK') return 'Добавьте латинские буквы обоих регистров и цифры.';
            if (code === 'PASSWORD_TOO_LONG') return 'Пароль не должен превышать 72 байта.';
            const passwordErrors = { CURRENT_PASSWORD_REQUIRED:'Введите текущий пароль.', CURRENT_PASSWORD_INVALID:'Текущий пароль указан неверно.', PASSWORD_CHANGE_CONFLICT:'Пароль уже изменён. Войдите с актуальным паролем и повторите операцию.', PASSWORD_CHANGE_NOT_ALLOWED:'Для смены пароля войдите в учётную запись сотрудника.', PASSWORD_CHANGE_ERROR:'Не удалось изменить пароль.', INVALID_TOKEN:'Сессия истекла. Войдите снова.' };
            if (passwordErrors[code]) return passwordErrors[code];
            if (code === 'USER_ARCHIVED') return 'Сотрудник уволен. Обратитесь к владельцу компании.';
            if (code === 'SESSION_REVOKED') return 'Доступ этой сессии прекращён. Войдите снова.';
            const corporateErrors = { LOGIN_RATE_LIMITED:'Слишком много попыток входа. Попробуйте позже.', HTTPS_REQUIRED:'Вход доступен только по защищённому соединению HTTPS.' };
            if (corporateErrors[code]) return corporateErrors[code];
            return ({ EMAIL_EXISTS:'Этот email уже зарегистрирован', SLUG_EXISTS:'Этот URL-адрес уже занят', INVALID_EMAIL:'Неверный формат email', PASSWORD_TOO_SHORT:'Пароль должен быть минимум 6 символов', INVALID_CREDENTIALS:'Неверный логин или пароль', USER_BLOCKED:'Аккаунт заблокирован', TENANT_BLOCKED:'Магазин заблокирован', LOGIN_PASSWORD_REQUIRED:'Заполните логин и пароль', ROLE_NOT_ASSIGNED:'Пользователю не назначена роль.' })[code] || code || 'Ошибка';
        }
        function saveAuth(result) {
            if (localStorage.getItem('admin:logout-pending:v1')) throw new Error('Завершите выход из предыдущей сессии');
            if (result.token && localStorage.getItem('authToken') !== result.token && window.AdminLocalRepository) window.AdminLocalRepository.reset({forget:true});
            if (result.token) localStorage.setItem('authToken', result.token);
            if (result.user) localStorage.setItem('user', JSON.stringify(result.user));
            if (result.tenant) localStorage.setItem('tenant', JSON.stringify(result.tenant));
        }
        function escapeHtml(value) { return String(value || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }
        function showStage(id, title) {
            if (form) form.style.display = 'none';
            document.querySelectorAll('.auth-stage').forEach(stage => stage.classList.toggle('is-active', stage.id === id));
            if (authTitle) authTitle.textContent = title;
            if (authSwitch) authSwitch.style.display = 'none';
            errorMsg.classList.remove('show'); successMsg.classList.remove('show');
        }
        function continueAuth(result) {
            saveAuth(result);
            if (requestedPasswordChange && Number(result.user?.id) > 0) {
                requestedPasswordChange = false;
                return showStage('passwordChangeStage', 'Сменить пароль');
            }
            if (result.next === 'select-role') return showRoleSelection(result.roles || []);
            showSuccess('Вход выполнен. Перенаправление...');
            setTimeout(() => { window.location.href = result.redirect || '/dashboard/products'; }, 300);
        }
        function showRoleSelection(roles) {
            showStage('roleSelectionStage', 'Выберите роль');
            const list = document.getElementById('authRoleList');
            list.innerHTML = roles.map(role => `<button class="auth-role-card" type="button" data-role-id="${Number(role.id)}"><span class="auth-role-name">${escapeHtml(role.name)}</span><span class="auth-role-description">${escapeHtml(role.description)}</span><span class="auth-role-route">Стартовый раздел: ${escapeHtml(role.start_route)}</span></button>`).join('');
        }

        document.querySelectorAll('.password-toggle').forEach(btn => btn.addEventListener('click', function() {
            const input = document.getElementById(this.getAttribute('data-target')); const icon = this.querySelector('i');
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.classList.toggle('fa-eye', input.type === 'password'); icon.classList.toggle('fa-eye-slash', input.type !== 'password');
        }));

        if (mode === 'register') {
            const passwordInput = document.getElementById('passwordInput');
            const passwordConfirmInput = document.getElementById('passwordConfirmInput');
            const indicator = document.getElementById('passwordMatchIndicator');
            const check = () => { const matches = passwordInput.value === passwordConfirmInput.value && passwordInput.value.length >= 6; indicator.classList.toggle('show', passwordConfirmInput.value.length > 0); indicator.classList.toggle('error', !matches); indicator.innerHTML = matches ? '<i class="fas fa-check-circle"></i>' : '<i class="fas fa-times-circle"></i>'; };
            passwordInput.addEventListener('input', check); passwordConfirmInput.addEventListener('input', check);
        }

        form.addEventListener('submit', async event => {
            event.preventDefault(); errorMsg.classList.remove('show'); successMsg.classList.remove('show');
            const data = Object.fromEntries(new FormData(form));
            if (mode === 'register' && data.password !== data.password_confirm) return showError('Пароли не совпадают');
            delete data.password_confirm;
            try {
                if (!await finishBrowserLogout()) return showError('Подключитесь к сети, чтобы завершить предыдущий выход');
                sessionStorage.removeItem('admin:browser-session-attempt');
                if (getAuthToken()) {
                  window.AdminLocalRepository.reset({forget:true,reason:'identity-change'});
                  localStorage.removeItem('authToken'); localStorage.removeItem('user'); localStorage.removeItem('tenant');
                }
                const authState = captureAuthState();
                const response = await fetch(mode === 'register' ? '/api/auth/register' : '/api/auth/login', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
                const result = await response.json();
                if (!authState.isCurrent()) return;
                if (!response.ok || !result.ok) return showError(errorText(result.error));
                continueAuth(result);
            } catch (error) { console.error(error); showError('Ошибка соединения с сервером'); }
        });

        const passwordChangeForm = document.getElementById('passwordChangeForm');
        if (passwordChangeForm) passwordChangeForm.addEventListener('submit', async event => {
            event.preventDefault();
            const data = Object.fromEntries(new FormData(passwordChangeForm));
            if (data.new_password !== data.new_password_confirm) return showError('Пароли не совпадают');
            try {
                const authState = captureAuthState();
                const response = await fetch('/api/auth/change-password', { method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer '+localStorage.getItem('authToken')}, body:JSON.stringify({current_password:data.current_password, new_password:data.new_password}) });
                const result = await response.json();
                if (!authState.isCurrent()) return;
                if (!response.ok || !result.ok) return showError(errorText(result.error));
                continueAuth(result);
            } catch (error) { console.error(error); showError('Ошибка соединения с сервером'); }
        });

        const roleList = document.getElementById('authRoleList');
        if (roleList) roleList.addEventListener('click', async event => {
            const card = event.target.closest('[data-role-id]'); if (!card) return;
            try {
                const authState = captureAuthState();
                const response = await fetch('/api/auth/active-role', { method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer '+localStorage.getItem('authToken')}, body:JSON.stringify({role_id:Number(card.dataset.roleId)}) });
                const result = await response.json();
                if (!authState.isCurrent()) return;
                if (!response.ok || !result.ok) return showError(errorText(result.error));
                continueAuth({...result, next:'dashboard'});
            } catch (error) { console.error(error); showError('Ошибка соединения с сервером'); }
        });

        if (pageAccessError) showError(pageAccessError);
        if (mode === 'login' && !pageAccessError && !localStorage.getItem('admin:logout-pending:v1')) {
            const token = getAuthToken();
            if (token) {
                try {
                    let tokenPayload = token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');
                    while (tokenPayload.length % 4) tokenPayload += '=';
                    const payload = JSON.parse(atob(tokenPayload));
                    if (requestedPasswordChange && Number(payload.userId) > 0) {
                        requestedPasswordChange = false;
                        showStage('passwordChangeStage', 'Сменить пароль');
                    }
                    else if (payload.authStage === 'role-selection') {
                      const roleAccess = captureAuthState();
                      fetch('/api/auth/me', {headers:{'Authorization':'Bearer '+token}}).then(r=>r.json()).then(result=> {
                        if (!roleAccess.isCurrent()) return;
                        if (result.ok) showRoleSelection(result.roles || []);
                        else { window.AdminLocalRepository.reset({forget:true,reason:'server-refusal'}); showError(errorText(result.error)); }
                      }).catch(error => showError('Ошибка проверки сессии: ' + error.message));
                    }
                    else {
                      const nextParam = new URLSearchParams(window.location.search).get('next');
                      const next = nextParam && /^\/dashboard\/[a-z-]+(?:\?|$)/.test(nextParam) && !nextParam.includes('\\') ? nextParam : null;
                      const attempt = JSON.parse(sessionStorage.getItem('admin:browser-session-attempt') || 'null');
                      if (attempt && Date.now() - attempt.at < 30000 && attempt.next === next) {
                        showError('Не удалось подключить браузерную сессию. Проверьте разрешение cookie и повторите вход.');
                      } else {
                      sessionStorage.setItem('admin:browser-session-attempt', JSON.stringify({at:Date.now(),next}));
                      const browserAccess = captureAuthState();
                      fetch('/api/auth/browser-session', {method:'POST',headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json'},body:'{}'})
                        .then(async response => ({response, result:await response.json().catch(()=>({}))}))
                        .then(({response, result}) => {
                            if (getAuthToken() !== token || !browserAccess.isCurrent()) return;
                            if (response.ok && result.ok) {
                                if (!result.active_role && result.roles?.length > 1) return showRoleSelection(result.roles);
                                window.location.href = next || result.active_role?.start_route || '/dashboard/products';
                                return;
                            }
                            if (response.status === 401 || response.status === 403) {
                              window.AdminLocalRepository.reset({forget:true,reason:'server-refusal'});
                              localStorage.removeItem('authToken');
                            }
                            showError(errorText(result.error));
                        })
                        .catch(error => showError('Не удалось подключить браузерную сессию: ' + error.message));
                      }
                    }
                } catch (_) { localStorage.removeItem('authToken'); }
            }
        }
    </script>

    <script src="<%= assetUrl('/static/js/theme.js') %>"></script>

</body>
</html>
