<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <%
    const appleIcon = (typeof tenant !== 'undefined' && tenant) ? (tenant.apple_touch_icon_url || tenant.logo_light_url || tenant.logo_dark_url || tenant.favicon_light_url || tenant.favicon_dark_url) : '';
    const shopManifestVersion = (typeof tenant !== 'undefined' && tenant && tenant.updated_at) ? String(tenant.updated_at) : String(appVersion || '');
    const shopManifestStartPath = typeof currentPath === 'string' && currentPath ? currentPath : '/shop';
    const shopManifestHref = manifestUrl({
      appType: 'shop',
      startPath: shopManifestStartPath,
      tenantId: tenantId || ((typeof tenant !== 'undefined' && tenant && tenant.id) ? tenant.id : 0),
      versionToken: shopManifestVersion
    });
    const shopPwaTitle = (typeof tenant !== 'undefined' && tenant && (tenant.site_name || tenant.name))
      ? (tenant.site_name || tenant.name)
      : (pageTitle || 'Витрина');
  %>
  <title><%= pageTitle || 'Витрина' %></title>
  <meta name="tenant_id" content="<%= tenantId || 1 %>" />
  <link id="appFavicon" rel="icon" />
  <link id="appAppleTouchIcon" rel="apple-touch-icon" href="<%= appleIcon || '' %>" />
  <link id="appManifest" rel="manifest" href="<%= shopManifestHref %>" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="<%= shopPwaTitle %>" id="appAppleMobileWebAppTitle" />
  <meta name="theme-color" content="#ffffff" id="themeColorMeta" />

  <script>
    (function () {
      try {
        var t = 'light'; // временно принудительно светлая тема
        document.documentElement.setAttribute('data-theme', t);
        var m = document.getElementById('themeColorMeta');
        if (m) m.content = t === 'dark' ? '#1a1a1a' : '#ffffff';
      } catch (e) {}
    })();
  </script>
  <script>
    window.__APP_VERSION__ = <%- JSON.stringify(appVersion || '') %>;
    window.__APP_MANIFEST_CONTEXT__ = {
      app: 'shop',
      startPath: <%- JSON.stringify(shopManifestStartPath) %>,
      tenantId: <%- JSON.stringify((tenantId || ((typeof tenant !== 'undefined' && tenant && tenant.id) ? tenant.id : 0)) || 0) %>,
      versionToken: <%- JSON.stringify(shopManifestVersion) %>
    };
  </script>
  <% if (typeof tenant !== 'undefined' && tenant) { %>
    <script>
      (function () {
        try {
          var tenantData = <%- JSON.stringify(tenant) %>;
          if (tenantData) {
            localStorage.setItem('tenant', JSON.stringify(tenantData));
          }
        } catch (e) {}
      })();
    </script>
  <% } %>

  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="preload" href="<%= assetUrl('/static/css/shop.css?v=20260410d') %>" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="<%= assetUrl('/static/css/shop.css?v=20260410d') %>" /></noscript>
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" /></noscript>
</head>

<body class="<%= pageClass || '' %>">
  <div id="shopSplash" style="position:fixed;inset:0;z-index:99999;background:#fff;display:flex;align-items:center;justify-content:center;transition:opacity .3s ease;opacity:1;">
    <div style="display:flex;flex-direction:column;align-items:center;gap:16px;">
      <% const splashLogo = (typeof tenant !== 'undefined' && tenant) ? (tenant.logo_light_url || tenant.logo_dark_url || '') : ''; %>
      <% if (splashLogo) { %>
        <img src="<%= splashLogo %>" alt="" style="width:64px;height:64px;border-radius:16px;object-fit:cover;" />
      <% } %>
      <div style="width:48px;height:3px;background:#eee;border-radius:2px;overflow:hidden;">
        <div style="width:40%;height:100%;background:#f60;border-radius:2px;animation:splashBar 1.2s ease-in-out infinite;"></div>
      </div>
    </div>
    <style>@keyframes splashBar{0%{transform:translateX(-100%)}50%{transform:translateX(150%)}100%{transform:translateX(-100%)}}#shopSplash.is-done{opacity:0;pointer-events:none}</style>
  </div>
  <noscript><style>#shopSplash{display:none!important}</style></noscript>
  <%- include('../partials/header', { logoHref: '/shop', hideBurger: true, showCitySelector: true }) %>

  <div id="shopConnectionBanner" class="shop-connection-banner hidden" aria-live="polite" role="status">
    <span class="shop-connection-banner__text"></span>
  </div>

  <div class="main-container shop-main shop-grid">
    <section class="page-col page-col-left">
      <%- include(leftPartial) %>
    </section>

    <section class="page-col page-col-center">
      <%- include(centerPartial) %>
    </section>

    <section class="page-col page-col-right">
      <%- include(rightPartial) %>
    </section>
  </div>

  <!-- Универсальная модалка (на мобиле = bottom sheet) -->
  <%- include('../partials/shop/companyChat') %>
  <%- include('../partials/modal') %>

  <% if (typeof extraPartial !== 'undefined' && extraPartial) { %>
    <%- include(extraPartial) %>
  <% } %>

  <script>window.__shopLateUrl = "<%= assetUrl('/static/js/shop-late.js?v=20260317a') %>";window.__shopChatUrl = "<%= assetUrl('/static/js/shop-company-chat.js?typing_hotfix=14&v=20260412a') %>";</script>
  <script src="<%= assetUrl('/static/js/theme.js') %>" defer></script>
  <script src="<%= assetUrl('/static/js/appModal.js') %>" defer></script>

  <% if (Array.isArray(pageScripts)) { %>
    <% pageScripts.forEach(function (src) { %>
      <script src="<%= assetUrl(src) %>" defer></script>
    <% }) %>
  <% } %>
  <script>
    (function () {
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js?v=<%= encodeURIComponent(serviceWorkerVersion || appVersion || "") %>', { scope: '/' }).catch(function () {});
        });
      }
    })();
  </script>
  <script>
    (function () {
      var banner = document.getElementById('shopConnectionBanner');
      var textEl = banner && banner.querySelector('.shop-connection-banner__text');
      if (!banner || !textEl) return;

      function showOffline() {
        window.clearTimeout(banner._onlineHideTimer);
        banner.classList.remove('hidden', 'shop-connection-banner--online');
        banner.classList.add('shop-connection-banner--offline');
        textEl.textContent = 'Нет подключения к интернету';
      }

      function showOnline() {
        banner.classList.remove('hidden', 'shop-connection-banner--offline');
        banner.classList.add('shop-connection-banner--online');
        textEl.textContent = 'Подключение восстановлено';
        window.clearTimeout(banner._onlineHideTimer);
        banner._onlineHideTimer = window.setTimeout(function () {
          banner.classList.add('hidden');
        }, 2500);
      }

      function hide() {
        banner.classList.add('hidden');
        banner.classList.remove('shop-connection-banner--offline', 'shop-connection-banner--online');
      }

      window.addEventListener('offline', showOffline);
      window.addEventListener('online', showOnline);

      if (!navigator.onLine) {
        showOffline();
      } else {
        hide();
      }
    })();
  </script>
</body>
</html>
