<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Витрина' %></title>
  <meta name="tenant_id" content="<%= tenantId || 1 %>" />
  <link id="appFavicon" rel="icon" />
  <% const appleIcon = (typeof tenant !== 'undefined' && tenant) ? (tenant.apple_touch_icon_url || tenant.logo_light_url || tenant.logo_dark_url || tenant.favicon_light_url || tenant.favicon_dark_url) : ''; %>
  <% const manifestVer = (typeof tenant !== 'undefined' && tenant && tenant.updated_at) ? encodeURIComponent(String(tenant.updated_at)) : ''; %>
  <link id="appAppleTouchIcon" rel="apple-touch-icon" href="<%= appleIcon || '' %>" />
  <link id="appManifest" rel="manifest" href="/manifest.json<%= manifestVer ? ('?v=' + manifestVer) : '' %>" />
  <meta name="theme-color" content="#ffffff" id="themeColorMeta" />

  <script>
    (function () {
      try {
        var t = 'light'; // временно принудительно светлая тема
        document.documentElement.setAttribute('data-theme', t);
        var m = document.getElementById('themeColorMeta');
        if (m) m.content = t === 'dark' ? '#1a1a1a' : '#ffffff';
      } catch (e) {}
    })();
  </script>
  <% if (typeof tenant !== 'undefined' && tenant) { %>
    <script>
      (function () {
        try {
          var tenantData = <%- JSON.stringify(tenant) %>;
          if (tenantData) {
            localStorage.setItem('tenant', JSON.stringify(tenantData));
          }
        } catch (e) {}
      })();
    </script>
  <% } %>

  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" /></noscript>

  <link rel="preload" href="<%= assetUrl('/static/css/shop.css') %>" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="<%= assetUrl('/static/css/shop.css') %>" /></noscript>
  <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" /></noscript>
</head>

<body class="<%= pageClass || '' %>">
  <%- include('../partials/header', { logoHref: '/shop', hideBurger: true, showCitySelector: true }) %>

  <div id="shopConnectionBanner" class="shop-connection-banner hidden" aria-live="polite" role="status">
    <span class="shop-connection-banner__text"></span>
  </div>

  <div class="main-container shop-main shop-grid">
    <section class="page-col page-col-left">
      <%- include(leftPartial) %>
    </section>

    <section class="page-col page-col-center">
      <%- include(centerPartial) %>
    </section>

    <section class="page-col page-col-right">
      <%- include(rightPartial) %>
    </section>
  </div>

  <!-- Универсальная модалка (на мобиле = bottom sheet) -->
  <%- include('../partials/shop/companyChat') %>
  <%- include('../partials/modal') %>

  <% if (typeof extraPartial !== 'undefined' && extraPartial) { %>
    <%- include(extraPartial) %>
  <% } %>

  <script>window.__shopLateUrl = "<%= assetUrl('/static/js/shop-late.js') %>";</script>
  <script src="<%= assetUrl('/static/js/theme.js') %>" defer></script>
  <script src="<%= assetUrl('/static/js/appModal.js') %>" defer></script>

  <% if (Array.isArray(pageScripts)) { %>
    <% pageScripts.forEach(function (src) { %>
      <script src="<%= assetUrl(src) %>" defer></script>
    <% }) %>
  <% } %>
  <script>
    (function () {
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () {});
        });
      }
    })();
  </script>
  <script>
    (function () {
      var banner = document.getElementById('shopConnectionBanner');
      var textEl = banner && banner.querySelector('.shop-connection-banner__text');
      if (!banner || !textEl) return;

      function showOffline() {
        window.clearTimeout(banner._onlineHideTimer);
        banner.classList.remove('hidden', 'shop-connection-banner--online');
        banner.classList.add('shop-connection-banner--offline');
        textEl.textContent = 'Нет подключения к интернету';
      }

      function showOnline() {
        banner.classList.remove('hidden', 'shop-connection-banner--offline');
        banner.classList.add('shop-connection-banner--online');
        textEl.textContent = 'Подключение восстановлено';
        window.clearTimeout(banner._onlineHideTimer);
        banner._onlineHideTimer = window.setTimeout(function () {
          banner.classList.add('hidden');
        }, 2500);
      }

      function hide() {
        banner.classList.add('hidden');
        banner.classList.remove('shop-connection-banner--offline', 'shop-connection-banner--online');
      }

      window.addEventListener('offline', showOffline);
      window.addEventListener('online', showOnline);

      if (!navigator.onLine) {
        showOffline();
      } else {
        hide();
      }
    })();
  </script>
</body>
</html>
