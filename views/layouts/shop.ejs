<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Витрина' %></title>
  <meta name="tenant_id" content="<%= tenantId || 1 %>" />
  <link id="appFavicon" rel="icon" />
  <% const appleIcon = (typeof tenant !== 'undefined' && tenant) ? (tenant.apple_touch_icon_url || tenant.logo_light_url || tenant.logo_dark_url || tenant.favicon_light_url || tenant.favicon_dark_url) : ''; %>
  <% const manifestVer = (typeof tenant !== 'undefined' && tenant && tenant.updated_at) ? encodeURIComponent(String(tenant.updated_at)) : ''; %>
  <link id="appAppleTouchIcon" rel="apple-touch-icon" href="<%= appleIcon || '' %>" />
  <link id="appManifest" rel="manifest" href="/manifest.json<%= manifestVer ? ('?v=' + manifestVer) : '' %>" />

  <script>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (!t) {
          t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <% if (typeof tenant !== 'undefined' && tenant) { %>
    <script>
      (function () {
        try {
          var tenantData = <%- JSON.stringify(tenant) %>;
          if (tenantData) {
            localStorage.setItem('tenant', JSON.stringify(tenantData));
          }
        } catch (e) {}
      })();
    </script>
  <% } %>

  <link rel="stylesheet" href="/static/css/style.css" />
  <link rel="stylesheet" href="/static/css/shop.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body class="<%= pageClass || '' %>">
  <%- include('../partials/header', { logoHref: '/shop', hideBurger: true, showCitySelector: true }) %>

  <div class="main-container shop-main shop-grid">
    <section class="page-col page-col-left">
      <%- include(leftPartial) %>
    </section>

    <section class="page-col page-col-center">
      <%- include(centerPartial) %>
    </section>

    <section class="page-col page-col-right">
      <%- include(rightPartial) %>
    </section>
  </div>

  <!-- Универсальная модалка (на мобиле = bottom sheet) -->
  <%- include('../partials/modal') %>

  <% if (typeof extraPartial !== 'undefined' && extraPartial) { %>
    <%- include(extraPartial) %>
  <% } %>

  <script src="/static/js/theme.js"></script>
  <script src="/static/js/appModal.js"></script>

  <% if (Array.isArray(pageScripts)) { %>
    <% pageScripts.forEach(function (src) { %>
      <script src="<%= src %>"></script>
    <% }) %>
  <% } %>
</body>
</html>
