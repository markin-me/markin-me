<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle || 'Админка' %></title>

  <script>
    (function () {
      try {
        var c = localStorage.getItem('sidebar:collapsed');
        document.documentElement.setAttribute('data-sidebar-collapsed', c === '1' ? '1' : '0');

        var t = localStorage.getItem('theme');
        if (!t) {
          t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>

  <link rel="stylesheet" href="/static/css/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body class="<%= pageClass || '' %>">
  <%- include('../partials/header') %>

  <div class="main-container app-grid">
    <%- include('../partials/sidebar', { activePage: activePage || '' }) %>

    <section class="page-col page-col-left">
      <%- include(leftPartial) %>
    </section>

    <section class="page-col page-col-center">
      <%- include(centerPartial) %>
    </section>

    <section class="page-col page-col-right">
      <%- include(rightPartial) %>
    </section>
  </div>

  <div id="sidebarOverlay" class="sidebar-overlay"></div>

  <!-- ✅ Универсальная модалка -->
  <%- include('../partials/modal') %>

  <% if (typeof extraPartial !== 'undefined' && extraPartial) { %>
    <%- include(extraPartial) %>
  <% } %>

  <!-- Скрипты -->
  <script src="/static/js/auth.js"></script>
  <script src="/static/js/theme.js"></script>
  <script src="/static/js/sidebar.js"></script>

  <!-- ✅ Модалка -->
  <script src="/static/js/appModal.js"></script>

  <!-- Кнопка профиля / выхода -->
  <script>
    (function () {
      try {
        var btn = document.getElementById('shopProfileBtn');
        var menuWrapper = btn ? btn.closest('.user-menu-wrapper') : null;
        var dropdown = document.getElementById('userMenuDropdown');
        var logoutBtn = document.getElementById('userMenuLogout');
        
        if (!btn || !menuWrapper || !dropdown) return;

        // Функция для обновления информации о пользователе
        function updateUserInfo() {
          try {
            var userStr = localStorage.getItem('user');
            var tenantStr = localStorage.getItem('tenant');
            
            var nameEl = document.getElementById('userMenuName');
            var emailEl = document.getElementById('userMenuEmail');
            var tenantEl = document.getElementById('userMenuTenant');
            
            if (userStr && tenantStr) {
              var user = JSON.parse(userStr);
              var tenant = JSON.parse(tenantStr);
              
              if (nameEl) nameEl.textContent = user.name || 'Пользователь';
              if (emailEl) emailEl.textContent = user.email || '';
              if (tenantEl) tenantEl.textContent = tenant.name || 'Магазин';
            } else {
              if (nameEl) nameEl.textContent = 'Не авторизован';
              if (emailEl) emailEl.textContent = '';
              if (tenantEl) tenantEl.textContent = '';
            }
          } catch (e) {
            console.error('Error updating user info:', e);
          }
        }

        // Открытие/закрытие меню
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          
          // Если не авторизован — идём на логин
          if (typeof isAuthenticated === 'function' && !isAuthenticated()) {
            window.location.href = '/login';
            return;
          }
          
          // Переключаем меню
          menuWrapper.classList.toggle('active');
          updateUserInfo();
        });

        // Кнопка выхода
        if (logoutBtn) {
          logoutBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (typeof logout === 'function') {
              logout();
            } else {
              localStorage.removeItem('authToken');
              localStorage.removeItem('user');
              localStorage.removeItem('tenant');
              window.location.href = '/login';
            }
          });
        }

        // Закрытие меню при клике вне его
        document.addEventListener('click', function (e) {
          if (menuWrapper && !menuWrapper.contains(e.target)) {
            menuWrapper.classList.remove('active');
          }
        });

        // Обновляем информацию при загрузке
        updateUserInfo();

        // Проверка авторизации для страниц dashboard
        if (window.location.pathname.startsWith('/dashboard/')) {
          var token = localStorage.getItem('authToken');
          if (!token) {
            window.location.href = '/login';
          }
        }
      } catch (e) {
        console.error('Header user menu init error:', e);
      }
    })();
  </script>

  <% if (Array.isArray(pageScripts)) { %>
    <% pageScripts.forEach(function (src) { %>
      <script src="<%= src %>"></script>
    <% }) %>
  <% } %>
</body>
</html>
