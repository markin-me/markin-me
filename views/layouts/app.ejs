<!DOCTYPE html>
<html lang="ru" data-local-access="pending">
<head>
  <%
    const appPageClassName = typeof pageClass === 'string' ? pageClass : '';
    const isChatViewportLocked = appPageClassName.split(/\s+/).includes('page-chat');
    const appViewportBaseContent = isChatViewportLocked
      ? 'width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no'
      : 'width=device-width, initial-scale=1.0';
    const appViewportContent = appViewportBaseContent + ', viewport-fit=cover';
  %>
  <meta charset="UTF-8" />
  <style>
    html:not([data-local-access="active"]) body > :not(#adminLocalAccessState):not(script):not(style) { display: none !important; }
    #adminLocalAccessState { max-width: 28rem; margin: 15vh auto; padding: 1.5rem; font-family: sans-serif; }
    html[data-local-access="active"] #adminLocalAccessState { display: none; }
    #adminLocalAccessFailure { display: none; }
    html[data-local-access="denied"] #adminLocalAccessFailure,
    html[data-local-access="unavailable"] #adminLocalAccessFailure { display: block; }
    html[data-local-access="denied"] #adminLocalAccessChecking,
    html[data-local-access="unavailable"] #adminLocalAccessChecking { display: none; }
  </style>
  <% if (typeof neutralShell !== 'undefined' && neutralShell === true) { %>
    <script>window.__ADMIN_NEUTRAL_SHELL__ = true;</script>
  <% } %>
  <% if (typeof productsShell !== 'undefined' && productsShell === true) { %>
    <script>window.__ADMIN_PRODUCTS_SHELL__ = true;</script>
  <% } %>
  <% if (typeof dashboardShell !== 'undefined' && dashboardShell === true) { %>
    <script>window.__ADMIN_DASHBOARD_SHELL__ = true;</script>
  <% } %>
  <script src="<%= assetUrl('/static/js/auth.js') %>"></script>
  <script src="<%= assetUrl('/static/js/admin-persistent-cache.js?v=20261014-local-core-v1') %>"></script>
  <script src="<%= assetUrl('/static/js/admin-local-repository.js?v=20261014-local-core-v1') %>"></script>
  <script src="<%= assetUrl('/static/js/admin-idle-hydration.js') %>"></script>
  <script>
    (function () {
      var visibleScope = null;
      function lock(state) {
        document.documentElement.setAttribute('data-local-access', typeof state === 'string' ? state : 'pending');
      }
      window.addEventListener('admin:local-context-changed', function (event) {
        if (event.detail && event.detail.state === 'active') return;
        var detail = event.detail || {};
        var checking = detail.state === 'pending';
        var unavailable = ['offline-unavailable', 'server-unavailable', 'confirmation-invalid', 'local-context-error'].includes(detail.reason);
        lock(checking ? 'pending' : unavailable ? 'unavailable' : 'denied');
        window.AdminAccessContext = null;
        if (checking) return;
        if (window.AdminPersistentCache) window.AdminPersistentCache.resetRuntimeScope();
        var message = document.getElementById('adminLocalAccessMessage');
        if (message) message.textContent = unavailable
          ? 'Не удалось подтвердить доступ. Подключитесь к сети и повторите проверку. Личные данные скрыты.'
          : 'Контекст доступа недоступен или изменён. Подключитесь к сети и повторите проверку. Личные данные скрыты.';
      });
      window.showConfirmedAdminInterface = function () {
        var repository = window.AdminLocalRepository;
        if (!repository || !repository.isActive()) { lock(); return; }
        var scope = repository.create({ domain: 'interface', version: 1 });
        if (visibleScope && visibleScope !== scope.namespace) { lock(); window.location.reload(); return; }
        visibleScope = scope.namespace;
        document.documentElement.setAttribute('data-local-access', 'active');
      };
      window.addEventListener('pagehide', lock);
      function checkVisibleContext() {
        if (!document.hidden && document.documentElement.getAttribute('data-local-access') === 'active'
            && !window.AdminLocalRepository.isActive()) {
          window.AdminLocalRepository.reset({ forget: true, broadcast: false, reason: 'remote-context' });
        }
      }
      window.addEventListener('focus', checkVisibleContext);
      document.addEventListener('visibilitychange', checkVisibleContext);
      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          lock();
          if (window.reloadAdminAccessContext) window.AdminAccessContextPromise = window.reloadAdminAccessContext();
        }
      });
    })();
  </script>
  <script>
    window.AdminServerAccessContext = <%- JSON.stringify(typeof serverAccessContext !== 'undefined' ? serverAccessContext : null).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') %>;
    if (window.AdminServerAccessContext) {
      window.AdminServerContextPromise = confirmServerAccessContext(window.AdminServerAccessContext);
    }
  </script>
  <meta name="viewport" content="<%= appViewportContent %>" />
  <%
