<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    const appManifestStartPath = typeof currentPath === 'string' && currentPath ? currentPath : '/dashboard/cash';
    const appManifestTitle = typeof pageTitle === 'string' && pageTitle.trim() ? pageTitle.trim() : 'Админка';
    const appManifestHref = manifestUrl({
      appType: 'admin',
      startPath: appManifestStartPath,
      title: appManifestTitle,
      versionToken: appVersion || ''
    });
  %>
  <title><%= pageTitle || 'Админка' %></title>
  <link id="appFavicon" rel="icon" />
  <link id="appAppleTouchIcon" rel="apple-touch-icon" />
  <link id="appManifest" rel="manifest" href="<%= appManifestHref %>" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Админка" id="appAppleMobileWebAppTitle" />

  <script>
    (function () {
      try {
        var c = localStorage.getItem('sidebar:collapsed');
        document.documentElement.setAttribute('data-sidebar-collapsed', c === '1' ? '1' : '0');

        var t = 'light'; // временно принудительно светлая тема
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <script>
    window.__APP_VERSION__ = <%- JSON.stringify(appVersion || '') %>;
    window.__APP_MANIFEST_CONTEXT__ = {
      app: 'admin',
      startPath: <%- JSON.stringify(appManifestStartPath) %>,
      tenantId: 0,
      versionToken: <%- JSON.stringify(appVersion || '') %>,
      installTitle: <%- JSON.stringify(appManifestTitle) %>,
      installShortName: <%- JSON.stringify(appManifestTitle) %>
    };
    (function () {
      var appleTitleMeta = document.getElementById('appAppleMobileWebAppTitle');
      if (appleTitleMeta) {
        appleTitleMeta.setAttribute('content', <%- JSON.stringify(appManifestTitle) %>);
      }
    })();
  </script>

  <link rel="stylesheet" href="<%= assetUrl('/static/css/style.css?v=20260319b') %>" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" />
</head>

<%
  const appActivePage = activePage || '';
  const appTenantChatWidgetRaw = (typeof tenant !== 'undefined' && tenant) ? tenant.chat_widget_enabled : undefined;
  const appTenantChatWidgetNorm = String(appTenantChatWidgetRaw == null ? '' : appTenantChatWidgetRaw).trim().toLowerCase();
  const isAppChatNavEnabled = !(
    appTenantChatWidgetRaw === 0
    || appTenantChatWidgetRaw === false
    || appTenantChatWidgetNorm === '0'
    || appTenantChatWidgetNorm === 'false'
  );
  const adminNavItems = [
    { key: 'cash', href: '/dashboard/cash', icon: 'fa-cash-register', label: 'Касса', ariaLabel: 'Касса' },
    { key: 'products', href: '/dashboard/products', icon: 'fa-box', label: 'Товары', ariaLabel: 'Товары' },
    {
      key: 'orders',
      href: '/dashboard/orders',
      icon: 'fa-shopping-cart',
      label: 'Заказы',
      ariaLabel: 'Заказы',
      desktopId: 'sidebarOrdersNavLink',
      desktopLinkClasses: 'nav-item--chat nav-item--orders',
      desktopBadgeId: 'sidebarOrdersUnreadBadge'
    },
    { key: 'courier-screen', href: '/dashboard/courier-screen', icon: 'fa-truck', label: 'Экран курьера', ariaLabel: 'Экран курьера' },
    { key: 'new-order', href: '/dashboard/new-order', icon: 'fa-plus-circle', label: 'Новый заказ', ariaLabel: 'Новый заказ' },
    { key: 'clients', href: '/dashboard/clients', icon: 'fa-bullhorn', label: 'Маркетинг', ariaLabel: 'Маркетинг' },
    { key: 'team', href: '/dashboard/team', icon: 'fa-user-tie', label: 'Команда', ariaLabel: 'Команда' },
    {
      key: 'chat',
      href: '/dashboard/chat',
      icon: 'fa-comments',
      label: 'Чаты',
      ariaLabel: 'Чаты',
      hidden: !isAppChatNavEnabled,
      desktopId: 'sidebarChatNavLink',
      desktopLinkClasses: 'nav-item--chat',
      desktopBadgeId: 'sidebarChatUnreadBadge',
      mobileId: 'mobileChatNavLink',
      mobileBadgeId: 'mobileChatUnreadBadge'
    },
    { key: 'settings', href: '/dashboard/settings', icon: 'fa-cog', label: 'Настройки', ariaLabel: 'Настройки' }
  ];
%>

<body
  class="<%= pageClass || '' %>"
  data-admin-active-page="<%= appActivePage %>"
  data-admin-chat-enabled="<%= isAppChatNavEnabled ? '1' : '0' %>"
  data-app-version="<%= appVersion || '' %>"
>
  <%- include('../partials/header') %>

  <% if (appActivePage === 'courier-screen') { %>
    <div id="courierConnectionBanner" class="courier-connection-banner hidden" aria-live="polite" role="status">
      <span class="courier-connection-banner__text"></span>
      <button
        type="button"
        class="courier-connection-banner__retry hidden"
        data-action="courier-connection-retry"
      >
        Повторить
      </button>
    </div>
  <% } %>

  <div class="main-container app-grid">
    <%- include('../partials/sidebar', { activePage: appActivePage, adminNavItems: adminNavItems }) %>

    <section class="page-col page-col-left">
      <%- include(leftPartial) %>
    </section>

    <section class="page-col page-col-center">
      <%- include(centerPartial) %>
    </section>

    <section class="page-col page-col-right">
      <%- include(rightPartial) %>
    </section>
  </div>

  <%- include('../partials/mobile-admin-nav') %>

  <div id="sidebarOverlay" class="sidebar-overlay"></div>

  <!-- ✅ Универсальная модалка -->
  <%- include('../partials/modal') %>

  <% if (typeof extraPartial !== 'undefined' && extraPartial) { %>
    <%- include(extraPartial) %>
  <% } %>

  <!-- Скрипты -->
  <script src="<%= assetUrl('/static/js/auth.js') %>"></script>
  <script src="<%= assetUrl('/static/js/current-time.js') %>"></script>
  <script src="<%= assetUrl('/static/js/theme.js') %>"></script>
  <script src="<%= assetUrl('/static/js/sidebar.js') %>"></script>
  <script src="<%= assetUrl('/static/js/admin-mobile-nav.js') %>"></script>
  <% if (appActivePage !== 'chat' && appActivePage !== 'settings') { %>
    <script src="<%= assetUrl('/static/js/chat-sidebar-badge.js') %>"></script>
  <% } else if (appActivePage === 'settings') { %>
    <script>
      window.__chatSidebarBadgeUrl = "<%= assetUrl('/static/js/chat-sidebar-badge.js') %>";
    </script>
  <% } %>

  <!-- ✅ Модалка -->
  <script src="<%= assetUrl('/static/js/appModal.js') %>"></script>
  <script>
    (function () {
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js?v=<%= encodeURIComponent(serviceWorkerVersion || appVersion || "") %>', { scope: '/' }).catch(function () {});
        });
      }
    })();
  </script>

  <!-- Кнопка профиля / выхода -->
  <script>
    (function () {
      try {
        var btn = document.getElementById('shopProfileBtn');
        var menuWrapper = btn ? btn.closest('.user-menu-wrapper') : null;
        var dropdown = document.getElementById('userMenuDropdown');
        var logoutBtn = document.getElementById('userMenuLogout');
        
        if (!btn || !menuWrapper || !dropdown) return;

        // Функция для обновления информации о пользователе
        function updateUserInfo() {
          try {
            var userStr = localStorage.getItem('user');
            var tenantStr = localStorage.getItem('tenant');
            
            var nameEl = document.getElementById('userMenuName');
            var emailEl = document.getElementById('userMenuEmail');
            var tenantEl = document.getElementById('userMenuTenant');
            
            if (userStr && tenantStr) {
              var user = JSON.parse(userStr);
              var tenant = JSON.parse(tenantStr);
              
              if (nameEl) nameEl.textContent = user.name || 'Пользователь';
              if (emailEl) emailEl.textContent = user.email || '';
              if (tenantEl) tenantEl.textContent = tenant.name || 'Магазин';
            } else {
              if (nameEl) nameEl.textContent = 'Не авторизован';
              if (emailEl) emailEl.textContent = '';
              if (tenantEl) tenantEl.textContent = '';
            }
          } catch (e) {
            console.error('Error updating user info:', e);
          }
        }

        // Открытие/закрытие меню
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          
          // Если не авторизован — идём на логин
          if (typeof isAuthenticated === 'function' && !isAuthenticated()) {
            window.location.href = '/login';
            return;
          }
          
          // Переключаем меню
          menuWrapper.classList.toggle('active');
          updateUserInfo();
        });

        // Кнопка выхода
        if (logoutBtn) {
          logoutBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (typeof logout === 'function') {
              logout();
            } else {
              localStorage.removeItem('authToken');
              localStorage.removeItem('user');
              localStorage.removeItem('tenant');
              window.location.href = '/login';
            }
          });
        }

        // Закрытие меню при клике вне его
        document.addEventListener('click', function (e) {
          if (menuWrapper && !menuWrapper.contains(e.target)) {
            menuWrapper.classList.remove('active');
          }
        });

        // Обновляем информацию при загрузке
        updateUserInfo();

        // ===== Часы текущего времени филиала =====
        var timeEl = document.getElementById('userMenuTime');
        var clockStop = null;

        if (timeEl && typeof CurrentTime !== 'undefined') {
          clockStop = CurrentTime.startClock(timeEl);
        }

        // ===== Селектор точек продаж =====
        var storeButton = document.getElementById('userMenuStoreButton');
        var storeDropdown = document.getElementById('userMenuStoreDropdown');
        var storeName = document.getElementById('userMenuStoreName');
        var storeSection = document.getElementById('userMenuStoreSection');

        var stores = [];
        var currentStoreId = localStorage.getItem('activeStoreId') || '1';

        // Загрузить список точек продаж
        async function loadStores() {
          try {
            var tenantStr = localStorage.getItem('tenant');
            if (!tenantStr) return;

            var tenant = JSON.parse(tenantStr);
            var tenantId = tenant.id;

            var response = await fetch('/api/public/tenant/stores?tenant_id=' + tenantId);
            var data = await response.json();

            if (!data || !data.ok || !Array.isArray(data.stores)) {
              console.error('Failed to load stores');
              return;
            }

            stores = data.stores;

            // Если точек нет, скрыть секцию
            if (stores.length === 0) {
              if (storeSection) storeSection.style.display = 'none';
              return;
            }

            // Если только одна точка, тоже скрыть
            if (stores.length === 1) {
              currentStoreId = String(stores[0].id);
              localStorage.setItem('activeStoreId', currentStoreId);
              if (storeSection) storeSection.style.display = 'none';
              return;
            }

            // Найти текущую точку
            var currentStore = stores.find(function(s) { return String(s.id) === currentStoreId; });
            if (!currentStore) {
              currentStore = stores[0];
              currentStoreId = String(currentStore.id);
              localStorage.setItem('activeStoreId', currentStoreId);
            }

            updateStoreName(currentStore);
            renderStoreOptions();
          } catch (err) {
            console.error('Error loading stores:', err);
          }
        }

        function updateStoreName(store) {
          if (storeName && store) {
            storeName.textContent = store.name || store.city || 'Филиал #' + store.id;
          }
        }

        function renderStoreOptions() {
          if (!storeDropdown) return;

          storeDropdown.innerHTML = '';

          stores.forEach(function(store) {
            var option = document.createElement('button');
            option.type = 'button';
            option.className = 'user-menu-store-option';
            option.textContent = store.name || store.city || 'Точка #' + store.id;

            if (String(store.id) === currentStoreId) {
              option.classList.add('is-active');
            }

            option.addEventListener('click', function(e) {
              e.stopPropagation();

              if (String(store.id) === currentStoreId) {
                storeDropdown.classList.add('hidden');
                return;
              }

              // Stop clock before reload
              if (clockStop) clockStop();

              // Save new store ID
              localStorage.setItem('activeStoreId', String(store.id));

              // Reload page to update all data with new timezone
              window.location.reload();

              storeDropdown.classList.add('hidden');
            });

            storeDropdown.appendChild(option);
          });
        }

        // Открытие/закрытие dropdown точек
        if (storeButton) {
          storeButton.addEventListener('click', function(e) {
            e.stopPropagation();
            storeDropdown.classList.toggle('hidden');
          });
        }

        // Закрытие dropdown при клике вне
        document.addEventListener('click', function(e) {
          if (storeDropdown && !storeDropdown.contains(e.target) && e.target !== storeButton) {
            storeDropdown.classList.add('hidden');
          }
        });

        // Загрузить точки при открытии страницы
        loadStores();

        // Проверка авторизации для страниц dashboard
        if (window.location.pathname.startsWith('/dashboard/')) {
          var token = localStorage.getItem('authToken');
          if (!token) {
            window.location.href = '/login';
          }
        }
      } catch (e) {
        console.error('Header user menu init error:', e);
      }
    })();
  </script>

  <% if (Array.isArray(pageScripts)) { %>
    <% pageScripts.forEach(function (src) { %>
      <script src="<%= assetUrl(src) %>"></script>
    <% }) %>
  <% } %>
</body>
</html>
