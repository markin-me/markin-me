  <script>
    (function () {
      if ('serviceWorker' in navigator) {
        var serviceWorkerUrl = window.__APP_SERVICE_WORKER_URL__ || '/sw.js';
        navigator.serviceWorker
          .register(serviceWorkerUrl, { scope: '/' })
          .then(function (registration) {
            if (registration && typeof registration.update === 'function') {
              registration.update().catch(function () {});
            }
          })
          .catch(function () {});
      }
    })();
  </script>
  <script>
    (function () {
      window.__BOT_NOTIFICATIONS_ONLY__ = true;
      if (!('serviceWorker' in navigator)) return;

      function safePromise(value) {
        if (!value || typeof value.then !== 'function') return Promise.resolve(null);
        return value.catch(function () { return null; });
      }

      function resolveRegistration() {
        return safePromise(navigator.serviceWorker.getRegistration('/'))
          .then(function (registration) {
            if (registration) return registration;
            return safePromise(navigator.serviceWorker.getRegistration());
          });
      }

      function unsubscribePush(registration) {
        if (!registration || !registration.pushManager || typeof registration.pushManager.getSubscription !== 'function') {
          return Promise.resolve();
        }
        return safePromise(registration.pushManager.getSubscription())
          .then(function (subscription) {
            if (!subscription || typeof subscription.unsubscribe !== 'function') return;
            return safePromise(subscription.unsubscribe());
          });
      }

      resolveRegistration()
        .then(unsubscribePush)
        .catch(function () {});
    })();
  </script>

  <!-- Кнопка профиля / выхода -->
  <script>
    (function () {
      try {
        var btn = document.getElementById('shopProfileBtn');
        var menuWrapper = btn ? btn.closest('.user-menu-wrapper') : null;
        var dropdown = document.getElementById('userMenuDropdown');
        var logoutBtn = document.getElementById('userMenuLogout');
        
        if (!btn || !menuWrapper || !dropdown) return;

        var profilePhotoState = null;
        var profilePhotoImages = [document.getElementById('shopHeaderProfileImg'), document.getElementById('adminUserMenuPhoto')].filter(Boolean);
        var profilePhotoIcons = [btn.querySelector('.shop-header-profile-fallback'), dropdown.querySelector('.user-menu-avatar i')].filter(Boolean);

        function showProfilePhoto(url) {
          profilePhotoImages.forEach(function (image) {
            if (url) image.src = url;
            else image.removeAttribute('src');
            image.classList.toggle('hidden', !url);
          });
          profilePhotoIcons.forEach(function (icon) { icon.classList.toggle('hidden', Boolean(url)); });
        }

        async function renderProfilePhoto(user) {
          var revision = user && user.photo_revision;
          var key = JSON.stringify([user && user.tenant_id, user && user.id, user && user.email, revision]);
          if (profilePhotoState && profilePhotoState.key === key && !profilePhotoState.error) return;
          if (profilePhotoState && profilePhotoState.url) URL.revokeObjectURL(profilePhotoState.url);
          var photo = { key: key, url: '', error: false };
          profilePhotoState = photo;
          showProfilePhoto('');
          btn.removeAttribute('title');
          if (!revision) return;
          try {
            var response = await authFetch('/api/auth/me/photo');
            if (!response.ok) throw new Error('PROFILE_PHOTO_LOAD_FAILED');
            var blob = await response.blob();
            if (profilePhotoState !== photo) return;
            photo.url = URL.createObjectURL(blob);
            showProfilePhoto(photo.url);
          } catch (error) {
            if (profilePhotoState !== photo) return;
            photo.error = true;
            btn.title = 'Не удалось загрузить фото сотрудника';
            console.warn('Не удалось загрузить фото профиля:', error.message);
          }
        }

        window.updateAdminProfilePhoto = function (revision, profile) {
          return Promise.resolve(window.AdminAccessContext || window.AdminAccessContextPromise).then(function (context) {
            if (!context || !context.user) throw new Error('AUTH_CONTEXT_UNAVAILABLE');
            context.user.photo_revision = revision || null;
            if (profile) {
              ['name', 'last_name', 'first_name', 'patronymic'].forEach(function (field) { context.user[field] = profile[field]; });
              if (context.user.profile_name) context.user.profile_name = profile.name;
            }
            localStorage.setItem('user', JSON.stringify(context.user));
            updateUserInfo();
            return renderProfilePhoto(context.user);
          }).catch(function (error) { console.warn('Не удалось обновить фото профиля:', error.message); });
        };

        // Функция для обновления информации о пользователе
        function updateUserInfo() {
          try {
            var userStr = localStorage.getItem('user');
            var tenantStr = localStorage.getItem('tenant');
            
            var nameEl = document.getElementById('userMenuName');
            var emailEl = document.getElementById('userMenuEmail');
            var tenantEl = document.getElementById('userMenuTenant');
            var passwordLink = document.getElementById('userMenuChangePassword');
            if (passwordLink) passwordLink.classList.add('hidden');
            
            if (userStr && tenantStr) {
              var user = JSON.parse(userStr);
              var tenant = JSON.parse(tenantStr);
              if (passwordLink) passwordLink.classList.toggle('hidden', !(Number(user.id) > 0));
              
              var fullName = String(user.profile_name || user.name || '').trim();
              var nameParts = fullName.split(/\s+/);
              var surname = user.last_name || nameParts[0] || '';
              var firstName = user.first_name || nameParts[1] || '';
              var patronymic = user.patronymic || nameParts[2] || '';
              var shortName = (Number(user.id) > 0 || user.profile_name || user.last_name)
                ? [surname, (firstName ? Array.from(firstName)[0] + '.' : '') + (patronymic ? Array.from(patronymic)[0] + '.' : '')].filter(Boolean).join(' ')
                : fullName;
              var profileName = document.getElementById('adminProfileName');
              if (profileName) profileName.textContent = shortName || 'Профиль';
              btn.setAttribute('aria-label', fullName ? 'Профиль: ' + fullName : 'Профиль');
              btn.setAttribute('data-sidebar-tooltip', fullName || 'Профиль');
              if (nameEl) nameEl.textContent = fullName || 'Пользователь';
              if (emailEl) emailEl.textContent = user.email || '';
              if (tenantEl) tenantEl.textContent = tenant.name || 'Магазин';
            } else {
              if (nameEl) nameEl.textContent = 'Не авторизован';
              if (emailEl) emailEl.textContent = '';
              if (tenantEl) tenantEl.textContent = '';
            }
          } catch (e) {
            console.error('Error updating user info:', e);
          }
        }

        // Открытие/закрытие меню
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          
          // Если не авторизован — идём на логин
          if (typeof isAuthenticated === 'function' && !isAuthenticated()) {
            window.location.href = '/login';
            return;
          }
          
          // Переключаем меню
          menuWrapper.classList.toggle('active');
          updateUserInfo();
        });

        // Кнопка выхода
        if (logoutBtn) {
          logoutBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (typeof logout === 'function') {
              logout();
            } else {
              if (window.AdminLocalRepository) window.AdminLocalRepository.reset({ forget: true });
              if (window.AdminReferenceCache && typeof window.AdminReferenceCache.resetRuntime === 'function') {
                window.AdminReferenceCache.resetRuntime();
              }
              if (window.AdminPersistentCache && typeof window.AdminPersistentCache.resetRuntimeScope === 'function') {
                window.AdminPersistentCache.resetRuntimeScope();
              }
              localStorage.removeItem('authToken');
              localStorage.removeItem('user');
              localStorage.removeItem('tenant');
              window.location.href = '/login';
            }
          });
        }

        // Закрытие меню при клике вне его
        document.addEventListener('click', function (e) {
          if (menuWrapper && !menuWrapper.contains(e.target)) {
            menuWrapper.classList.remove('active');
          }
        });

        // Обновляем информацию при загрузке
        updateUserInfo();

        // ===== Часы текущего времени филиала =====
        var timeEl = document.getElementById('userMenuTime');
        var clockStop = null;

        if (timeEl && typeof CurrentTime !== 'undefined') {
          clockStop = CurrentTime.startClock(timeEl);
        }

        // ===== Селектор точек продаж =====
        var storeButton = document.getElementById('userMenuStoreButton');
        var storeDropdown = document.getElementById('userMenuStoreDropdown');
        var storeName = document.getElementById('userMenuStoreName');
        var storeSection = document.getElementById('userMenuStoreSection');
        var roleSection = document.getElementById('userMenuRoleSection');
        var roleDivider = document.getElementById('userMenuRoleDivider');
        var roleButton = document.getElementById('userMenuRoleButton');
        var roleName = document.getElementById('userMenuRoleName');
        var roleDropdown = document.getElementById('userMenuRoleDropdown');
        var isChatPage = !!(document.body && document.body.classList.contains('page-chat'));

        var stores = [];
        var allowedStoreIds = null;
        var currentStoreId = localStorage.getItem('activeStoreId') || '1';

        function applyNavigationPermissions(permissions, options) {
          var list = Array.isArray(permissions) ? permissions : [];
          var fullAccess = list.indexOf('*') !== -1;
          var keys = new Set(list.map(function (item) { return typeof item === 'string' ? item : item.key; }));
          var firstAllowedLink = null;
          var activeAllowed = false;
          document.querySelectorAll('[data-nav-key]').forEach(function (link) {
            var required = String(link.getAttribute('data-permission-keys') || '').split(',').filter(Boolean);
            var visible = fullAccess || required.length === 0 || required.some(function (key) { return keys.has(key); });
            if (link.getAttribute('data-nav-key') === 'chat' && document.body.dataset.adminChatEnabled !== '1') visible = false;
            var item = link.closest('li');
            if (document.body.classList.contains('team-rbac-permission-mode')) {
              if (item && (link.getAttribute('data-nav-key') !== 'chat' || document.body.dataset.adminChatEnabled === '1')) item.classList.remove('hidden');
              return;
            }
            if (item) item.classList.toggle('hidden', !visible);
            else link.classList.toggle('hidden', !visible);
            if (visible && !firstAllowedLink) firstAllowedLink = link;
            if (visible && link.getAttribute('data-nav-key') === document.body.dataset.adminActivePage) activeAllowed = true;
          });
          var registryNodes = Array.isArray(window.__NAVIGATION_RBAC__ && window.__NAVIGATION_RBAC__.nodes)
            ? window.__NAVIGATION_RBAC__.nodes : [];
          var nodeMap = new Map(registryNodes.map(function (node) { return [node.id, node]; }));
          var hasNodeAccess = function hasNodeAccess(node) {
            if (!node) return false;
            if (fullAccess || (node.accessKey && keys.has(node.accessKey))) return true;
            return registryNodes.some(function (child) {
              return child.parentId === node.id && hasNodeAccess(child);
            });
          };
          document.querySelectorAll('.page-col-left [data-rbac-node]').forEach(function (element) {
            var node = nodeMap.get(element.getAttribute('data-rbac-node'));
            if (!node) return;
            var visible = document.body.classList.contains('team-rbac-permission-mode') || hasNodeAccess(node);
            var hasChildren = registryNodes.some(function (child) { return child.parentId === node.id; });
            var target = hasChildren ? (element.closest('.acc-item') || element) : element;
            target.classList.toggle('hidden', !visible);
          });
          if ((!options || options.redirect !== false) && !document.body.classList.contains('team-rbac-permission-mode') && !activeAllowed && firstAllowedLink && document.body.dataset.adminActivePage) {
            window.location.replace(firstAllowedLink.href);
          }
        }

        function renderRoleOptions(context) {
          var roles = Array.isArray(context && context.roles) ? context.roles : [];
          var activeRole = context && context.active_role;
          var sidebarRole = document.getElementById('adminProfileRole');
          if (sidebarRole) {
            var isLegacyOwner = !Number(context && context.user && context.user.id)
              && Array.isArray(context && context.permissions) && context.permissions.includes('*');
            var sidebarRoleName = activeRole ? activeRole.name : isLegacyOwner ? 'Владелец' : 'Роль не выбрана';
            sidebarRole.textContent = sidebarRoleName;
            sidebarRole.title = sidebarRoleName;
            sidebarRole.classList.remove('hidden');
          }
          if (!roleSection || !roleDropdown || roles.length < 2) {
            if (roleSection) roleSection.classList.add('hidden');
            if (roleDivider) roleDivider.classList.add('hidden');
            return;
          }
          roleSection.classList.remove('hidden');
          if (roleDivider) roleDivider.classList.remove('hidden');
          if (roleName) roleName.textContent = activeRole ? activeRole.name : 'Выберите роль';
          roleDropdown.innerHTML = '';
          roles.forEach(function (role) {
            var option = document.createElement('button');
            option.type = 'button';
            option.className = 'user-menu-store-option';
            option.textContent = role.name;
            if (activeRole && Number(activeRole.id) === Number(role.id)) option.classList.add('is-active');
            option.addEventListener('click', async function (event) {
              event.stopPropagation();
              if (activeRole && Number(activeRole.id) === Number(role.id)) {
                roleDropdown.classList.add('hidden');
                return;
              }
              try {
                var roleRequestAccess = captureAuthState();
                var response = await authFetch('/api/auth/active-role', { method: 'POST', body: JSON.stringify({ role_id: Number(role.id) }) });
                var result = await response.json();
                if (!roleRequestAccess.isCurrent()) return;
                if (!response.ok || result.ok !== true) throw new Error(result.error || 'ROLE_SWITCH_FAILED');
                if (window.AdminLocalRepository) window.AdminLocalRepository.reset({ forget: true });
                localStorage.setItem('authToken', result.token);
                localStorage.setItem('user', JSON.stringify(result.user));
                localStorage.setItem('tenant', JSON.stringify(result.tenant));
                updateUserInfo();
                renderProfilePhoto(result.user);
                renderRoleOptions(result);
                roleDropdown.classList.add('hidden');
                window.location.href = result.redirect || '/dashboard/products';
              } catch (error) {
                console.error('Role switch failed:', error);
              }
            });
            roleDropdown.appendChild(option);
          });
        }

        var accessContextLoad = null;
        function applyAllowedStoreContext(context) {
          if (!Array.isArray(context.stores)) return;
          allowedStoreIds = new Set(context.stores.map(function (store) { return String(store.id); }));
          if (context.stores.length && !allowedStoreIds.has(String(localStorage.getItem('activeStoreId')))) {
            currentStoreId = String(context.stores[0].id);
            localStorage.setItem('activeStoreId', currentStoreId);
          }
          if (stores.length) applyStores();
        }
        function applyAccessContext(context) {
          window.AdminAccessContext = context;
          applyAllowedStoreContext(context);
          updateUserInfo();
          renderProfilePhoto(context.user);
          applyNavigationPermissions(context.permissions || []);
          renderRoleOptions(context);
          window.dispatchEvent(new CustomEvent('admin:access-context', { detail: context }));
          window.showConfirmedAdminInterface();
          return context;
        }
        async function restoreAccessContext(requestToken, ticket) {
          var repository = window.AdminLocalRepository;
          var confirmation = await repository.restore(requestToken, ticket);
          if (!confirmation || !repository.isActive()) return null;
          var restored = Object.assign({}, confirmation.metadata, {
            ok: true, local_context: confirmation.local_context, offline: true
          });
          applyAllowedStoreContext(restored);
          if (window.__ADMIN_DASHBOARD_SHELL__) {
            var keys = (restored.permissions || []).map(function (grant) { return typeof grant === 'string' ? grant : grant.key; });
            var page = (window.__NAVIGATION_RBAC__.nodes || []).find(function (node) {
              return node.parentId === null && node.navKey === document.body.dataset.adminActivePage;
            });
            if (!page || (!keys.includes('*') && !keys.includes(page.accessKey))) {
              document.documentElement.setAttribute('data-local-access', 'denied');
              document.getElementById('adminLocalAccessMessage').textContent = 'Нет подтверждённого доступа к этому разделу.';
              return null;
            }
          }
          if (window.__ADMIN_PRODUCTS_SHELL__) {
            var grants = Array.isArray(restored.permissions) ? restored.permissions : [];
            var fullAccess = grants.includes('*');
            var pageAccess = fullAccess || grants.some(function (grant) { return grant.key === 'products.access'; });
            var read = grants.find(function (grant) { return grant.key === 'products.catalog.read'; });
            var storeId = Number(localStorage.getItem('activeStoreId') || 0);
            var readable = fullAccess || read && (read.access_rule === 'all' || read.access_rule === 'stores'
              && (restored.stores || []).some(function (store) { return Number(store.id) === storeId; }));
            if (!pageAccess || !readable || !(storeId > 0)) {
              document.documentElement.setAttribute('data-local-access', 'denied');
              document.getElementById('adminLocalAccessMessage').textContent = 'Нет подтверждённого доступа к сохранённым товарам выбранного филиала.';
              return null;
            }
          }
          window.AdminAccessContext = restored;
          applyNavigationPermissions(restored.permissions || []);
          renderRoleOptions(restored);
          window.dispatchEvent(new CustomEvent('admin:access-context', { detail: restored }));
          window.showConfirmedAdminInterface();
          return restored;
        }
        function loadAccessContext(useServerBootstrap) {
          if (useServerBootstrap === true && window.AdminServerContextPromise) {
            return window.AdminServerContextPromise.then(function (context) {
              if (!context || !window.AdminLocalRepository.isActive()) return null;
              return applyAccessContext(context);
            });
          }
          var requestToken = localStorage.getItem('authToken');
          if (accessContextLoad && accessContextLoad.token === requestToken) return accessContextLoad.promise;
          var repository = window.AdminLocalRepository;
          var ticket = repository ? repository.beginConfirmation() : null;
          var requestAccess = repository ? repository.capture({ requireActive: false }) : null;
          var responseReceived = false;
          var responseStatus = null;
          var promise = (async function () {
          try {
            // Only SW's failed dashboard navigation uses this public document at the
            // dashboard URL. Restore the existing tab proof, never infer access from HTML.
            if (useServerBootstrap === true && (window.__ADMIN_DASHBOARD_SHELL__
                && window.location.pathname.replace(/\/$/, '') === '/dashboard/' + document.body.dataset.adminActivePage
                || window.__ADMIN_PRODUCTS_SHELL__ && window.location.pathname.replace(/\/$/, '') === '/dashboard/products')) {
              var local = await restoreAccessContext(requestToken, ticket);
              if (!local && !repository.isActive()) repository.reset({ forget: true, broadcast: false, reason: 'offline-unavailable' });
              return local;
            }
            var response = await authFetch('/api/auth/me', { cache: 'no-store' });
            responseReceived = true;
            responseStatus = response.status;
            var context = await response.json();
            if (localStorage.getItem('authToken') !== requestToken || (requestAccess && !requestAccess.isCurrent())) return null;
            if (!response.ok || context.ok !== true) throw new Error(context.error || 'AUTH_CONTEXT_FAILED');
            if (context.user) localStorage.setItem('user', JSON.stringify(context.user));
            if (context.tenant) localStorage.setItem('tenant', JSON.stringify(context.tenant));
            applyAllowedStoreContext(context);
            if (repository) {
              try {
                var confirmed = await repository.confirm({ ok: context.ok, local_context: context.local_context,
                  metadata: { roles: context.roles, active_role: context.active_role, permissions: context.permissions, stores: context.stores }
                }, requestToken, ticket);
                if (!confirmed) return null;
              }
              catch (storageError) {
                console.error('Local context confirmation failed:', storageError);
                if (storageError.message !== 'LOCAL_SCOPE_CHANGED' && localStorage.getItem('authToken') === requestToken) repository.reset({ forget: true, reason: 'local-context-error' });
                return null;
              }
            }
            if (localStorage.getItem('authToken') !== requestToken || (repository && !repository.isActive())) return null;
            return applyAccessContext(context);
          } catch (error) {
            if (requestAccess && !requestAccess.isCurrent()) return null;
            if (repository && !responseReceived && error instanceof TypeError && localStorage.getItem('authToken') === requestToken) {
              try {
                var restored = await restoreAccessContext(requestToken, ticket);
                if (restored) return restored;
              } catch (restoreError) { console.error('Local context restore failed:', restoreError); }
            }
            if (repository && localStorage.getItem('authToken') === requestToken && error.message !== 'LOCAL_SCOPE_CHANGED') {
              repository.reset({ forget: true, broadcast: responseReceived, reason: !responseReceived ? 'offline-unavailable'
                : responseStatus >= 400 && responseStatus < 500 && responseStatus !== 429 ? 'server-refusal' : 'server-unavailable' });
            }
            console.error('Access context load failed:', error);
            return null;
          }
          })();
          accessContextLoad = { token: requestToken, promise: promise };
          promise.finally(function () {
            if (accessContextLoad && accessContextLoad.promise === promise) accessContextLoad = null;
          });
          return promise;
        }

        // Загрузить список точек продаж
        window.reloadAdminAccessContext = loadAccessContext;

        async function loadStores() {
          if (isChatPage) {
            if (storeSection) storeSection.style.display = 'none';
            return;
          }
          try {
            var access = await window.AdminAccessContextPromise;
            if (!access || access.ok !== true) return;
            var tenantId = access.local_context ? access.local_context.tenantId : access.tenant && access.tenant.id;
            if (!tenantId) return;
            var authorizedStoreIds = new Set((access.stores || []).map(function (store) { return String(store.id); }));

            var loadStoresFromNetwork = async function () {
              var response = await fetch('/api/public/tenant/stores?tenant_id=' + tenantId);
              if (!response.ok) throw new Error('STORE_FETCH_FAILED');
              return response.json();
            };
            var normalizeStores = function (data) {
              if (!data || data.ok !== true || !Array.isArray(data.stores)) throw new Error('INVALID_STORES_RESPONSE');
              return data.stores.filter(function (store) { return authorizedStoreIds.has(String(store.id)); }).map(function (store) {
                return {
                  tenant_id: store.tenant_id,
                  id: store.id,
                  code: store.code,
                  name: store.name,
                  city: store.city,
                  address: store.address,
                  phone: store.phone,
                  timezone: store.timezone,
                  is_active: store.is_active
                };
              });
            };
            var data = window.AdminReferenceCache
              ? await window.AdminReferenceCache.getOrLoadReference('stores', {
                  load: loadStoresFromNetwork,
                  normalize: normalizeStores,
                  validate: function (value) { return Array.isArray(value); },
                  onUpdate: function (value) {
                    stores = value;
                    applyStores();
                  }
                })
              : normalizeStores(await loadStoresFromNetwork());

            stores = data;
            applyStores();
          } catch (err) {
            console.error('Error loading stores:', err);
          }
        }

        function applyStores() {
            if (allowedStoreIds instanceof Set) {
              stores = stores.filter(function (store) { return allowedStoreIds.has(String(store.id)); });
            }
            if (storeSection) storeSection.style.display = '';

            // Если точек нет, скрыть секцию
            if (stores.length === 0) {
              if (storeSection) storeSection.style.display = 'none';
              return;
            }

            // Если только одна точка, тоже скрыть
            if (stores.length === 1) {
              currentStoreId = String(stores[0].id);
              localStorage.setItem('activeStoreId', currentStoreId);
              if (storeSection) storeSection.style.display = 'none';
              return;
            }

            // Найти текущую точку
            var currentStore = stores.find(function(s) { return String(s.id) === currentStoreId; });
            if (!currentStore) {
              currentStore = stores[0];
              currentStoreId = String(currentStore.id);
              localStorage.setItem('activeStoreId', currentStoreId);
            }

            updateStoreName(currentStore);
            renderStoreOptions();
        }

        function updateStoreName(store) {
          if (storeName && store) {
            storeName.textContent = store.name || store.city || 'Филиал #' + store.id;
          }
        }

        function renderStoreOptions() {
          if (!storeDropdown) return;

          storeDropdown.innerHTML = '';

          stores.forEach(function(store) {
            var option = document.createElement('button');
            option.type = 'button';
            option.className = 'user-menu-store-option';
            option.textContent = store.name || store.city || 'Точка #' + store.id;

            if (String(store.id) === currentStoreId) {
              option.classList.add('is-active');
            }

            option.addEventListener('click', function(e) {
              e.stopPropagation();

              if (String(store.id) === currentStoreId) {
                storeDropdown.classList.add('hidden');
                return;
              }

              // Stop clock before reload
              if (clockStop) clockStop();

              // Save new store ID
              localStorage.setItem('activeStoreId', String(store.id));

              // Reload page to update all data with new timezone
              window.location.reload();

              storeDropdown.classList.add('hidden');
            });

            storeDropdown.appendChild(option);
          });
        }

        // Открытие/закрытие dropdown точек
        if (storeButton) {
          storeButton.addEventListener('click', function(e) {
            e.stopPropagation();
            storeDropdown.classList.toggle('hidden');
          });
        }
        if (roleButton && roleDropdown) {
          roleButton.addEventListener('click', function (event) {
            event.stopPropagation();
            roleDropdown.classList.toggle('hidden');
          });
        }

        // Закрытие dropdown при клике вне
        document.addEventListener('click', function(e) {
          if (storeDropdown && !storeDropdown.contains(e.target) && e.target !== storeButton) {
            storeDropdown.classList.add('hidden');
          }
          if (roleDropdown && !roleDropdown.contains(e.target) && e.target !== roleButton) {
            roleDropdown.classList.add('hidden');
          }
        });

        // Загрузить точки при открытии страницы
        window.AdminAccessContextPromise = loadAccessContext(true);
        window.addEventListener('online', function () {
          var coldShell = window.__ADMIN_DASHBOARD_SHELL__ && !window.AdminLocalRepository.isActive();
          window.AdminAccessContextPromise = loadAccessContext();
          if (coldShell) window.AdminAccessContextPromise.then(function (context) {
            if (context && window.AdminLocalRepository.isActive()) window.location.reload();
          });
        });
        // A backend can recover without a browser "online" event (e.g. a proxy outage).
        // Revalidate on returning to the application; do not add a polling loop.
        window.addEventListener('focus', function () {
          if (navigator.onLine !== false && window.AdminAccessContext?.offline === true
              && window.AdminLocalRepository.isActive()) {
            window.AdminAccessContextPromise = loadAccessContext();
          }
        });
        loadStores();

        // Проверка авторизации для страниц dashboard
        if (window.location.pathname.startsWith('/dashboard/')) {
          var token = localStorage.getItem('authToken');
          if (!token && !window.__ADMIN_NEUTRAL_SHELL__) {
            window.location.href = '/login';
          }
        }
      } catch (e) {
        console.error('Header user menu init error:', e);
      }
    })();
  </script>

  <% if (appPageScripts.length) { %>
    <% appPageScripts.forEach(function (src) { %>
      <script src="<%= assetUrl(src) %>"></script>
    <% }) %>
  <% } %>
</body>
</html>
