  <script>
    (function () {
      if (!('serviceWorker' in navigator)) return;
      var expectedToken = String(window.__APP_SERVICE_WORKER_VERSION__ || '').trim();
      var expectedUrl = String(window.__APP_SERVICE_WORKER_URL__ || '/sw.js').trim() || '/sw.js';
      var currentUrl;
      try {
        currentUrl = new URL(window.location.href);
      } catch (err) {
        return;
      }

      var isChatPage = currentUrl.pathname === '/dashboard/chat';
      var resetParam = String(currentUrl.searchParams.get('sw_reset') || '').trim();
      var versionParam = String(currentUrl.searchParams.get('v') || '').trim();
      var resetKey = 'admin-sw-reset:' + expectedToken;

      async function clearAdminServiceWorkersAndCaches() {
        try {
          var registrations = await navigator.serviceWorker.getRegistrations();
          await Promise.allSettled((registrations || []).map(function (registration) {
            var worker = registration.active || registration.waiting || registration.installing;
            return worker && new URL(worker.scriptURL).pathname === '/sw.js' ? registration.unregister() : Promise.resolve();
          }));
        } catch (err) {}
        if ('caches' in window) {
          try {
            var cacheKeys = await caches.keys();
            await Promise.allSettled((cacheKeys || []).map(function (key) {
              return /^(admin-pages-|html-courier-screen-)/.test(key) ? caches.delete(key) : Promise.resolve();
            }));
          } catch (err) {}
        }
      }

      async function ensureFreshAdminChatPage() {
        if (!isChatPage || !expectedToken) return;
        if (resetParam === '1') {
          try {
            sessionStorage.setItem(resetKey, '1');
          } catch (err) {}
          await clearAdminServiceWorkersAndCaches();
          currentUrl.searchParams.delete('sw_reset');
          currentUrl.searchParams.set('v', expectedToken);
          window.location.replace(currentUrl.pathname + currentUrl.search + currentUrl.hash);
          return;
        }

        if (versionParam !== expectedToken) {
          currentUrl.searchParams.set('v', expectedToken);
          window.location.replace(currentUrl.pathname + currentUrl.search + currentUrl.hash);
          return;
        }

        try {
          var registration = await navigator.serviceWorker.getRegistration('/');
          var scriptUrl = String(
            (registration && registration.active && registration.active.scriptURL)
            || (registration && registration.waiting && registration.waiting.scriptURL)
            || (registration && registration.installing && registration.installing.scriptURL)
            || ''
          ).trim();
          var resetAlreadyAttempted = false;
          try {
            resetAlreadyAttempted = sessionStorage.getItem(resetKey) === '1';
          } catch (err) {}
          if (scriptUrl && scriptUrl.indexOf(expectedToken) === -1 && !resetAlreadyAttempted) {
            try {
              sessionStorage.setItem(resetKey, '1');
            } catch (err) {}
            await clearAdminServiceWorkersAndCaches();
            window.location.replace(currentUrl.pathname + currentUrl.search + currentUrl.hash);
            return;
          }
          if (scriptUrl && scriptUrl.indexOf(expectedToken) !== -1) {
            try {
              sessionStorage.removeItem(resetKey);
            } catch (err) {}
          }
        } catch (err) {}
      }

      ensureFreshAdminChatPage().catch(function () {});
    })();
  </script>

