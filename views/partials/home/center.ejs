<% if (activePage === "settings") { %>
  <div class="center-stack">
    <div class="panel toolbar-island">
      <div class="toolbar">
        <div class="toolbar-title">
          <i class="fas fa-store"></i>
          <div class="toolbar-title-text">
            <span id="settingsCenterTitle">Компания</span>
            <span class="muted" id="settingsCenterSubtitle"></span>
          </div>
        </div>
        <div class="toolbar-right">
          <label class="switch settings-chat-subheader-switch hidden" id="settingsChatWidgetSwitchWrap" title="Вкл/выкл чата на витрине">
            <input class="switch-input" type="checkbox" id="settingsChatWidgetEnabledSwitch" />
            <span class="switch-ui" aria-hidden="true"></span>
            <span class="switch-text">Вкл/выкл чата</span>
          </label>
          <div class="settings-delivery-map-search-toolbar hidden" id="settingsDeliveryMapSearchToolbar">
            <div class="settings-delivery-map-search-wrap" id="settingsDeliveryMapSearchWrap">
              <div class="settings-delivery-map-search-field">
                <input class="control settings-delivery-map-search-input settings-delivery-map-search-input--toolbar" type="text" id="settingsDeliveryMapSearchInput" placeholder="Введите город или адрес" autocomplete="off" />
                <button class="settings-delivery-map-search-clear" id="settingsDeliveryMapSearchClear" type="button" aria-label="Очистить поиск на карте">
                  <i class="fas fa-times"></i>
                </button>
              </div>
              <div class="settings-delivery-map-search-popover hidden" id="settingsDeliveryMapSearchPopover" role="dialog" aria-label="Результаты поиска на карте">
                <div class="settings-delivery-map-search-status hidden" id="settingsDeliveryMapSearchStatus"></div>
                <div class="settings-delivery-map-results hidden" id="settingsDeliveryMapResults"></div>
              </div>
            </div>
          </div>
          <div class="settings-delivery-map-info-wrap hidden" id="settingsDeliveryMapInfoWrap">
            <button class="icon-btn settings-delivery-map-info-btn" id="settingsDeliveryMapInfoBtn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Информация о карте доставки">
              <i class="fas fa-info"></i>
            </button>
            <div class="settings-delivery-map-info-popover hidden" id="settingsDeliveryMapInfoPopover" role="dialog" aria-label="Информация о карте доставки">
              <div class="settings-delivery-map-info-title">Карта доставки</div>
              <div class="settings-delivery-map-info-text">Подключается из системных настроек и пока используется как подложка для будущих зон.</div>
              <div class="settings-delivery-map-info-note">Параметры провайдера и геокодера настраиваются в разделе «Системные -&gt; Карта».</div>
            </div>
          </div>
          <div class="new-order-right-select-wrap cash-toolbar-filter settings-delivery-city-selector hidden" id="settingsDeliveryCitySelector">
            <button class="new-order-right-select-trigger cash-toolbar-filter-trigger" id="settingsDeliveryCityChip" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Выбрать город на карте доставки">
              <span class="cash-toolbar-filter-main">
                <i class="fas fa-map-marker-alt"></i>
                <span id="settingsDeliveryCityChipText">Город</span>
              </span>
              <i class="fas fa-chevron-down"></i>
            </button>
            <div class="new-order-right-select-menu no-scrollbar" id="settingsDeliveryCityDropdown" role="listbox" aria-label="Город карты доставки"></div>
          </div>
          <button class="btn btn-icon btn-primary" id="settingsAddOrderBtn" type="button" title="Новый филиал" aria-label="Новая точка продаж">
            <i class="fas fa-plus"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="panel orders-center-panel" id="settingsCardsPanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="settingsTenantCards">
          <button class="order-row product-row settings-card" id="settingsLogoCard" type="button">
            <div class="product-avatar"><i class="fas fa-icons"></i></div>
            <div class="order-col">
              <div class="product-title">Логотип и фавикон</div>
              <div class="muted">Светлая и тёмная темы</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsBrandCard" type="button">
            <div class="product-avatar"><i class="fas fa-id-card"></i></div>
            <div class="order-col">
              <div class="product-title">Данные бренда</div>
              <div class="muted">Название, контакты, доступ</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsOrderStatusesCard" type="button">
            <div class="product-avatar"><i class="fas fa-tasks"></i></div>
            <div class="order-col">
              <div class="product-title">Этапы заказов</div>
              <div class="muted">Список статусов заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsOrderPaymentsCard" type="button">
            <div class="product-avatar"><i class="fas fa-credit-card"></i></div>
            <div class="order-col">
              <div class="product-title">Способы оплаты</div>
              <div class="muted">Типы оплаты для заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsOrderDeliveryCard" type="button">
            <div class="product-avatar"><i class="fas fa-truck"></i></div>
            <div class="order-col">
              <div class="product-title">Способы получения</div>
              <div class="muted">Варианты получения заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsOrderTimeOptionsCard" type="button">
            <div class="product-avatar"><i class="fas fa-clock"></i></div>
            <div class="order-col">
              <div class="product-title">Интервалы времени</div>
              <div class="muted">Варианты времени заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsNotificationsCard" type="button">
            <div class="product-avatar"><i class="fab fa-telegram-plane"></i></div>
            <div class="order-col">
              <div class="product-title">Уведомления</div>
              <div class="muted">Подключение и управление Telegram-уведомлениями</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsSoundsCard" type="button" data-settings-chat-card="1">
            <div class="product-avatar"><i class="fas fa-bell"></i></div>
            <div class="order-col">
              <div class="product-title">Звуки уведомлений</div>
              <div class="muted">Звук нового сообщения в чате</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsChatAssistantNameCard" type="button" data-settings-chat-card="1">
            <div class="product-avatar"><i class="fas fa-robot"></i></div>
            <div class="order-col">
              <div class="product-title">Виртуальный помощник</div>
              <div class="muted">Имя, пол, приветствие и сетка горячих вопросов</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsChatOperatorNameCard" type="button" data-settings-chat-card="1">
            <div class="product-avatar"><i class="fas fa-user-tie"></i></div>
            <div class="order-col">
              <div class="product-title">Имя оператора</div>
              <div class="muted">По умолчанию имя компании, можно изменить</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsChatMessageSettingsCard" type="button" data-settings-chat-card="1">
            <div class="product-avatar"><i class="fas fa-clock"></i></div>
            <div class="order-col">
              <div class="product-title">Настройка сообщений</div>
              <div class="muted">Время жизни гостевых чатов</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsImagesCard" type="button">
            <div class="product-avatar"><i class="fas fa-image"></i></div>
            <div class="order-col">
              <div class="product-title">Фото товаров</div>
              <div class="muted">Качество, размер и конвертация</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsPrintApiCard" type="button">
            <div class="product-avatar"><i class="fas fa-plug"></i></div>
            <div class="order-col">
              <div class="product-title">API</div>
              <div class="muted">Печать заказов на удалённом принтере</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>
        </div>

        <div class="empty-state hidden" id="settingsStoresEmpty">
          <div class="empty-icon"><i class="fas fa-store"></i></div>
          <div class="empty-title">Филиалы</div>
          <div class="empty-text">Пока нет данных для этого раздела.</div>
        </div>
      </div>
    </div>

    <div class="panel stores-panel hidden" id="storesPanel">
      <div class="panel-body no-scrollbar">
        <div class="stores-list orders-list settings-cards" id="storesList"></div>
        <div class="empty-state hidden" id="storesEmpty">
          <div class="empty-icon"><i class="fas fa-store"></i></div>
          <div class="empty-title">Нет точек продаж</div>
          <div class="empty-text">Создайте первую точку, чтобы начать работу в новом районе.</div>
        </div>
      </div>
    </div>

    <div class="panel delivery-panel hidden" id="deliveryPanel">
      <div class="panel-body no-scrollbar">
        <div class="settings-delivery-map-card" id="settingsDeliveryMapBlock">
          <div class="settings-delivery-map-empty hidden" id="settingsDeliveryMapEmpty">
            <div class="settings-delivery-map-empty-title">Карта не настроена</div>
            <div class="settings-delivery-map-empty-text">Заполните параметры провайдера в разделе «Системные -> Карта», чтобы показать подложку здесь.</div>
          </div>
          <div class="settings-delivery-map-canvas hidden" id="settingsDeliveryMapCanvas"></div>
        </div>
      </div>
    </div>

    <div class="panel site-panel hidden" id="sitePanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="sitePanelCards">
          <button class="order-row product-row settings-card" id="settingsSiteCard" type="button">
            <div class="product-avatar"><i class="fas fa-globe"></i></div>
            <div class="order-col">
              <div class="product-title">Данные сайта</div>
              <div class="muted">Название, описание, домен</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsDomainCard" type="button">
            <div class="product-avatar"><i class="fas fa-link"></i></div>
            <div class="order-col">
              <div class="product-title">Домен</div>
              <div class="muted">Подключить свой домен</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsTelegramAppCard" type="button">
            <div class="product-avatar product-avatar--image">
              <img class="product-avatar-img" src="/static/uploads/auth/telegram-auth.png" alt="Telegram mini app icon" loading="lazy" />
            </div>
            <div class="order-col">
              <div class="product-title">Мини-приложение Telegram</div>
              <div class="muted">Ссылка для Telegram-бота</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsMaxAppCard" type="button">
            <div class="product-avatar product-avatar--image">
              <img class="product-avatar-img" src="/static/uploads/auth/max-auth.png" alt="MAX mini app icon" loading="lazy" />
            </div>
            <div class="order-col">
              <div class="product-title">Мини-приложение MAX</div>
              <div class="muted">Токен бота для авторизации</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <div class="panel site-panel hidden" id="systemPanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="systemPanelCards">
          <button class="order-row product-row settings-card" id="settingsSystemMapCard" type="button">
            <div class="product-avatar"><i class="fas fa-map-marked-alt"></i></div>
            <div class="order-col">
              <div class="product-title">Карта</div>
              <div class="muted">Провайдер, tile URL, атрибуция и масштаб</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="order-row product-row settings-card" id="settingsSystemTelegramBotCard" type="button">
            <div class="product-avatar"><i class="fab fa-telegram-plane"></i></div>
            <div class="order-col">
              <div class="product-title">Telegram бот</div>
              <div class="muted">Username, token и webhook системного бота</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="center-stack">
    <div class="panel toolbar-island">
      <div class="toolbar">
        <div class="toolbar-title">
          <i class="fas fa-home"></i>
          <span>Меню</span>
        </div>
      </div>
    </div>

    <div class="panel orders-center-panel">
      <div class="panel-body no-scrollbar">
        <p class="muted">Тут будут товары из базы данных...</p>
      </div>
    </div>
  </div>
<% } %>
