<% if (activePage === "settings") { %>
  <div class="center-stack">
      <div class="panel toolbar-island">
        <div class="toolbar">
          <div class="toolbar-title">
            <i class="fas fa-store" id="settingsCenterIcon"></i>
            <div class="toolbar-title-text">
              <span id="settingsCenterTitle">Компания</span>
              <span class="muted" id="settingsCenterSubtitle"></span>
            </div>
          </div>
          <div class="toolbar-right">
            <button class="btn btn-icon btn-primary hidden" id="settingsApiAddBtn" type="button" title="Добавить API" aria-label="Добавить API">
              <i class="fas fa-plus"></i>
            </button>
            <label class="switch settings-chat-subheader-switch hidden" id="settingsChatWidgetSwitchWrap" title="Вкл/выкл чата на витрине">
              <input class="switch-input" type="checkbox" id="settingsChatWidgetEnabledSwitch" />
              <span class="switch-ui" aria-hidden="true"></span>
              <span class="switch-text">Вкл/выкл чата</span>
            </label>
          <div class="settings-delivery-map-search-toolbar hidden" id="settingsDeliveryMapSearchToolbar">
            <div class="settings-delivery-map-search-wrap" id="settingsDeliveryMapSearchWrap">
              <div class="settings-delivery-map-search-field">
                <input class="control settings-delivery-map-search-input settings-delivery-map-search-input--toolbar" type="text" id="settingsDeliveryMapSearchInput" placeholder="Введите город или адрес" autocomplete="off" />
                <button class="settings-delivery-map-search-clear" id="settingsDeliveryMapSearchClear" type="button" aria-label="Очистить поиск на карте">
                  <i class="fas fa-times"></i>
                </button>
              </div>
              <div class="settings-delivery-map-search-popover hidden" id="settingsDeliveryMapSearchPopover" role="dialog" aria-label="Результаты поиска на карте">
                <div class="settings-delivery-map-search-status hidden" id="settingsDeliveryMapSearchStatus"></div>
                <div class="settings-delivery-map-results hidden" id="settingsDeliveryMapResults"></div>
              </div>
            </div>
          </div>
          <div class="new-order-right-select-wrap cash-toolbar-filter settings-delivery-city-selector hidden" id="settingsDeliveryCitySelector">
            <button class="new-order-right-select-trigger cash-toolbar-filter-trigger" id="settingsDeliveryCityChip" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Выбрать город на карте доставки">
              <span class="cash-toolbar-filter-main">
                <i class="fas fa-map-marker-alt"></i>
                <span id="settingsDeliveryCityChipText">Город</span>
              </span>
              <i class="fas fa-chevron-down"></i>
            </button>
            <div class="new-order-right-select-menu no-scrollbar" id="settingsDeliveryCityDropdown" role="listbox" aria-label="Город карты доставки"></div>
          </div>
          <button class="icon-btn hidden" id="settingsDeliveryMapConfigBtn" type="button" title="Настройка карты" aria-label="Настройка карты">
            <i class="fas fa-cog"></i>
          </button>
          <div class="settings-create-menu-wrap" id="settingsCreateMenuWrap">
            <button class="btn btn-icon btn-primary" id="settingsAddOrderBtn" type="button" title="Новый филиал" aria-label="Новая точка продаж">
              <i class="fas fa-plus"></i>
            </button>
            <div class="settings-create-menu hidden" id="settingsDeliveryCreateMenu" role="menu" aria-label="Создание настроек доставки">
              <button class="settings-create-menu-item" id="settingsDeliveryCreateConditionBtn" type="button" role="menuitem">
                <span class="settings-create-menu-item-title">Условия доставки</span>
                <span class="settings-create-menu-item-text">Обычная настройка без зон</span>
              </button>
              <button class="settings-create-menu-item hidden" id="settingsDeliveryCreateZoneBtn" type="button" role="menuitem">
                <span class="settings-create-menu-item-title">Зона доставки</span>
                <span class="settings-create-menu-item-text">Нарисовать полигоны на карте</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel orders-center-panel" id="settingsCardsPanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="settingsTenantCards">
          <button class="settings-home-card settings-card" id="settingsLogoCard" type="button">
            <div class="product-avatar"><i class="fas fa-icons"></i></div>
            <div class="order-col">
              <div class="product-title">Логотип и фавикон</div>
              <div class="muted">Светлая и тёмная темы</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsBrandCard" type="button">
            <div class="product-avatar"><i class="fas fa-id-card"></i></div>
            <div class="order-col">
              <div class="product-title">Данные бренда</div>
              <div class="muted">Название, контакты, доступ</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsOrderStatusesCard" type="button">
            <div class="product-avatar"><i class="fas fa-tasks"></i></div>
            <div class="order-col">
              <div class="product-title">Этапы заказов</div>
              <div class="muted">Список статусов заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsOrderPaymentsCard" type="button">
            <div class="product-avatar"><i class="fas fa-credit-card"></i></div>
            <div class="order-col">
              <div class="product-title">Способы оплаты</div>
              <div class="muted">Типы оплаты для заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsOrderDeliveryCard" type="button">
            <div class="product-avatar"><i class="fas fa-truck"></i></div>
            <div class="order-col">
              <div class="product-title">Способы получения</div>
              <div class="muted">Варианты получения заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsOrderTimeOptionsCard" type="button">
            <div class="product-avatar"><i class="fas fa-clock"></i></div>
            <div class="order-col">
              <div class="product-title">Интервалы времени</div>
              <div class="muted">Варианты времени заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsNotificationsCard" type="button">
            <div class="product-avatar"><i class="fab fa-telegram-plane"></i></div>
            <div class="order-col">
              <div class="product-title">Уведомления</div>
              <div class="muted">Подключение и управление Telegram-уведомлениями</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsSoundsCard" type="button" data-settings-chat-card="1">
            <div class="product-avatar"><i class="fas fa-bell"></i></div>
            <div class="order-col">
              <div class="product-title">Звуки</div>
              <div class="muted">Сигналы и уведомления</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsChatAssistantNameCard" type="button" data-settings-chat-card="1">
            <div class="product-avatar"><i class="fas fa-robot"></i></div>
            <div class="order-col">
              <div class="product-title">Помощник</div>
              <div class="muted">Имя, приветствие и вопросы</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsChatOperatorNameCard" type="button" data-settings-chat-card="1">
            <div class="product-avatar"><i class="fas fa-user-tie"></i></div>
            <div class="order-col">
              <div class="product-title">Оператор</div>
              <div class="muted">Имя в диалогах</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsChatMessageSettingsCard" type="button" data-settings-chat-card="1">
            <div class="product-avatar"><i class="fas fa-clock"></i></div>
            <div class="order-col">
              <div class="product-title">Сообщения</div>
              <div class="muted">Срок жизни чатов</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsImagesCard" type="button">
            <div class="product-avatar"><i class="fas fa-image"></i></div>
            <div class="order-col">
              <div class="product-title">Фото товаров</div>
              <div class="muted">Качество, размер и конвертация</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsSiteMenuItemsCard" type="button">
            <div class="product-avatar"><i class="fas fa-list-ul"></i></div>
            <div class="order-col">
              <div class="product-title">Пункты меню на сайте</div>
              <div class="muted">Настройки пунктов меню витрины</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card hidden" id="settingsPrintApiCardLegacy" type="button" style="display:none" aria-hidden="true" tabindex="-1">
            <div class="product-avatar"><i class="fas fa-plug"></i></div>
            <div class="order-col">
              <div class="product-title">API</div>
              <div class="muted">Печать заказов на удалённом принтере</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>
        </div>

        <div class="empty-state hidden" id="settingsStoresEmpty">
          <div class="empty-icon"><i class="fas fa-store"></i></div>
          <div class="empty-title">Филиалы</div>
          <div class="empty-text">Пока нет данных для этого раздела.</div>
        </div>
      </div>
    </div>

    <div class="panel orders-center-panel hidden" id="apiPanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="apiPanelCards">
          <div class="settings-api-cards-header hidden" id="settingsApiCardsHeader">
            <div class="settings-list-title">API для печати на удалённом принтере</div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel orders-center-panel hidden" id="printTemplatesPanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="printTemplatesPanelCards">
          <button class="settings-home-card settings-card" id="settingsPrintTemplateReceiptCard" type="button">
            <div class="product-avatar"><i class="fas fa-receipt"></i></div>
            <div class="order-col">
              <div class="product-title">Чек заказа</div>
              <div class="muted">HTML-шаблон печати заказа</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>
          <button class="settings-home-card settings-card" id="settingsPrintTemplateLabelCard" type="button">
            <div class="product-avatar"><i class="fas fa-tag"></i></div>
            <div class="order-col">
              <div class="product-title">Этикетка товара</div>
              <div class="muted">HTML-шаблон этикетки 58 x 60 мм</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <div class="panel orders-center-panel hidden" id="productionZonesPanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="productionZonesList"></div>
        <div class="empty-state hidden" id="productionZonesEmpty">
          <div class="empty-icon"><i class="fas fa-layer-group"></i></div>
          <div class="empty-title">Производственные зоны</div>
          <div class="empty-text">Создайте первую зону и выберите принтер для этикеток.</div>
        </div>
      </div>
    </div>

    <div class="panel stores-panel hidden" id="storesPanel">
      <div class="panel-body no-scrollbar">
        <div class="stores-list orders-list settings-cards" id="storesList"></div>
        <div class="empty-state hidden" id="storesEmpty">
          <div class="empty-icon"><i class="fas fa-store"></i></div>
          <div class="empty-title">Нет точек продаж</div>
          <div class="empty-text">Создайте первую точку, чтобы начать работу в новом районе.</div>
        </div>
      </div>
    </div>

    <div class="panel delivery-panel hidden" id="deliveryPanel">
      <div class="panel-body no-scrollbar">
        <div class="settings-delivery-map-card" id="settingsDeliveryMapBlock">
          <div class="settings-delivery-map-empty hidden" id="settingsDeliveryMapEmpty">
            <div class="settings-delivery-map-empty-title">Карта не настроена</div>
            <div class="settings-delivery-map-empty-text">Заполните параметры провайдера в разделе «Системные -> Карта», чтобы показать подложку здесь.</div>
          </div>
          <div class="settings-delivery-map-canvas hidden" id="settingsDeliveryMapCanvas"></div>
          <div class="settings-delivery-zone-map-overlay hidden" id="settingsDeliveryZoneMapOverlay">
            <div class="settings-delivery-zone-map-hint" id="settingsDeliveryZoneMapHint">Поставьте первую точку зоны</div>
            <div class="settings-delivery-zone-map-actions">
              <button class="btn btn-secondary btn-sm settings-delivery-zone-map-action-btn" type="button" id="settingsDeliveryZoneUndoBtn">
                <i class="fas fa-undo"></i>
                <span>Назад</span>
              </button>
              <button class="btn btn-secondary btn-sm settings-delivery-zone-map-action-btn" type="button" id="settingsDeliveryZoneClearPointsBtn">
                <i class="fas fa-eraser"></i>
                <span>Очистить точки</span>
              </button>
              <button class="btn btn-secondary btn-sm settings-delivery-zone-map-action-btn hidden" type="button" id="settingsDeliveryZoneAddPolygonBtn">
                <i class="fas fa-plus"></i>
                <span>Добавить полигон</span>
              </button>
              <button class="btn btn-secondary btn-sm settings-delivery-zone-map-action-btn hidden" type="button" id="settingsDeliveryZoneRemovePolygonBtn">
                <i class="fas fa-trash"></i>
                <span>Удалить полигон</span>
              </button>
            </div>
          </div>
          <div class="settings-delivery-zone-point-menu hidden" id="settingsDeliveryZonePointMenu">
            <button class="settings-delivery-zone-point-menu-item" type="button" id="settingsDeliveryZonePointMenuFinishBtn">Завершить</button>
            <button class="settings-delivery-zone-point-menu-item" type="button" id="settingsDeliveryZonePointMenuContinueBtn">Продолжить</button>
            <button class="settings-delivery-zone-point-menu-item is-danger" type="button" id="settingsDeliveryZonePointMenuRemoveLastBtn">Удалить последнюю точку</button>
          </div>
          <div class="settings-delivery-zone-context-menu hidden" id="settingsDeliveryZoneContextMenu">
            <button class="settings-delivery-zone-context-menu-item" type="button" id="settingsDeliveryZoneContextEditBtn">Редактировать</button>
            <button class="settings-delivery-zone-context-menu-item is-danger" type="button" id="settingsDeliveryZoneContextDeleteBtn">Удалить</button>
          </div>
        </div>
      </div>
    </div>

    <div class="panel site-panel hidden" id="sitePanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="sitePanelCards">
          <button class="settings-home-card settings-card" id="settingsSiteCard" type="button">
            <div class="product-avatar"><i class="fas fa-globe"></i></div>
            <div class="order-col">
              <div class="product-title">Данные сайта</div>
              <div class="muted">Название, описание, домен</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsDomainCard" type="button">
            <div class="product-avatar"><i class="fas fa-link"></i></div>
            <div class="order-col">
              <div class="product-title">Домен</div>
              <div class="muted">Подключить свой домен</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsPwaQrCard" type="button" onclick="if(window.__openSettingsPwaQrTab){window.__openSettingsPwaQrTab();}">
            <div class="product-avatar"><i class="fas fa-qrcode"></i></div>
            <div class="order-col">
              <div class="product-title">QR для PWA</div>
              <div class="muted">Сгенерировать QR-код для установки витрины</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsTelegramAppCard" type="button">
            <div class="product-avatar product-avatar--image">
              <img class="product-avatar-img" src="/static/uploads/auth/telegram-auth.png" alt="Telegram mini app icon" loading="lazy" />
            </div>
            <div class="order-col">
              <div class="product-title">Мини-приложение Telegram</div>
              <div class="muted">Ссылка для Telegram-бота</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsMaxAppCard" type="button">
            <div class="product-avatar product-avatar--image">
              <img class="product-avatar-img" src="/static/uploads/auth/max-auth.png" alt="MAX mini app icon" loading="lazy" />
            </div>
            <div class="order-col">
              <div class="product-title">Мини-приложение MAX</div>
              <div class="muted">Токен бота для авторизации</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <div class="panel site-panel hidden" id="systemPanel">
      <div class="panel-body no-scrollbar">
        <div class="orders-list settings-cards" id="systemPanelCards">
          <button class="settings-home-card settings-card" id="settingsSystemMapCard" type="button">
            <div class="product-avatar"><i class="fas fa-map-marked-alt"></i></div>
            <div class="order-col">
              <div class="product-title">Карта</div>
              <div class="muted">Провайдер, tile URL, атрибуция и масштаб</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsSystemDeliveryZonePolygonCard" type="button">
            <div class="product-avatar"><i class="fas fa-draw-polygon"></i></div>
            <div class="order-col">
              <div class="product-title">Полигоны доставки</div>
              <div class="muted">Сервис рисования зон для карты</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsSystemTelegramBotCard" type="button">
            <div class="product-avatar"><i class="fab fa-telegram-plane"></i></div>
            <div class="order-col">
              <div class="product-title">Telegram бот</div>
              <div class="muted">Username, token и webhook системного бота</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>

          <button class="settings-home-card settings-card" id="settingsSystemMaxBotCard" type="button">
            <div class="product-avatar"><i class="fas fa-robot"></i></div>
            <div class="order-col">
              <div class="product-title">MAX бот</div>
              <div class="muted">Bot ID, token и webhook системного бота</div>
            </div>
            <div class="order-col">
              <span class="badge">Открыть</span>
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="center-stack">
    <div class="panel toolbar-island">
      <div class="toolbar">
        <div class="toolbar-title">
          <i class="fas fa-home"></i>
          <span>Меню</span>
        </div>
      </div>
    </div>

    <div class="panel orders-center-panel">
      <div class="panel-body no-scrollbar">
        <p class="muted">Тут будут товары из базы данных...</p>
      </div>
    </div>
  </div>
<% } %>
