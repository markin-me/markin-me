<% if (activePage === "settings") { %>
  <div class="panel">
    <div class="panel-header settings-right-header hidden">
      <div class="product-tabs settings-right-tabs hidden" id="settingsRightTabs"></div>
    </div>
    <div class="panel-header product-tabs-header hidden" id="settingsDeliveryTabsHeader">
      <div class="product-tabs-header-inner">
        <button class="product-tabs-home" type="button" id="settingsDeliveryTabsHomeBtn" aria-label="Главная доставки">
          <i class="fas fa-home"></i>
        </button>
        <div class="product-tabs" id="settingsDeliveryTabs"></div>
      </div>
    </div>
    <div class="panel-body no-scrollbar settings-right-body">
      <div class="info-card" id="settingsRightDefault">
        <div class="info-title">Выберите пункт для редактирования</div>
        <div class="info-text">Откройте нужный раздел слева, чтобы увидеть настройки.</div>
      </div>

      <div class="info-card hidden" id="settingsStoreEmpty">
        <div class="info-title">Филиалы</div>
        <div class="info-text">Выберите точку слева, чтобы посмотреть и изменить её данные.</div>
      </div>

      <div class="info-card settings-right-panel settings-right-panel-fixed-footer hidden" id="settingsStorePanel">
        <form class="settings-site-form settings-panel-scroll" id="settingsStoreForm" autocomplete="off" data-lpignore="true" data-1p-ignore="true" data-form-type="other">
          <input type="text" tabindex="-1" aria-hidden="true" autocomplete="name" name="store-fake-name" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none" />
          <input type="text" tabindex="-1" aria-hidden="true" autocomplete="street-address" name="store-fake-address" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none" />
          <input type="tel" tabindex="-1" aria-hidden="true" autocomplete="tel" name="store-fake-phone" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none" />
          <input type="password" tabindex="-1" aria-hidden="true" autocomplete="new-password" name="store-fake-password" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none" />
          <div class="settings-list-header settings-delivery-zone-header">
            <div class="settings-delivery-zone-header-main">
              <div class="settings-delivery-zone-title-row">
                <div class="settings-list-title">Филиал</div>
              </div>
              <div class="settings-list-subtitle hidden" id="settingsStoreSubtitle" aria-hidden="true"></div>
            </div>
            <label class="switch settings-delivery-zone-header-switch">
              <input class="switch-input" type="checkbox" id="settingsStoreActive" />
              <span class="switch-ui" aria-hidden="true"></span>
              <span class="switch-text">Активна</span>
            </label>
          </div>
          <div class="settings-site-field">
            <label class="field-label">НАЗВАНИЕ</label>
            <input class="control" type="text" id="settingsStoreName" required autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" />
          </div>
          <input type="hidden" id="settingsStoreCode" />
          <div class="settings-store-top-grid">
            <div class="settings-site-field">
              <label class="field-label">ГОРОД</label>
              <div class="settings-store-address-wrap has-trigger" id="settingsStoreCityWrap">
                <input class="control" type="text" id="settingsStoreCity" placeholder="Выберите город из списка" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" />
                <button class="settings-store-address-trigger" type="button" id="settingsStoreCityTrigger" aria-label="Открыть список городов филиала">
                  <i class="fas fa-chevron-down"></i>
                </button>
                <div class="settings-store-address-popover hidden" id="settingsStoreCityPopover" role="dialog" aria-label="Подсказки города филиала">
                  <div class="settings-store-address-status hidden" id="settingsStoreCityStatus"></div>
                  <div class="settings-store-address-results hidden" id="settingsStoreCityResults"></div>
                </div>
              </div>
            </div>
            <div class="settings-site-field settings-store-timezone-field">
              <label class="field-label">ЧАСОВОЙ ПОЯС</label>
              <div class="settings-store-timezone-selector settings-delivery-city-selector new-order-right-select-wrap" id="settingsStoreTimezoneSelector">
                <select id="settingsStoreTimezoneSelect" class="hidden" tabindex="-1" aria-hidden="true"></select>
                <button class="new-order-right-select-trigger" type="button" id="settingsStoreTimezoneTrigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Выбрать часовой пояс филиала">
                  <span class="cash-toolbar-filter-main">
                    <span id="settingsStoreTimezoneValue">+0</span>
                  </span>
                  <i class="fas fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="new-order-right-select-menu" id="settingsStoreTimezoneMenu" role="listbox" aria-label="Часовой пояс филиала"></div>
              </div>
            </div>
          </div>
          <div class="settings-site-field hidden" id="settingsStoreAddressLookupField">
            <label class="field-label">АДРЕС</label>
            <div class="settings-store-address-wrap has-map-btn" id="settingsStoreAddressLookupWrap">
              <input class="control" type="text" id="settingsStoreAddressLookup" placeholder="Начните вводить адрес и выберите вариант из базы" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" disabled />
              <button class="settings-store-map-icon-btn" type="button" id="settingsStoreAddressMapBtn" aria-label="Уточнить точку филиала на карте" disabled>
                <i class="fas fa-map-marker-alt"></i>
              </button>
              <div class="settings-store-address-popover hidden" id="settingsStoreAddressLookupPopover" role="dialog" aria-label="Подсказки адреса филиала">
                <div class="settings-store-address-status hidden" id="settingsStoreAddressLookupStatus"></div>
                <div class="settings-store-address-results hidden" id="settingsStoreAddressLookupResults"></div>
              </div>
            </div>
            <div class="field-hint settings-store-map-hint" id="settingsStoreAddressMapHint">Карта уточняет только координату. Текст адреса остаётся как в полях выше.</div>
          </div>
          <div class="settings-site-field">
            <label class="field-label">РАЙОН / ЛОКАЛЬНОСТЬ</label>
            <input class="control" type="text" id="settingsStoreLocality" placeholder="Например, Бажево" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">УЛИЦА</label>
            <div class="settings-store-address-wrap" id="settingsStoreAddressWrap">
              <input class="control" type="text" id="settingsStoreAddress" placeholder="Например, 22 партсъезда или 8 микрорайон" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" disabled />
              <div class="settings-store-address-popover hidden" id="settingsStoreAddressPopover" role="dialog" aria-label="Подсказки улицы филиала">
                <div class="settings-store-address-status hidden" id="settingsStoreAddressStatus"></div>
                <div class="settings-store-address-results hidden" id="settingsStoreAddressResults"></div>
              </div>
            </div>
          </div>
          <div class="settings-store-compact-grid">
            <div class="settings-site-field settings-store-compact-field">
              <label class="field-label">ДОМ</label>
              <div class="settings-store-address-wrap" id="settingsStoreHouseWrap">
                <input class="control" type="text" id="settingsStoreHouse" placeholder="29" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" disabled />
                <div class="settings-store-address-popover hidden" id="settingsStoreHousePopover" role="dialog" aria-label="Подсказки номера дома филиала">
                  <div class="settings-store-address-status hidden" id="settingsStoreHouseStatus"></div>
                  <div class="settings-store-address-results hidden" id="settingsStoreHouseResults"></div>
                </div>
              </div>
            </div>
            <div class="settings-site-field settings-store-compact-field">
              <label class="field-label">ЭТ.</label>
              <input class="control" type="text" id="settingsStoreFloor" placeholder="2" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" />
            </div>
            <div class="settings-site-field settings-store-compact-field">
              <label class="field-label">КВ.</label>
              <input class="control" type="text" id="settingsStoreApartment" placeholder="15" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" />
            </div>
            <div class="settings-site-field settings-store-compact-field">
              <label class="field-label">КАБ.</label>
              <input class="control" type="text" id="settingsStoreCabinet" placeholder="4" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" />
            </div>
          </div>
          <div class="settings-site-field">
            <label class="field-label">КОММЕНТАРИЙ</label>
            <input class="control" type="text" id="settingsStoreAddressComment" placeholder="Например, вход со двора" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ТЕЛЕФОН</label>
            <input class="control" type="text" id="settingsStorePhone" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">График работы</label>
            <div class="store-hours-card">
              <label class="switch store-hours-switch-control">
                <input class="switch-input" type="checkbox" id="settingsStoreHoursSameSwitch" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-text">Одинаковое расписание для всех дней</span>
              </label>
              <div class="store-hours-grid" id="settingsStoreHoursContainer"></div>
            </div>
          </div>
          <div class="settings-site-field">
            <label class="field-label">График доставки</label>
            <div class="store-hours-card">
              <label class="switch store-hours-switch-control">
                <input class="switch-input" type="checkbox" id="settingsStoreDeliveryHoursSameSwitch" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-text">Одинаковое расписание для доставки</span>
              </label>
              <div class="store-hours-grid" id="settingsStoreDeliveryHoursContainer"></div>
            </div>
          </div>
          <div class="settings-site-field" id="settingsStoreTelegramBlock">
            <div class="settings-list-header">
              <label class="field-label" style="margin-bottom:0">УВЕДОМЛЕНИЯ В TELEGRAM</label>
              <button type="button" class="btn btn-icon btn-sm global-telegram-add-toggle" id="settingsStoreTelegramToggleBtn" title="Добавить Telegram">
                <i class="fas fa-plus"></i>
              </button>
            </div>
            <!-- Форма добавления (скрыта по умолчанию) -->
            <div class="global-telegram-connect hidden" id="settingsStoreTelegramConnectBlock">
              <% if (typeof telegramBotUsername !== 'undefined' && telegramBotUsername) { %>
              <p class="field-hint">Получайте заявки в Telegram с помощью нашего бота. Для этого перейдите по ссылке: <a href="https://t.me/<%= telegramBotUsername %>" target="_blank" rel="noopener">https://t.me/<%= telegramBotUsername %></a> и напишите команду <strong>/start</strong>. Через некоторое время бот пришлёт API key и Secret key, которые нужно вставить в поля ниже.</p>
              <% } else { %>
              <p class="field-hint">Перейдите в бота, напишите /start — бот пришлёт API key и Secret key. Вставьте их в поля ниже.</p>
              <% } %>
              <div class="field-group">
                <label class="field-label">TELEGRAM API KEY</label>
                <input class="control" type="text" id="settingsStoreTelegramApiKey" placeholder="Например: 915611204" />
              </div>
              <div class="field-group">
                <label class="field-label">SECRET KEY</label>
                <input class="control" type="text" id="settingsStoreTelegramSecretKey" placeholder="Ключ от бота" />
              </div>
              <div class="global-telegram-form-actions">
                <button class="btn btn-primary btn-sm" type="button" id="settingsStoreTelegramAddByKeysBtn">Добавить</button>
                <button class="btn btn-link btn-sm" type="button" id="settingsStoreTelegramCancelBtn">Отмена</button>
              </div>
            </div>
            <!-- Список подключений -->
            <div id="settingsStoreTelegramList"></div>
          </div>
          <div class="settings-site-field" id="settingsStoreMaxBlock">
            <div class="settings-list-header">
              <label class="field-label" style="margin-bottom:0">УВЕДОМЛЕНИЯ В MAX</label>
              <button type="button" class="btn btn-icon btn-sm global-telegram-add-toggle" id="settingsStoreMaxToggleBtn" title="Добавить MAX">
                <i class="fas fa-plus"></i>
              </button>
            </div>
            <div class="global-telegram-connect hidden" id="settingsStoreMaxConnectBlock">
              <% if (typeof systemMaxBotId !== 'undefined' && systemMaxBotId) { %>
              <p class="field-hint">Получайте заявки в MAX с помощью нашего бота. Для этого перейдите по ссылке: <a href="https://max.ru/<%= systemMaxBotId %>" target="_blank" rel="noopener">https://max.ru/<%= systemMaxBotId %></a> и напишите команду <strong>/start</strong>. Через некоторое время бот пришлёт API key и Secret key, которые нужно вставить в поля ниже.</p>
              <% } else { %>
              <p class="field-hint">Перейдите в MAX-бота, напишите /start и вставьте полученные API key и Secret key в поля ниже.</p>
              <% } %>
              <div class="field-group">
                <label class="field-label">MAX API KEY</label>
                <input class="control" type="text" id="settingsStoreMaxApiKey" placeholder="Например: 1234567890" />
              </div>
              <div class="field-group">
                <label class="field-label">SECRET KEY</label>
                <input class="control" type="text" id="settingsStoreMaxSecretKey" placeholder="Ключ от MAX-бота" />
              </div>
              <div class="global-telegram-form-actions">
                <button class="btn btn-primary btn-sm" type="button" id="settingsStoreMaxAddByKeysBtn">Добавить</button>
                <button class="btn btn-link btn-sm" type="button" id="settingsStoreMaxCancelBtn">Отмена</button>
              </div>
            </div>
            <div id="settingsStoreMaxList"></div>
          </div>
        </form>
        <div class="panel-footer">
          <div class="stores-form-actions settings-footer-actions">
            <button class="settings-footer-btn settings-footer-btn--save" type="button" id="settingsStoreSaveBtn">
              <span id="settingsStoreSaveText">Сохранить</span>
            </button>
            <button class="settings-footer-btn settings-footer-btn--cancel" type="button" id="settingsStoreResetBtn" title="Сбросить" aria-label="Сбросить">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
      </div>

      <div class="settings-store-map-modal hidden" id="settingsStoreAddressMapModal" role="dialog" aria-modal="true" aria-labelledby="settingsStoreAddressMapTitle">
        <div class="settings-store-map-modal__card">
          <div class="settings-store-map-modal__head">
            <div>
              <div class="settings-store-map-modal__title" id="settingsStoreAddressMapTitle">Точка филиала на карте</div>
              <div class="settings-store-map-modal__subtitle" id="settingsStoreAddressMapSubtitle">Кликните по карте или перетащите маркер, чтобы уточнить координату.</div>
            </div>
            <button class="icon-btn settings-store-map-modal__close" type="button" id="settingsStoreAddressMapCloseBtn" aria-label="Закрыть карту">
              <i class="fas fa-times"></i>
            </button>
          </div>
          <div class="settings-store-map-modal__status hidden" id="settingsStoreAddressMapStatus"></div>
          <div class="settings-store-map-modal__canvas" id="settingsStoreAddressMapCanvas"></div>
          <div class="settings-store-map-modal__coords" id="settingsStoreAddressMapCoords">Координата ещё не выбрана.</div>
          <div class="settings-store-map-modal__actions">
            <button class="btn btn-link btn-sm" type="button" id="settingsStoreAddressMapResetBtn">Сбросить уточнение</button>
            <button class="btn btn-primary btn-sm" type="button" id="settingsStoreAddressMapApplyBtn">Применить точку</button>
          </div>
        </div>
      </div>

      <div class="info-card settings-right-panel settings-right-panel-fixed-footer hidden" id="settingsChatAssistantNamePanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Виртуальный помощник</div>
          <div class="settings-list-subtitle">Имя, пол, приветствие и сетка горячих вопросов.</div>
        </div>
        <div class="settings-site-form settings-panel-scroll no-scrollbar">
          <div class="settings-site-field">
            <label class="field-label">ИМЯ ПОМОЩНИКА</label>
            <input class="control" type="text" id="settingsChatAssistantNameInput" data-tenant-input="chat_assistant_name" placeholder="Ням-Ням" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ПОЛ</label>
            <div class="settings-chat-gender-options" id="settingsChatAssistantGenderOptions">
              <label class="settings-chat-gender-option">
                <input class="settings-chat-gender-input" type="radio" name="settingsChatAssistantGender" id="settingsChatAssistantGenderMale" value="m" checked />
                <span class="settings-chat-gender-dot" aria-hidden="true"></span>
                <span class="settings-chat-gender-label">Мужской</span>
              </label>
              <label class="settings-chat-gender-option">
                <input class="settings-chat-gender-input" type="radio" name="settingsChatAssistantGender" id="settingsChatAssistantGenderFemale" value="f" />
                <span class="settings-chat-gender-dot" aria-hidden="true"></span>
                <span class="settings-chat-gender-label">Женский</span>
              </label>
            </div>
          </div>
          <div class="settings-site-field" id="settingsChatWelcomeSection">
            <div class="settings-chat-question-row settings-chat-welcome-row is-collapsed" id="settingsChatWelcomeRow">
              <div class="settings-chat-question-row-head">
                <button
                  class="settings-chat-question-expand-btn"
                  type="button"
                  id="settingsChatWelcomeExpandBtn"
                  aria-label="Toggle welcome message"
                  aria-expanded="false"
                >
                  <i class="fas fa-chevron-down"></i>
                </button>
                <label class="field-label settings-chat-welcome-label" for="settingsChatWelcomeEnabledSwitch">ПРИВЕТСТВИЕ В ЧАТЕ</label>
                <div class="settings-chat-question-row-controls">
                  <label class="switch settings-chat-question-switch">
                    <input class="switch-input" type="checkbox" id="settingsChatWelcomeEnabledSwitch" checked />
                    <span class="switch-ui" aria-hidden="true"></span>
                  </label>
                </div>
              </div>
              <div class="settings-chat-question-row-body" id="settingsChatWelcomeBody" hidden>
                <textarea class="textarea" id="settingsChatWelcomeMessageInput" rows="5" data-tenant-input="chat_welcome_message" placeholder="Привет! Я виртуальный помощник..."></textarea>
              </div>
            </div>
          </div>
          <div class="settings-site-field" id="settingsChatQuickQuestionsSection">
            <div class="settings-chat-question-row-head settings-chat-quick-questions-head">
              <label class="field-label settings-chat-quick-questions-label" for="settingsChatQuickQuestionsEnabledSwitch">КНОПКИ БЫСТРЫХ ВОПРОСОВ</label>
              <div class="settings-chat-question-row-controls">
                <label class="switch settings-chat-question-switch">
                  <input class="switch-input" type="checkbox" id="settingsChatQuickQuestionsEnabledSwitch" checked />
                  <span class="switch-ui" aria-hidden="true"></span>
                </label>
              </div>
            </div>
            <div class="settings-chat-questions-grid" id="settingsChatHotQuestionsGrid"></div>
            <div class="settings-chat-question-add-wrap">
              <button class="settings-chat-question-add-btn" type="button" id="settingsChatQuickQuestionsAddBtn" aria-label="Add quick question">
                <i class="fas fa-plus"></i>
              </button>
            </div>
            <input class="hidden" type="text" id="settingsChatQuickQuestionsJson" data-tenant-input="chat_quick_questions_json" />
          </div>
        </div>
        <div class="panel-footer">
          <div class="product-footer-actions">
            <div class="product-footer-view" id="settingsChatAssistantFooterView">
              <button class="product-footer-btn product-footer-edit" type="button" id="settingsChatAssistantEditBtn">Редактировать</button>
            </div>
            <div class="product-footer-edit-mode hidden" id="settingsChatAssistantFooterEdit">
              <button class="product-footer-btn product-footer-cancel" type="button" id="settingsChatAssistantCancelBtn" title="Отменить" aria-label="Отменить">
                <i class="fas fa-times"></i>
              </button>
              <button class="product-footer-btn product-footer-save" type="button" id="settingsChatAssistantNameSaveBtn">Сохранить</button>
            </div>
          </div>
        </div>
      </div>

      <div class="info-card settings-right-panel settings-right-panel-fixed-footer hidden" id="settingsChatOperatorNamePanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Имя оператора</div>
          <div class="settings-list-subtitle">По умолчанию используется название компании, но можно задать вручную.</div>
        </div>
        <div class="settings-site-form settings-panel-scroll no-scrollbar">
          <div class="settings-site-field">
            <label class="field-label">ИМЯ ОПЕРАТОРА</label>
            <input class="control" type="text" id="settingsChatOperatorNameInput" data-tenant-input="chat_operator_name" placeholder="Оператор" />
            <div class="field-hint">Если поле пустое, будет использоваться значение по умолчанию.</div>
          </div>
        </div>
        <div class="panel-footer">
          <div class="product-footer-actions">
            <div class="product-footer-view" id="settingsChatOperatorFooterView">
              <button class="product-footer-btn product-footer-edit" type="button" id="settingsChatOperatorEditBtn">Редактировать</button>
            </div>
            <div class="product-footer-edit-mode hidden" id="settingsChatOperatorFooterEdit">
              <button class="product-footer-btn product-footer-cancel" type="button" id="settingsChatOperatorCancelBtn" title="Отменить" aria-label="Отменить">
                <i class="fas fa-times"></i>
              </button>
              <button class="product-footer-btn product-footer-save" type="button" id="settingsChatOperatorNameSaveBtn">Сохранить</button>
            </div>
          </div>
        </div>
      </div>

      <div class="info-card settings-right-panel settings-right-panel-fixed-footer hidden" id="settingsChatMessageSettingsPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Настройка сообщений</div>
          <div class="settings-list-subtitle">Параметры автоочистки истории чатов.</div>
        </div>
        <div class="settings-site-form settings-panel-scroll no-scrollbar">
          <div class="settings-site-field">
            <label class="field-label">ВРЕМЯ ЖИЗНИ ВСЕХ ЧАТОВ (ДНЕЙ)</label>
            <input class="control" type="number" min="0" max="365" step="1" id="settingsChatThreadTtlDaysInput" data-tenant-input="chat_thread_ttl_days" placeholder="0" />
            <div class="field-hint">0 или пусто: хранить всегда. Значение 1-365: удалять историю всех чатов без активности старше указанного срока.</div>
          </div>
          <div class="settings-site-field">
