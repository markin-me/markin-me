<% if (activePage === "settings") { %>
  <div class="panel">
    <div class="panel-header settings-right-header hidden">
      <div class="product-tabs settings-right-tabs hidden" id="settingsRightTabs"></div>
    </div>
    <div class="panel-body no-scrollbar">
      <div class="info-card" id="settingsRightDefault">
        <div class="info-title">Выберите пункт для редактирования</div>
        <div class="info-text">Откройте нужный раздел слева, чтобы увидеть настройки.</div>
      </div>

      <div class="info-card hidden" id="settingsStoreEmpty">
        <div class="info-title">Филиалы</div>
        <div class="info-text">Выберите точку слева, чтобы посмотреть и изменить её данные.</div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsStorePanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Филиал</div>
          <div class="settings-list-subtitle" id="settingsStoreSubtitle">—</div>
        </div>
        <form class="settings-site-form" id="settingsStoreForm">
          <div class="settings-site-field">
            <label class="field-label">НАЗВАНИЕ</label>
            <input class="control" type="text" id="settingsStoreName" required />
          </div>
          <div class="settings-site-field">
            <label class="field-label">КОД</label>
            <input class="control" type="text" id="settingsStoreCode" placeholder="store-2" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">АДРЕС</label>
            <input class="control" type="text" id="settingsStoreAddress" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ГОРОД</label>
            <input class="control" type="text" id="settingsStoreCity" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ТЕЛЕФОН</label>
            <input class="control" type="text" id="settingsStorePhone" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ЧАСОВОЙ ПОЯС</label>
            <select id="settingsStoreTimezoneSelect" class="order-head-select tenant-timezone-select" aria-label="Часовой пояс точки"></select>
          </div>
          <div class="settings-site-field">
            <label class="field-label">График работы</label>
            <div class="store-hours-card">
              <label class="switch store-hours-switch-control">
                <input class="switch-input" type="checkbox" id="settingsStoreHoursSameSwitch" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-text">Одинаковое расписание для всех дней</span>
              </label>
              <div class="store-hours-grid" id="settingsStoreHoursContainer"></div>
            </div>
          </div>
          <div class="settings-site-field">
            <label class="field-label">График доставки</label>
            <div class="store-hours-card">
              <label class="switch store-hours-switch-control">
                <input class="switch-input" type="checkbox" id="settingsStoreDeliveryHoursSameSwitch" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-text">Одинаковое расписание для доставки</span>
              </label>
              <div class="store-hours-grid" id="settingsStoreDeliveryHoursContainer"></div>
            </div>
          </div>
          <div class="settings-site-field">
            <label class="field-label">СТАТУС</label>
            <label class="switch">
              <input class="switch-input" type="checkbox" id="settingsStoreActive" />
              <span class="switch-ui" aria-hidden="true"></span>
              <span class="switch-text">Активна</span>
            </label>
          </div>
          <div class="settings-site-field" id="settingsStoreTelegramBlock">
            <label class="field-label">УВЕДОМЛЕНИЯ В TELEGRAM</label>
            <div class="store-telegram-status muted" id="settingsStoreTelegramStatus">Загрузка…</div>
            <div class="store-telegram-actions hidden" id="settingsStoreTelegramActions"></div>
            <div class="store-telegram-by-keys mt-2">
              <% if (typeof telegramBotUsername !== 'undefined' && telegramBotUsername) { %>
              <p class="field-hint">Получайте заявки в Telegram с помощью нашего бота. Для этого перейдите по ссылке: <a href="https://t.me/<%= telegramBotUsername %>" target="_blank" rel="noopener">https://t.me/<%= telegramBotUsername %></a> и напишите команду <strong>/start</strong>. Через некоторое время бот пришлёт API key и Secret key, которые нужно вставить в поля ниже.</p>
              <% } else { %>
              <p class="field-hint">Перейдите в бота, напишите /start — бот пришлёт API key и Secret key. Вставьте их в поля ниже.</p>
              <% } %>
              <div class="settings-site-field">
                <label class="field-label">TELEGRAM API KEY</label>
                <input class="control" type="text" id="settingsStoreTelegramApiKey" placeholder="Например: 915611204" />
              </div>
              <div class="settings-site-field">
                <label class="field-label">SECRET KEY</label>
                <input class="control" type="text" id="settingsStoreTelegramSecretKey" placeholder="Ключ от бота" />
              </div>
              <button class="btn btn-primary btn-sm" type="button" id="settingsStoreTelegramAddByKeysBtn">Добавить</button>
            </div>
            <ul class="store-telegram-list list-unstyled hidden" id="settingsStoreTelegramList"></ul>
          </div>
        </form>
        <div class="stores-form-actions">
          <button class="btn btn-primary btn-sm" type="button" id="settingsStoreSaveBtn">
            <span id="settingsStoreSaveText">Сохранить</span>
          </button>
          <button class="btn btn-link btn-sm" type="button" id="settingsStoreResetBtn">Сбросить</button>
        </div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsNotificationsPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Уведомления</div>
          <div class="settings-list-subtitle muted">Telegram-уведомления о новых заказах по филиалам</div>
        </div>
        <p class="field-hint">Подключите Telegram в настройках каждого филиала — уведомления будут приходить только по заказам этой точки.</p>
        <div class="notifications-stores-list" id="notificationsStoresList">
          <div class="muted">Загрузка…</div>
        </div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsLogoPanel">
        <div class="settings-logo-grid">
          <div class="settings-logo-tile" data-logo-key="logo_light_url">
            <div class="settings-logo-title">Логотип (светлая тема)</div>
            <button class="settings-logo-box" type="button" data-upload-box="logo_light_url">
              <img class="settings-logo-preview hidden" data-upload-preview="logo_light_url" alt="" />
              <div class="settings-logo-hint">Рекомендуемый размер: 512x512</div>
            </button>
            <input class="hidden" type="file" accept="image/*" data-upload-input="logo_light_url" />
            <input class="hidden" type="text" data-tenant-input="logo_light_url" />
            <div class="settings-logo-actions">
              <button class="btn btn-icon btn-sm settings-logo-upload" type="button" title="Загрузить" data-upload-action="logo_light_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-logo-delete" type="button" title="Удалить" data-delete-action="logo_light_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>

          <div class="settings-logo-tile" data-logo-key="logo_dark_url">
            <div class="settings-logo-title">Логотип (тёмная тема)</div>
            <button class="settings-logo-box" type="button" data-upload-box="logo_dark_url">
              <img class="settings-logo-preview hidden" data-upload-preview="logo_dark_url" alt="" />
              <div class="settings-logo-hint">Рекомендуемый размер: 512x512</div>
            </button>
            <input class="hidden" type="file" accept="image/*" data-upload-input="logo_dark_url" />
            <input class="hidden" type="text" data-tenant-input="logo_dark_url" />
            <div class="settings-logo-actions">
              <button class="btn btn-icon btn-sm settings-logo-upload" type="button" title="Загрузить" data-upload-action="logo_dark_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-logo-delete" type="button" title="Удалить" data-delete-action="logo_dark_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>

          <div class="settings-logo-tile" data-logo-key="favicon_light_url">
            <div class="settings-logo-title">Фавикон (светлая тема)</div>
            <button class="settings-logo-box" type="button" data-upload-box="favicon_light_url">
              <img class="settings-logo-preview hidden" data-upload-preview="favicon_light_url" alt="" />
              <div class="settings-logo-hint">Рекомендуемый размер: 32x32</div>
            </button>
            <input class="hidden" type="file" accept="image/*" data-upload-input="favicon_light_url" />
            <input class="hidden" type="text" data-tenant-input="favicon_light_url" />
            <div class="settings-logo-actions">
              <button class="btn btn-icon btn-sm settings-logo-upload" type="button" title="Загрузить" data-upload-action="favicon_light_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-logo-delete" type="button" title="Удалить" data-delete-action="favicon_light_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>

          <div class="settings-logo-tile" data-logo-key="favicon_dark_url">
            <div class="settings-logo-title">Фавикон (тёмная тема)</div>
            <button class="settings-logo-box" type="button" data-upload-box="favicon_dark_url">
              <img class="settings-logo-preview hidden" data-upload-preview="favicon_dark_url" alt="" />
              <div class="settings-logo-hint">Рекомендуемый размер: 32x32</div>
            </button>
            <input class="hidden" type="file" accept="image/*" data-upload-input="favicon_dark_url" />
            <input class="hidden" type="text" data-tenant-input="favicon_dark_url" />
            <div class="settings-logo-actions">
              <button class="btn btn-icon btn-sm settings-logo-upload" type="button" title="Загрузить" data-upload-action="favicon_dark_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-logo-delete" type="button" title="Удалить" data-delete-action="favicon_dark_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
          <div class="settings-logo-tile" data-logo-key="apple_touch_icon_url">
            <div class="settings-logo-title">Иконка для iPhone (Apple Touch)</div>
            <button class="settings-logo-box" type="button" data-upload-box="apple_touch_icon_url">
              <img class="settings-logo-preview hidden" data-upload-preview="apple_touch_icon_url" alt="" />
              <div class="settings-logo-hint">Рекомендуемый размер: 180x180</div>
            </button>
            <input class="hidden" type="file" accept="image/*" data-upload-input="apple_touch_icon_url" />
            <input class="hidden" type="text" data-tenant-input="apple_touch_icon_url" />
            <div class="settings-logo-actions">
              <button class="btn btn-icon btn-sm settings-logo-upload" type="button" title="Загрузить" data-upload-action="apple_touch_icon_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-logo-delete" type="button" title="Удалить" data-delete-action="apple_touch_icon_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>

          <div class="settings-logo-tile" data-logo-key="android_icon_url">
            <div class="settings-logo-title">Иконка для Android (PWA)</div>
            <button class="settings-logo-box" type="button" data-upload-box="android_icon_url">
              <img class="settings-logo-preview hidden" data-upload-preview="android_icon_url" alt="" />
              <div class="settings-logo-hint">Рекомендуемый размер: 512x512</div>
            </button>
            <input class="hidden" type="file" accept="image/*" data-upload-input="android_icon_url" />
            <input class="hidden" type="text" data-tenant-input="android_icon_url" />
            <div class="settings-logo-actions">
              <button class="btn btn-icon btn-sm settings-logo-upload" type="button" title="Загрузить" data-upload-action="android_icon_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-logo-delete" type="button" title="Удалить" data-delete-action="android_icon_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsSitePanel">
        <div class="settings-site-form">
          <div class="settings-site-field">
            <label class="field-label">НАЗВАНИЕ САЙТА</label>
            <input class="control" type="text" placeholder="Например: По щам" data-tenant-input="site_name" data-site-input="site_name" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ОПИСАНИЕ САЙТА</label>
            <textarea class="textarea" rows="3" placeholder="Короткое описание" data-tenant-input="site_description" data-site-input="site_description"></textarea>
          </div>
          <div class="settings-site-field">
            <label class="field-label">СУБДОМЕН</label>
            <input class="control" type="text" placeholder="myshop" data-tenant-input="subdomain" data-site-input="subdomain" />
            <div class="settings-site-link">
              <span class="field-hint">Ссылка на магазин:</span>
              <a class="settings-site-link-url" id="siteSubdomainLink" href="#" target="_blank" rel="noopener">—</a>
            </div>
          </div>
          <div class="settings-site-field">
            <label class="field-label">ПОДКЛЮЧИТЬ СВОЙ ДОМЕН</label>
            <input class="control" type="text" placeholder="example.com" data-tenant-input="custom_domain" data-site-input="custom_domain" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">Ссылка для Telegram mini app</label>
            <div class="settings-site-link">
              <span class="field-hint">Используйте эту ссылку в настройках бота:</span>
              <a class="settings-site-link-url" id="tenantTelegramMiniAppLink" href="#" target="_blank" rel="noopener">—</a>
            </div>
          </div>
        </div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsBrandPanel">
        <div class="settings-site-form">
          <div class="settings-site-field">
            <label class="field-label">НАЗВАНИЕ БРЕНДА</label>
            <input class="control" type="text" placeholder="Название бренда" data-tenant-input="name" data-brand-input="name" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">EMAIL</label>
            <input class="control" type="email" placeholder="email@example.com" data-tenant-input="email" data-brand-input="email" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ТЕЛЕФОН</label>
            <input class="control" type="text" placeholder="+7..." data-tenant-input="phone" data-brand-input="phone" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ЧАСОВОЙ ПОЯС</label>
            <select id="brandTimezoneSelect" class="order-head-select tenant-timezone-select" aria-label="ЧАСОВОЙ ПОЯС"></select>
          </div>
          <div class="settings-site-field">
            <label class="field-label">ПАРОЛЬ</label>
            <div class="settings-password-grid">
              <input class="control" type="password" placeholder="Новый пароль" id="brandPassword" />
              <input class="control" type="password" placeholder="Повторите пароль" id="brandPasswordConfirm" />
              <button class="btn btn-primary" type="button" id="brandPasswordSave">Сменить пароль</button>
            </div>
          </div>
        </div>
      </div>

      

      <div class="info-card settings-right-panel hidden" id="settingsSoundsPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Звуки уведомлений</div>
          <div class="settings-list-subtitle">Загрузите звуковые файлы для новых заказов, отмен и сообщений.</div>
        </div>
        <div class="settings-sounds-grid">
          <div class="settings-sound-tile" data-sound-key="sound_new_order_url">
            <div class="settings-sound-title">Новый заказ</div>
            <div class="settings-sound-hint">Воспроизводится при появлении нового заказа</div>
            <div class="settings-sound-box" data-sound-box="sound_new_order_url">
              <span class="settings-sound-label" data-sound-label="sound_new_order_url">Файл не выбран</span>
              <button class="btn btn-icon btn-sm settings-sound-play hidden" type="button" title="Прослушать" data-sound-play="sound_new_order_url" aria-label="Прослушать">
                <i class="fas fa-play"></i>
              </button>
            </div>
            <input class="hidden" type="file" accept="audio/*,.mp3,.wav,.ogg,.webm,.m4a,.aac" data-sound-input="sound_new_order_url" />
            <input class="hidden" type="text" data-tenant-input="sound_new_order_url" />
            <div class="settings-sound-actions">
              <button class="btn btn-icon btn-sm settings-sound-upload" type="button" title="Загрузить" data-sound-upload="sound_new_order_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-sound-delete" type="button" title="Удалить" data-sound-delete="sound_new_order_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
          <div class="settings-sound-tile" data-sound-key="sound_order_cancelled_url">
            <div class="settings-sound-title">Отмена заказа</div>
            <div class="settings-sound-hint">Воспроизводится при отмене заказа</div>
            <div class="settings-sound-box" data-sound-box="sound_order_cancelled_url">
              <span class="settings-sound-label" data-sound-label="sound_order_cancelled_url">Файл не выбран</span>
              <button class="btn btn-icon btn-sm settings-sound-play hidden" type="button" title="Прослушать" data-sound-play="sound_order_cancelled_url" aria-label="Прослушать">
                <i class="fas fa-play"></i>
              </button>
            </div>
            <input class="hidden" type="file" accept="audio/*,.mp3,.wav,.ogg,.webm,.m4a,.aac" data-sound-input="sound_order_cancelled_url" />
            <input class="hidden" type="text" data-tenant-input="sound_order_cancelled_url" />
            <div class="settings-sound-actions">
              <button class="btn btn-icon btn-sm settings-sound-upload" type="button" title="Загрузить" data-sound-upload="sound_order_cancelled_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-sound-delete" type="button" title="Удалить" data-sound-delete="sound_order_cancelled_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
          <div class="settings-sound-tile" data-sound-key="sound_new_message_url">
            <div class="settings-sound-title">Новое сообщение</div>
            <div class="settings-sound-hint">Воспроизводится при появлении нового сообщения</div>
            <div class="settings-sound-box" data-sound-box="sound_new_message_url">
              <span class="settings-sound-label" data-sound-label="sound_new_message_url">Файл не выбран</span>
              <button class="btn btn-icon btn-sm settings-sound-play hidden" type="button" title="Прослушать" data-sound-play="sound_new_message_url" aria-label="Прослушать">
                <i class="fas fa-play"></i>
              </button>
            </div>
            <input class="hidden" type="file" accept="audio/*,.mp3,.wav,.ogg,.webm,.m4a,.aac" data-sound-input="sound_new_message_url" />
            <input class="hidden" type="text" data-tenant-input="sound_new_message_url" />
            <div class="settings-sound-actions">
              <button class="btn btn-icon btn-sm settings-sound-upload" type="button" title="Загрузить" data-sound-upload="sound_new_message_url">
                <i class="fas fa-upload"></i>
              </button>
              <button class="btn btn-icon btn-sm settings-sound-delete" type="button" title="Удалить" data-sound-delete="sound_new_message_url">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsPrintApiPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">API для печати на удалённом принтере</div>
          <div class="settings-list-subtitle">Выберите филиал, сгенерируйте токен и скопируйте URL для бота.</div>
        </div>
        <div class="settings-site-form">
          <div class="settings-site-field">
            <label class="field-label">ФИЛИАЛ</label>
            <select class="control" id="settingsPrintApiStore"></select>
          </div>
          <div class="settings-site-field">
            <label class="field-label">URL ДЛЯ БОТА</label>
            <input class="control" type="text" id="settingsPrintApiUrl" readonly />
            <button class="btn btn-link btn-sm" type="button" id="settingsPrintApiCopyUrl">Скопировать URL</button>
          </div>
          <div class="settings-site-field">
            <label class="field-label">ТОКЕН (X-Api-Key)</label>
            <input class="control" type="text" id="settingsPrintApiToken" readonly />
            <button class="btn btn-link btn-sm" type="button" id="settingsPrintApiCopyToken">Скопировать токен</button>
            <div class="field-hint">Передавайте токен в заголовке X-Api-Key</div>
          </div>
        </div>
        <div class="stores-form-actions">
          <button class="btn btn-primary btn-sm" type="button" id="settingsPrintApiGenerateBtn">Сгенерировать токен</button>
        </div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsOrderStatusesPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Этапы заказов</div>
          <div class="settings-list-subtitle">Перетащите строку, чтобы изменить порядок.</div>
        </div>
        <div class="settings-list" data-settings-list="order-statuses"></div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsOrderPaymentsPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Способы оплаты</div>
          <div class="settings-list-subtitle">Перетащите строку, чтобы изменить порядок.</div>
        </div>
        <div class="settings-site-form">
          <div class="settings-site-field">
            <label class="field-label">ОКРУГЛЕНИЕ СУММЫ</label>
            <select class="control" id="settingsPriceRoundingMode" data-tenant-input="price_rounding_mode" data-rounding-input="mode">
              <option value="none">Не округлять</option>
              <option value="down">В меньшую сторону</option>
              <option value="up">В большую сторону</option>
              <option value="nearest">До ближайшего</option>
            </select>
          </div>
          <div class="settings-site-field">
            <label class="field-label">ТОЧНОСТЬ</label>
            <select class="control" id="settingsPriceRoundingPrecision" data-tenant-input="price_rounding_precision" data-rounding-input="precision">
              <option value="2">До копеек</option>
              <option value="0">До рубля</option>
            </select>
          </div>
        </div>
        <div class="settings-list" data-settings-list="order-payments"></div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsOrderDeliveryPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Способы получения</div>
          <div class="settings-list-subtitle">Перетащите строку, чтобы изменить порядок.</div>
        </div>
        <div class="settings-list" data-settings-list="order-delivery"></div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsOrderTimeOptionsPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Интервалы времени</div>
          <div class="settings-list-subtitle">Перетащите строку, чтобы изменить порядок.</div>
        </div>
        <div class="settings-list" data-settings-list="order-time-options"></div>
      </div>

      <div class="info-card hidden" id="settingsDeliveryEmpty">
        <div class="info-title">Настройки доставки</div>
        <div class="info-text">Выберите настройку слева или создайте новую.</div>
      </div>

      <div class="info-card settings-right-panel hidden" id="settingsDeliveryPanel">
        <div class="settings-list-header">
          <div class="settings-list-title">Настройка доставки</div>
          <div class="settings-list-subtitle" id="settingsDeliverySubtitle">—</div>
        </div>
        <form class="settings-site-form" id="settingsDeliveryForm">
          <div class="settings-site-field">
            <label class="field-label">НАЗВАНИЕ</label>
            <input class="control" type="text" id="settingsDeliveryName" placeholder="Например: Доставка по городу" required />
          </div>
          <div class="settings-site-field">
            <label class="field-label">СТОИМОСТЬ ДОСТАВКИ</label>
            <input class="control" type="number" id="settingsDeliveryCost" placeholder="0" min="0" step="1" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">МИНИМАЛЬНАЯ СУММА ЗАКАЗА</label>
            <input class="control" type="number" id="settingsDeliveryMinOrder" placeholder="0" min="0" step="1" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">БЕСПЛАТНАЯ ДОСТАВКА ОТ</label>
            <input class="control" type="number" id="settingsDeliveryFreeFrom" placeholder="Оставьте пустым, если нет" min="0" step="1" />
          </div>
          <div class="settings-site-field">
            <label class="field-label">ФИЛИАЛЫ</label>
            <div class="delivery-stores-list" id="deliveryStoresList"></div>
          </div>
          <div class="settings-site-field">
            <label class="field-label">ФИЛИАЛ ПО УМОЛЧАНИЮ ДЛЯ ДОСТАВКИ</label>
            <select class="control" id="settingsDeliveryDefaultStore">
              <option value="">— не выбран —</option>
            </select>
            <div class="muted field-hint">Заказы на доставку по этой настройке будут привязаны к выбранному филиалу</div>
          </div>
          <div class="settings-site-field">
            <label class="field-label">СТАТУС</label>
            <label class="switch">
              <input class="switch-input" type="checkbox" id="settingsDeliveryActive" checked />
              <span class="switch-ui" aria-hidden="true"></span>
              <span class="switch-text">Активна</span>
            </label>
          </div>
        </form>
        <div class="stores-form-actions">
          <button class="btn btn-primary btn-sm" type="button" id="settingsDeliverySaveBtn">
            <span id="settingsDeliverySaveText">Сохранить</span>
          </button>
          <button class="btn btn-link btn-sm" type="button" id="settingsDeliveryResetBtn">Сбросить</button>
          <button class="btn btn-danger btn-sm" type="button" id="settingsDeliveryDeleteBtn">Удалить</button>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Информация</div>
    </div>
    <div class="panel-body no-scrollbar">
      <p class="muted">Заглушка. Здесь потом будет информация.</p>
    </div>
  </div>
<% } %>
