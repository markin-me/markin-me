
<% if (activePage === 'settings') { %>
  <div class="panel settings-stage-panel">
    <div class="panel-header">
      <div class="panel-title">Настройки</div>
    </div>
    <div class="panel-body no-scrollbar">
      <div class="stage-list settings-stage-list">
        <button class="stage-item is-active" type="button" data-settings-section="tenant" data-rbac-node="settings.company">
          <span class="stage-icon"><i class="fas fa-store"></i></span>
          <span class="stage-text">
            <strong>Компания</strong>
          </span>
        </button>
        <button class="stage-item" type="button" data-settings-section="stores" data-rbac-node="settings.stores">
          <span class="stage-icon"><i class="fas fa-shop"></i></span>
          <span class="stage-text">
            <strong>Филиалы</strong>
          </span>
        </button>
        <button class="stage-item" type="button" data-settings-section="delivery" data-rbac-node="settings.delivery">
          <span class="stage-icon"><i class="fas fa-truck"></i></span>
          <span class="stage-text">
            <strong>Доставка</strong>
          </span>
        </button>
        <button class="stage-item" type="button" data-settings-section="site" data-rbac-node="settings.site">
          <span class="stage-icon"><i class="fas fa-globe"></i></span>
          <span class="stage-text">
            <strong>Сайт</strong>
          </span>
        </button>
        <button class="stage-item" type="button" data-settings-section="chats" data-rbac-node="settings.chat">
          <span class="stage-icon"><i class="fas fa-comments"></i></span>
          <span class="stage-text">
            <strong>Чат поддержки</strong>
          </span>
        </button>
        <button class="stage-item" type="button" data-settings-section="api" data-rbac-node="settings.api">
          <span class="stage-icon"><i class="fas fa-plug"></i></span>
          <span class="stage-text">
            <strong>API</strong>
          </span>
        </button>
        <button class="stage-item" type="button" data-settings-section="print-templates" data-rbac-node="settings.print_templates">
          <span class="stage-icon"><i class="fas fa-receipt"></i></span>
          <span class="stage-text">
            <strong>Шаблоны печати</strong>
          </span>
        </button>
        <button class="stage-item" type="button" data-settings-section="production-zones" data-rbac-node="settings.production_zones">
          <span class="stage-icon"><i class="fas fa-layer-group"></i></span>
          <span class="stage-text">
            <strong>Производственные зоны</strong>
          </span>
        </button>
        <button class="stage-item" type="button" data-settings-section="system" data-rbac-node="settings.system">
          <span class="stage-icon"><i class="fas fa-sliders-h"></i></span>
          <span class="stage-text">
            <strong>Системные</strong>
          </span>
        </button>
      </div>
    </div>
  </div>
<% } else if (activePage === 'team') { %>
  <div class="panel team-stage-panel">
    <div class="panel-header">
      <div class="panel-title">Команда</div>
    </div>
    <div class="panel-body no-scrollbar">
      <div class="stage-list team-stage-list">
        <button class="stage-item is-active" type="button" data-team-section="users" data-rbac-node="team.employees">
          <span class="stage-icon"><i class="fas fa-users"></i></span>
          <span class="stage-text"><strong>Сотрудники</strong></span>
        </button>
        <button class="stage-item" type="button" data-team-section="roles" data-rbac-node="team.roles">
          <span class="stage-icon"><i class="fas fa-user-shield"></i></span>
          <span class="stage-text"><strong>Роли и права</strong></span>
        </button>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Левая колонка</div>
    </div>
    <div class="panel-body no-scrollbar">
      <p class="muted">Заглушка. Здесь потом будет контент.</p>
    </div>
  </div>
<% } %>
