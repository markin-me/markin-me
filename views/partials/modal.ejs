<div class="modal-backdrop" id="appModalBackdrop" aria-hidden="true"></div>

<div class="app-modal" id="appModal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="app-modal-header">
    <div class="app-modal-title" id="appModalTitle">Модальное окно</div>
    <div class="app-modal-actions" id="appModalActions">
      <button class="btn btn-icon" id="appModalCloseBtn" type="button" aria-label="Закрыть">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>

  <div class="app-modal-body no-scrollbar" id="appModalBody"></div>

  <div class="app-modal-footer">
    <button class="btn" id="appModalCancelBtn" type="button">Отменить</button>
    <button class="btn btn-primary" id="appModalSaveBtn" type="button">Сохранить</button>
  </div>
</div>
