<div class="panel cash-filters-panel">
  <div class="panel-header">
    <div class="panel-title">Касса</div>
  </div>

  <div class="panel-body no-scrollbar">
    <div class="stage-list cash-stage-list" id="cashJournalFilters">
      <button class="stage-item is-active" type="button" data-cash-section="orders">
        <span class="stage-icon"><i class="fas fa-layer-group"></i></span>
        <span class="stage-text">
          <strong>Журнал заказов</strong>
          <small>Заказы и оплаты</small>
        </span>
      </button>
      <button class="stage-item" type="button" data-cash-section="money">
        <span class="stage-icon"><i class="fas fa-wallet"></i></span>
        <span class="stage-text">
          <strong>Движение денег</strong>
          <small>Приход и расход</small>
        </span>
      </button>
      <button class="stage-item" type="button" data-cash-section="expenses">
        <span class="stage-icon"><i class="fas fa-file-invoice-dollar"></i></span>
        <span class="stage-text">
          <strong>Документы расходов</strong>
          <small>Чеки и накладные</small>
        </span>
      </button>
    </div>
  </div>
</div>
