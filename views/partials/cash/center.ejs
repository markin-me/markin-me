<div class="center-stack">
  <div class="panel toolbar-island cash-toolbar">
    <div class="panel-header">
      <div class="panel-title">
        <i class="fas fa-cash-register"></i>
        <span id="cashSectionTitle">Журнал заказов</span>
      </div>
      <div class="toolbar-right">
        <div class="new-order-right-select-wrap cash-toolbar-filter" id="cashOrderFilterWrap">
          <button class="new-order-right-select-trigger cash-toolbar-filter-trigger" type="button" id="cashOrderFilterBtn" aria-haspopup="listbox" aria-expanded="false">
            <span class="cash-toolbar-filter-main">
              <i class="fas fa-filter"></i>
              <span id="cashOrderFilterLabel">Все</span>
            </span>
            <i class="fas fa-chevron-down"></i>
          </button>
          <div class="new-order-right-select-menu no-scrollbar" id="cashOrderFilterMenu" role="listbox" aria-label="Фильтр заказов">
            <button class="new-order-right-select-option is-selected" type="button" data-cash-order-filter="all">Все</button>
            <button class="new-order-right-select-option" type="button" data-cash-order-filter="paid">Оплачены</button>
            <button class="new-order-right-select-option" type="button" data-cash-order-filter="unpaid">Не оплачены</button>
          </div>
        </div>

        <div class="date-filter" id="cashDateFilter">
          <button class="btn btn-ghost" type="button" id="cashDateBtn" aria-haspopup="dialog" aria-expanded="false">
            <i class="fas fa-calendar-day"></i>
            <span class="btn-text" id="cashDateLabel">Сегодня</span>
          </button>

          <div class="date-popover hidden" id="cashDatePopover" role="dialog" aria-label="Фильтр даты">
            <div class="date-popover-header">
              <button class="icon-btn btn-xs" id="cashDatePrev" type="button" aria-label="Предыдущий месяц">
                <i class="fas fa-chevron-left"></i>
              </button>
              <div class="date-popover-title" id="cashDateTitle"></div>
              <button class="icon-btn btn-xs" id="cashDateNext" type="button" aria-label="Следующий месяц">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>

            <div class="date-weekdays">
              <span>Пн</span>
              <span>Вт</span>
              <span>Ср</span>
              <span>Чт</span>
              <span>Пт</span>
              <span>Сб</span>
              <span>Вс</span>
            </div>
            <div class="date-grid" id="cashDateGrid"></div>

            <div class="date-popover-actions">
              <button class="btn btn-ghost btn-sm" id="cashDateReset" type="button">Сбросить</button>
            </div>
          </div>
        </div>

        <button class="btn btn-primary" type="button" id="cashAddBtn" aria-label="Добавить">
          <i class="fas fa-plus"></i>
        </button>
      </div>
    </div>
  </div>

  <div class="panel cash-center-panel">
    <div class="panel-body no-scrollbar">
      <div class="cash-summary-grid" id="cashSummaryCards"></div>
      <div class="cash-journal-list orders-list" id="cashJournalList"></div>
      <button class="btn btn-ghost hidden" type="button" id="cashLoadMoreBtn">Показать ещё</button>
      <div class="empty-hint hidden" id="cashJournalEmpty">Заказов пока нет</div>
    </div>
  </div>
</div>
