<div class="panel" id="shopCartPanel">
  <div class="panel-header shop-cart-header">
    <div class="shop-cart-header-left">
      <button class="btn btn-icon shop-cart-back hidden" id="shopCartBackBtn" type="button" aria-label="Назад">
        <i class="fas fa-arrow-left"></i>
      </button>
    </div>
    <div class="panel-title" id="shopCartHeaderTitle">Корзина</div>

    <div class="shop-cart-header-right">
      <button class="btn btn-icon shop-cart-fav hidden" id="shopCartFavBtn" type="button" aria-label="Избранное">
        <i class="far fa-heart"></i>
      </button>
      <button class="chip shop-address-chip chip-plus" id="shopAddressChip" type="button">Введите адрес</button>

      <div class="shop-profile-header-actions hidden" id="shopProfileHeaderActions">
        <button class="btn btn-icon shop-profile-settings" id="shopProfileSettingsBtn" type="button" aria-label="Настройки профиля">
          <i class="fas fa-gear"></i>
        </button>
        <button class="btn btn-icon shop-profile-close" id="shopProfileCloseBtn" type="button" aria-label="Закрыть профиль">
          <i class="fas fa-times"></i>
        </button>

        <div class="shop-profile-menu hidden" id="shopProfileMenu">
          <button class="shop-profile-menu-item" id="shopProfileEditBtn" type="button">Редактировать профиль</button>
          <button class="shop-profile-menu-item" id="shopProfileLogoutBtn" type="button">Выйти</button>
        </div>
      </div>
    </div>

    <div class="shop-cart-header-mode-wrap hidden" id="shopCartHeaderModeWrap">
      <div class="shop-delivery-toggle" id="shopAddressModeToggle">
        <button class="shop-delivery-toggle-btn is-active" id="shopAddressToggleDelivery" type="button" data-mode="delivery">Доставка</button>
        <button class="shop-delivery-toggle-btn" id="shopAddressTogglePickup" type="button" data-mode="pickup">Самовывоз</button>
      </div>
    </div>
  </div>

  <div class="panel-body no-scrollbar shop-cart-body">
    <div class="shop-cart" id="shopCartWrap">
      <!-- CART VIEW -->
      <div class="shop-cart-content" id="shopCartContent">
        <div class="shop-cart-empty" id="shopCartEmpty">
          <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-shopping-cart"></i></div>
            <div class="empty-title">Корзина пуста</div>
            <div class="empty-text">Добавьте товары из каталога</div>
          </div>
        </div>

        <div class="shop-cart-list" id="shopCartList"></div>
      </div>

      <!-- ADDRESS VIEW -->
      <div class="shop-address-content hidden" id="shopAddressContent">
        <!-- LIST -->
        <div class="shop-address-list-view hidden" id="shopAddressListView">
          <div class="shop-address-list-top">
            <div class="shop-address-list-title" id="shopAddressListTitle">Мои адреса</div>
            <button class="chip chip-plus" id="shopAddressNewBtn" type="button">
              <i class="fas fa-plus"></i> Новый адрес
            </button>
          </div>

          <div class="shop-address-list" id="shopAddressList"></div>
          <div class="shop-pickup-list-top hidden" id="shopPickupListTop">
            <div class="shop-pickup-list-title">Филиалы</div>
            <div class="shop-pickup-city-selector" id="shopPickupCitySelector">
              <button class="chip chip-city" id="shopPickupCityChip" type="button">
                <span class="chip-city-text">Все города</span>
                <i class="fas fa-chevron-down chip-city-arrow"></i>
              </button>
              <div class="chip-city-dropdown hidden" id="shopPickupCityDropdown"></div>
            </div>
          </div>
          <div class="shop-pickup-inline-list hidden" id="shopAddressPickupList"></div>

          <div class="shop-address-confirm-wrap" id="shopAddressConfirmWrap">
            <button class="shop-checkout-btn shop-address-confirm-btn" id="shopAddressConfirmBtn" type="button">Доставить сюда</button>
          </div>
        </div>

        <!-- FORM -->
        <div class="shop-address-form-view hidden" id="shopAddressFormView">
          <div class="shop-address-form-grid">
            <div class="shop-address-form-row shop-address-form-row--full">
              <label class="field-label">Город</label>
              <div class="custom-select" id="shopAddrCity">
                <button type="button" class="custom-select-trigger control">
                  <span class="custom-select-value"></span>
                  <i class="fas fa-chevron-down custom-select-arrow" aria-hidden="true"></i>
                </button>
                <div class="custom-select-dropdown hidden"></div>
              </div>
            </div>
            <div class="shop-address-form-row shop-address-form-row--full">
              <label class="field-label" for="shopAddrStreet">Улица</label>
              <input class="control" id="shopAddrStreet" type="text" />
            </div>

            <div class="shop-address-form-row shop-address-form-row--grid">
              <div class="shop-address-form-field">
                <label class="field-label" for="shopAddrHouse">Дом</label>
                <input class="control" id="shopAddrHouse" type="text" />
              </div>
              <div class="shop-address-form-field">
                <label class="field-label" for="shopAddrEntrance">Подъезд</label>
                <input class="control" id="shopAddrEntrance" type="text" />
              </div>
              <div class="shop-address-form-field">
                <label class="field-label" for="shopAddrFloor">Этаж</label>
                <input class="control" id="shopAddrFloor" type="text" />
              </div>
              <div class="shop-address-form-field">
                <label class="field-label" for="shopAddrApartment">Квартира</label>
                <input class="control" id="shopAddrApartment" type="text" />
              </div>
            </div>

            <div class="shop-address-form-row shop-address-form-row--full">
              <label class="field-label" for="shopAddrComment">Комментарий курьеру</label>
              <input class="control" id="shopAddrComment" type="text" />
            </div>
          </div>

          <div class="shop-address-form-actions">
            <button class="btn btn-primary" id="shopAddressSaveBtn" type="button">Сохранить</button>
            <button class="btn" id="shopAddressCancelBtn" type="button">Отмена</button>
          </div>
        </div>
      </div>

      <!-- PICKUP STORE VIEW -->
      <div class="shop-pickup-content hidden" id="shopPickupContent">
        <div class="shop-pickup-list-view" id="shopPickupListView">
          <div class="shop-pickup-list" id="shopPickupList"></div>
        </div>
      </div>

      <div class="shop-checkout-content hidden" id="shopCheckoutContent"></div>

      <div class="shop-profile-content hidden" id="shopProfileContent"></div>

      <div class="shop-product-content hidden" id="shopProductContent"></div>

      <!-- Шкала доставки (десктоп): над футером корзины, логика как на мобилке -->
      <div class="shop-cart-delivery-progress hidden" id="shopCartDeliveryProgress">
        <div class="shop-cart-delivery-progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
          <div class="shop-cart-delivery-progress-fill" id="shopCartDeliveryProgressFill"></div>
        </div>
        <div class="shop-cart-delivery-progress-label" id="shopCartDeliveryProgressLabel"></div>
      </div>

      <div class="shop-cart-footer hidden" id="shopCartFooter">
        <div class="shop-cart-footer-actions" id="shopCartFooterActions">
          <button class="shop-cart-clear" id="shopCartClearBtn" type="button" title="Очистить корзину" aria-label="Очистить корзину">×</button>
          <button class="shop-checkout-btn" id="shopCheckoutBtn" type="button">
            Оформить <span class="shop-checkout-total" id="shopCartTotal">0 ₽</span>
          </button>
        </div>

        <div class="shop-checkout-footer-actions hidden" id="shopCheckoutFooterActions">
          <button class="shop-checkout-back" id="shopCheckoutBackBtn" type="button" aria-label="Назад в корзину" title="Назад в корзину">
            <i class="fas fa-arrow-left"></i>
          </button>
          <button class="shop-checkout-submit-btn" id="shopCheckoutSubmitBtn" type="button">Заказать</button>
        </div>
      </div>
    </div>
  </div>
</div>
