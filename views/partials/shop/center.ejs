<div class="center-stack">
  <div class="panel">
    <section class="shop-catalog-delivery-widget" id="shopCatalogDeliveryWidget" aria-label="Способ получения">
      <div class="shop-catalog-delivery-widget__modes">
        <button class="shop-catalog-delivery-widget__mode is-active" type="button" data-mode="delivery">
          <span class="shop-catalog-delivery-widget__icon" data-role="delivery-icon">
            <i class="fas fa-truck" aria-hidden="true"></i>
          </span>
          <span class="shop-catalog-delivery-widget__text">
            <span class="shop-catalog-delivery-widget__title" data-role="delivery-title">Доставка</span>
            <span class="shop-catalog-delivery-widget__meta" data-role="delivery-hours"></span>
          </span>
        </button>
        <button class="shop-catalog-delivery-widget__mode" type="button" data-mode="pickup">
          <span class="shop-catalog-delivery-widget__icon" data-role="pickup-icon">
            <i class="fas fa-store" aria-hidden="true"></i>
          </span>
          <span class="shop-catalog-delivery-widget__text">
            <span class="shop-catalog-delivery-widget__title" data-role="pickup-title">Самовывоз</span>
            <span class="shop-catalog-delivery-widget__meta" data-role="pickup-hours"></span>
          </span>
        </button>
      </div>
      <button class="shop-catalog-delivery-widget__address" type="button" data-role="address">
        <i class="fas fa-location-dot shop-catalog-delivery-widget__address-icon" aria-hidden="true"></i>
        <span class="shop-catalog-delivery-widget__address-text" data-role="address-text">Укажите адрес доставки</span>
        <i class="fas fa-chevron-right shop-catalog-delivery-widget__address-arrow" aria-hidden="true"></i>
      </button>
    </section>

    <div class="toolbar">
      <div class="toolbar-title">
        <i class="fas fa-utensils"></i>
        <span id="shopToolbarTitle">Все товары</span>
        <span class="toolbar-status hidden" id="shopToolbarStatus"></span>
      </div>
      <div class="shop-cat-chips-wrap hidden" id="shopCatChipsWrap">
        <button
          class="shop-cat-chip shop-cat-chip--sheet-trigger"
          id="shopCatSheetTriggerBtn"
          type="button"
          aria-label="Категории"
          title="Категории"
        >
          <i class="fas fa-list" aria-hidden="true"></i>
        </button>
        <div class="shop-cat-chips" id="shopCatChips"></div>
      </div>

      <div class="toolbar-right">
        <button class="btn btn-icon shop-toolbar-cart" id="shopOpenCartBtn" type="button" title="Корзина" aria-label="Корзина">
          <i class="fas fa-shopping-cart"></i>
        </button>
      </div>
    </div>
    <section class="shop-catalog-promo-block hidden" id="shopCatalogPromoBlock" aria-label="Активные заказы и баннеры"></section>
  </div>

  <div class="panel shop-products-panel">
    <div class="panel-body no-scrollbar">
      <div id="shopProductsGrid" class="shop-products-grid"></div>

      <div class="empty-state hidden" id="shopEmptyState">
        <div class="empty-icon"><i class="fas fa-box-open"></i></div>
        <div class="empty-title">Пока нет товаров</div>
        <div class="empty-text">Добавьте товары в админке или выберите другую категорию</div>
      </div>
    </div>
  </div>

  <div class="panel shop-home-empty-panel" aria-hidden="true">
    <div class="panel-body">
      <div class="shop-home-bonus-card hidden" id="shopHomeBonusCard"></div>
    </div>
  </div>
</div>
