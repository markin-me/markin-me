<div class="shop-company-chat-overlay" id="shopCompanyChatOverlay" aria-hidden="true" hidden>
  <section class="shop-company-chat-modal" role="dialog" aria-modal="true" aria-labelledby="shopCompanyChatTitle">
    <header class="shop-company-chat-modal__header">
      <h2 class="shop-company-chat-modal__title" id="shopCompanyChatTitle">Добро пожаловать в чат!</h2>
      <button class="shop-company-chat-modal__close" id="shopCompanyChatCloseBtn" type="button" aria-label="Закрыть чат">
        <i class="fas fa-times"></i>
      </button>
    </header>

    <div class="shop-company-chat-modal__body">
      <div class="shop-company-chat-feed" id="shopCompanyChatFeed" aria-live="polite">
        <div class="shop-company-chat-thread" id="shopCompanyChatThread"></div>
      </div>

      <button class="shop-company-chat-scroll-down hidden" id="shopCompanyChatScrollDownBtn" type="button" aria-label="К последним сообщениям">
        <i class="fas fa-chevron-down"></i>
        <span class="shop-company-chat-scroll-down-badge hidden" id="shopCompanyChatScrollDownBadge" aria-live="polite" aria-atomic="true"></span>
      </button>

      <div class="shop-company-chat-reaction-bar hidden" id="shopCompanyChatReactionBar" role="group" aria-label="Реакции">
        <button type="button" class="shop-company-chat-reaction-btn" data-reaction-slot="quick" data-reaction="🥰">🥰</button>
        <button type="button" class="shop-company-chat-reaction-btn" data-reaction-slot="quick" data-reaction="👍">👍</button>
        <button type="button" class="shop-company-chat-reaction-btn" data-reaction-slot="quick" data-reaction="🔥">🔥</button>
        <button type="button" class="shop-company-chat-reaction-btn" data-reaction-slot="quick" data-reaction="❤️">❤️</button>
        <button type="button" class="shop-company-chat-reaction-btn" data-reaction-slot="quick" data-reaction="👎">👎</button>
        <button type="button" class="shop-company-chat-reaction-btn" data-reaction-slot="quick" data-reaction="👏">👏</button>
        <button type="button" class="shop-company-chat-reaction-btn" data-reaction-slot="quick" data-reaction="😃">😃</button>

        <button type="button" class="shop-company-chat-reaction-btn shop-company-chat-reaction-extra" data-reaction-slot="extra" data-reaction="😢">😢</button>
        <button type="button" class="shop-company-chat-reaction-btn shop-company-chat-reaction-extra" data-reaction-slot="extra" data-reaction="😕">😕</button>
        <button type="button" class="shop-company-chat-reaction-btn shop-company-chat-reaction-extra" data-reaction-slot="extra" data-reaction="😞">😞</button>
        <button type="button" class="shop-company-chat-reaction-btn shop-company-chat-reaction-extra" data-reaction-slot="extra" data-reaction="😟">😟</button>
        <button type="button" class="shop-company-chat-reaction-btn shop-company-chat-reaction-extra" data-reaction-slot="extra" data-reaction="🙁">🙁</button>
        <button type="button" class="shop-company-chat-reaction-btn shop-company-chat-reaction-extra" data-reaction-slot="extra" data-reaction="😮">😮</button>

        <button type="button" class="shop-company-chat-reaction-close shop-company-chat-reaction-more" data-reaction="__toggle_more__" aria-label="Показать ещё реакции" aria-expanded="false">
          <i class="fas fa-chevron-down"></i>
        </button>
      </div>

      <form class="shop-company-chat-composer" id="shopCompanyChatComposer">
        <input id="shopCompanyChatAttachmentInput" type="file" class="hidden" accept="image/*" multiple />
        <button class="shop-company-chat-composer__btn" id="shopCompanyChatAttachBtn" type="button" aria-label="Прикрепить">
          <i class="fas fa-paperclip"></i>
        </button>
        <textarea
          class="shop-company-chat-composer__input"
          id="shopCompanyChatInput"
          autocomplete="off"
          placeholder="Введите сообщение"
          rows="1"
          wrap="soft"
        ></textarea>

        <div class="shop-company-chat-emoji-wrap">
          <button class="shop-company-chat-composer__btn" id="shopCompanyChatEmojiBtn" type="button" aria-label="Эмодзи">
            <i class="far fa-smile"></i>
          </button>
          <div class="shop-company-chat-emoji-popover hidden" id="shopCompanyChatEmojiPopover"></div>
        </div>

        <button class="shop-company-chat-composer__btn shop-company-chat-composer__btn--send" type="submit" aria-label="Отправить">
          <i class="fas fa-paper-plane"></i>
        </button>
      </form>

      <div class="shop-company-chat-selection-toolbar hidden" id="shopCompanyChatSelectionToolbar" aria-live="polite">
        <button class="shop-company-chat-selection-close" id="shopCompanyChatSelectionCloseBtn" type="button" aria-label="Отменить выбор" title="Отменить выбор">
          <i class="fas fa-times"></i>
        </button>
        <div class="shop-company-chat-selection-count" id="shopCompanyChatSelectionCount">Выбрано 0 сообщений</div>
        <div class="shop-company-chat-selection-actions">
          <button class="shop-company-chat-selection-action" id="shopCompanyChatSelectionCopyBtn" type="button" aria-label="Скопировать" title="Скопировать">
            <i class="far fa-copy"></i>
          </button>
          <button class="shop-company-chat-selection-action is-danger" id="shopCompanyChatSelectionDeleteBtn" type="button" aria-label="Удалить" title="Удалить">
            <i class="far fa-trash-alt"></i>
          </button>
        </div>
      </div>
      <div class="chat-attach-preview-overlay hidden" id="shopCompanyChatAttachPreviewOverlay" aria-hidden="true">
        <div class="chat-attach-preview-card" role="dialog" aria-modal="true" aria-labelledby="shopCompanyChatAttachPreviewTitle">
          <div class="chat-attach-preview-head">
            <button type="button" class="chat-attach-preview-icon-btn" id="shopCompanyChatAttachPreviewCloseBtn" aria-label="Закрыть">
              <i class="fas fa-times"></i>
            </button>
            <div class="chat-attach-preview-title" id="shopCompanyChatAttachPreviewTitle">1 фотография</div>
          </div>

          <div class="chat-attach-preview-media-wrap">
            <img class="chat-attach-preview-image" id="shopCompanyChatAttachPreviewImage" alt="Предпросмотр изображения">
          </div>

          <div class="chat-attach-preview-thumbs hidden" id="shopCompanyChatAttachPreviewThumbs"></div>

          <div class="chat-attach-preview-foot">
            <button type="button" class="chat-attach-preview-icon-btn" id="shopCompanyChatAttachPreviewEmojiBtn" aria-label="Эмодзи">
              <i class="far fa-smile"></i>
            </button>
            <input
              type="text"
              class="chat-attach-preview-caption"
              id="shopCompanyChatAttachPreviewCaption"
              maxlength="2000"
              autocomplete="off"
              placeholder="Добавить подпись..."
            >
            <button type="button" class="chat-attach-preview-send" id="shopCompanyChatAttachPreviewSendBtn">Отправить</button>
          </div>
        </div>
      </div>

      <div class="chat-image-viewer-overlay hidden" id="shopCompanyChatImageViewerOverlay" aria-hidden="true">
        <div class="chat-image-viewer-card" role="dialog" aria-modal="true" aria-label="Image preview">
          <button type="button" class="chat-image-viewer-close" id="shopCompanyChatImageViewerCloseBtn" aria-label="Close image preview">
            <i class="fas fa-times"></i>
          </button>
          <img class="chat-image-viewer-image" id="shopCompanyChatImageViewerImage" alt="Image preview" />
        </div>
      </div>
    </div>
  </section>
</div>

