<section class="shop-details-page hidden" id="shopDetailsPage" aria-label="Карточка товара">
  <header class="shop-page-header shop-details-page-header">
    <button class="shop-page-header-btn" id="shopDetailsPageBackBtn" type="button" aria-label="Назад">
      <i class="fas fa-arrow-left" aria-hidden="true"></i>
    </button>
    <div class="shop-details-page-header-title" id="shopDetailsPageTitle"></div>
    <button class="shop-page-header-btn shop-details-page-favorite" id="shopDetailsPageFavoriteBtn" type="button" aria-label="В избранное">
      <i class="fas fa-heart" aria-hidden="true"></i>
    </button>
  </header>
  <div class="shop-product-content" id="shopDetailsPageContent"></div>
  <footer class="shop-page-footer shop-mobile-product-actions hidden" id="shopMobileProductActions">
    <div class="qty-pill-wrap" id="shopMobileQtyWrap"></div>
    <button class="shop-checkout-btn shop-pd-action" id="shopMobileAddToCartBtn" type="button">
      <span class="shop-pd-action-prices">
        <span class="shop-pd-action-old hidden" id="shopMobileProductOldPrice"></span>
        <span class="shop-checkout-total shop-pd-action-price" id="shopMobileProductPrice">0 ₽</span>
      </span>
      <span class="shop-pd-action-label" id="shopMobileProductLabel">в корзину</span>
    </button>
  </footer>
</section>
