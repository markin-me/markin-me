<div class="shop-mobile-bottom-container">
  <!-- Кнопки добавления в корзину (показываются только в карточке товара) -->
  <div class="shop-mobile-product-actions hidden" id="shopMobileProductActions">
    <div class="qty-pill-wrap" id="shopMobileQtyWrap"></div>
    <button class="shop-checkout-btn shop-pd-action" id="shopMobileAddToCartBtn" type="button">
      <span class="shop-pd-action-prices">
        <span class="shop-pd-action-old hidden" id="shopMobileProductOldPrice"></span>
        <span class="shop-checkout-total shop-pd-action-price" id="shopMobileProductPrice">0 ₽</span>
      </span>
      <span class="shop-pd-action-label" id="shopMobileProductLabel">в корзину</span>
    </button>
  </div>

  <!-- Кнопки корзины (Оформить/Заказать) - показываются в корзине -->
  <div class="shop-mobile-cart-actions hidden" id="shopMobileCartActions">
    <!-- Полоска прогресса до бесплатной доставки (в корзине) -->
    <div class="shop-mobile-delivery-progress-wrap hidden" id="shopMobileDeliveryProgressWrap">
      <div class="shop-mobile-delivery-progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
        <div class="shop-mobile-delivery-progress-fill" id="shopMobileDeliveryProgressFill"></div>
      </div>
      <div class="shop-mobile-delivery-progress-label" id="shopMobileDeliveryProgressLabel"></div>
    </div>
    <div class="shop-mobile-checkout-name-wrap hidden" id="shopMobileCheckoutNameWrap">
      <input
        class="control shop-checkout-name shop-mobile-checkout-name-input"
        id="shopMobileCheckoutNameInput"
        type="text"
        placeholder="Введите имя"
      />
    </div>
    <div class="shop-mobile-checkout-comment-wrap hidden" id="shopMobileCheckoutCommentWrap">
      <textarea
        class="control shop-checkout-comment shop-mobile-checkout-comment-input"
        id="shopMobileCheckoutCommentInput"
        placeholder="Введите комментарий к заказу"
        rows="1"
      ></textarea>
    </div>
    <div class="shop-mobile-cart-actions-cart hidden" id="shopMobileCartActionsCart">
      <button class="shop-cart-clear" id="shopMobileCartClearBtn" type="button" title="Очистить корзину" aria-label="Очистить корзину">×</button>
      <button class="shop-checkout-btn" id="shopMobileCheckoutBtn" type="button">
        Оформить · <span class="shop-checkout-total" id="shopMobileCartTotal">0 ₽</span>
      </button>
    </div>
    <div class="shop-mobile-cart-actions-checkout hidden" id="shopMobileCartActionsCheckout">
      <button class="shop-checkout-back" id="shopMobileCheckoutBackBtn" type="button" aria-label="Назад в корзину" title="Назад в корзину">
        <i class="fas fa-arrow-left"></i>
      </button>
      <button class="shop-checkout-submit-btn" id="shopMobileCheckoutSubmitBtn" type="button">Заказать</button>
    </div>
  </div>

  <!-- Ботомщит активного заказа (показывается когда есть активный заказ) -->
  <div class="shop-mobile-order-details-actions hidden" id="shopMobileOrderDetailsActions">
    <div class="shop-mobile-order-details-actions-row">
      <button class="shop-mobile-order-repeat-btn" id="shopMobileOrderRepeatBtn" type="button" aria-label="Повторить заказ">
        <i class="fas fa-rotate-right" aria-hidden="true"></i>
        <span class="shop-mobile-order-repeat-text">Повторить заказ</span>
      </button>
      <button class="shop-checkout-btn shop-mobile-order-total-btn" id="shopMobileOrderTotalBtn" type="button">
        <span class="shop-checkout-total" id="shopMobileOrderTotalValue">0 ₽</span>
      </button>
    </div>
  </div>

  <div class="shop-mobile-address-actions hidden" id="shopMobileAddressActions">
    <button class="shop-checkout-btn shop-mobile-address-save" id="shopMobileAddressSaveBtn" type="button">Сохранить</button>
    <button class="shop-mobile-address-cancel" id="shopMobileAddressCancelBtn" type="button">Отмена</button>
  </div>
  <div class="shop-mobile-address-confirm hidden" id="shopMobileAddressConfirm">
    <button class="shop-checkout-btn shop-mobile-address-confirm-btn" id="shopMobileAddressConfirmBtn" type="button">Доставить сюда</button>
  </div>
  <div class="shop-active-orders-sheet-collapsed hidden" id="shopActiveOrdersSheetCollapsed">
    <div class="shop-active-orders-handle"></div>
    <div class="shop-active-orders-collapsed-content">
      <span class="shop-active-orders-text">Активный заказ</span>
      <span class="shop-active-orders-count"></span>
    </div>
  </div>

  <!-- Навигация (всегда видна) -->
  <nav class="shop-nav" aria-label="Навигация">
    <button class="shop-nav-btn is-active" id="shopNavMenu" type="button" data-tab="menu" aria-label="Главная">
      <i class="fas fa-house"></i>
    </button>

    <button class="shop-nav-btn" id="shopNavCategories" type="button" data-tab="categories" aria-label="Категории">
      <i class="fas fa-list"></i>
    </button>

    <button class="shop-nav-btn" id="shopNavCart" type="button" data-tab="cart" aria-label="Корзина">
      <i class="fas fa-shopping-cart"></i>
      <span class="shop-nav-badge hidden" id="shopNavCartBadge">0</span>
    </button>

    <button class="shop-nav-btn" id="shopNavFav" type="button" data-tab="fav" aria-label="Избранное">
      <i class="far fa-heart"></i>
    </button>

    <button class="shop-nav-btn" id="shopNavProfile" type="button" data-tab="profile" aria-label="Профиль">
      <i class="fas fa-user"></i>
    </button>
  </nav>
</div>
