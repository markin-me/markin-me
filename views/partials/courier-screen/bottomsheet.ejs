<div class="sheet-backdrop" id="sheetBackdrop" aria-hidden="true"></div>

<section class="sheet" id="orderSheet" aria-hidden="true">
  <div class="sheet-header">
    <div class="sheet-title">Информация</div>
    <button class="icon-btn sheet-close" id="sheetClose" type="button" aria-label="Закрыть">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <div class="sheet-body no-scrollbar" id="orderSheetInfoRoot">
    <%- include('../orders/info_content') %>
  </div>

  <div class="order-info-footer hidden" id="sheetOrderInfoFooter" data-role="order-info-footer">
    <div class="order-footer-actions">
      <button
        class="order-footer-status-pill order-payment-pill"
        type="button"
        data-action="order-mark-paid"
        data-role="order-info-payment-btn"
        aria-label="Оплата заказа"
      >
        <span>Принять оплату</span>
      </button>
      <button class="order-footer-status-pill" type="button" data-action="order-status-next" aria-label="Статус заказа">
        <span data-info="order-status">—</span>
      </button>
      <div class="order-head-actions order-footer-icon-actions">
        <button class="icon-btn order-footer-icon-btn" type="button" data-action="order-edit" aria-label="Редактировать">
          <i class="fas fa-pen"></i>
        </button>
        <button class="icon-btn order-footer-icon-btn" type="button" data-action="order-print" aria-label="Печать">
          <i class="fas fa-print"></i>
        </button>
      </div>
    </div>
  </div>
</section>
