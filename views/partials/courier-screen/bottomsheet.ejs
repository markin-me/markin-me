<div class="sheet-backdrop" id="sheetBackdrop" aria-hidden="true"></div>

<section class="sheet" id="orderSheet" aria-hidden="true">
  <div class="sheet-header">
    <div class="sheet-title">&#x418;&#x43D;&#x444;&#x43E;&#x440;&#x43C;&#x430;&#x446;&#x438;&#x44F;</div>
    <button class="icon-btn sheet-close" id="sheetClose" type="button" aria-label="&#x417;&#x430;&#x43A;&#x440;&#x44B;&#x442;&#x44C;">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <div class="sheet-body no-scrollbar" id="orderSheetInfoRoot">
    <%- include('../orders/info_content') %>
  </div>

  <div class="order-info-footer order-info-footer--payment-only hidden" id="sheetOrderInfoFooter" data-role="order-info-footer">
    <div class="order-footer-actions order-footer-actions--payment-only">
      <button
        class="order-footer-status-pill order-payment-pill"
        type="button"
        data-action="order-mark-paid"
        data-role="order-info-payment-btn"
        aria-label="&#x41E;&#x43F;&#x43B;&#x430;&#x442;&#x430; &#x437;&#x430;&#x43A;&#x430;&#x437;&#x430;"
      >
        <span>&#x41F;&#x440;&#x438;&#x43D;&#x44F;&#x442;&#x44C; &#x43E;&#x43F;&#x43B;&#x430;&#x442;&#x443;</span>
      </button>
    </div>
  </div>
</section>
