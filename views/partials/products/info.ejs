                <input class="control" id="optionGroupSortOrder" name="sort_order" type="number" min="0" value="0" />
              </div>
            </div>

            <!-- ✅ Свитчи как отдельная "нижняя строка" секции -->
            <div class="form-row-2 option-group-switches">
              <label class="switch">
                <input class="switch-input" type="checkbox" id="optionGroupIsActive" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-text">Активна</span>
              </label>

              <label class="switch" id="optionGroupIsRequiredWrap">
                <input class="switch-input" type="checkbox" id="optionGroupIsRequired" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-text">Обязательная</span>
              </label>

              <label class="switch" id="optionGroupAllowVariantsWrap">
                <input class="switch-input" type="checkbox" id="optionGroupAllowVariants" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-text">Варианты у пунктов</span>
              </label>

              <label class="switch" id="optionGroupOutOfStockActionWrap">
                <input class="switch-input" type="checkbox" id="optionGroupOutOfStockAction" />
                <span class="switch-ui" aria-hidden="true"></span>
                <span class="switch-text">Скрывать опцию, если нет товаров</span>
              </label>
            </div>
          </div>
        </form>

        <div class="info-card info-accordion">
          <div class="acc-item">
            <div class="acc-header">
              <button class="stage-item acc-trigger" type="button" data-acc-trigger>
