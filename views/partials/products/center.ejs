<div class="center-stack">
  <div class="panel toolbar-island">
    <div class="toolbar products-main-toolbar">
      <label class="products-bulk-toggle-all products-header-selection hidden" aria-label="Выделить все товары в текущей группе">
      <input class="products-bulk-toggle-all-input" type="checkbox" id="productsBulkToggleAllInput" />
      <span class="products-bulk-toggle-all-box" aria-hidden="true"></span>
      </label>
      <div class="toolbar-title">
        <i class="fas fa-box" id="productsToolbarIcon"></i>
        <span id="productsToolbarText">Товары</span>
      </div>

      <div class="toolbar-right products-toolbar-controls" id="productsToolbarControls">
        <div class="products-catalog-compact-status" id="productsCatalogStatus" aria-live="polite">
          <div class="products-catalog-status-line">
            <span class="products-catalog-status-icon is-syncing" id="productsCatalogConnection" role="img" title="Синхронизация" aria-label="Синхронизация">
              <i class="fas fa-circle-notch" aria-hidden="true"></i>
            </span>
            <span class="products-catalog-count" id="productsCatalogCoverage">0/—</span>
            <div class="products-catalog-menu-wrap">
              <button class="products-catalog-menu-button" id="productsCatalogMenuButton" type="button" aria-label="Действия с локальным каталогом" title="Действия с локальным каталогом" aria-haspopup="menu" aria-expanded="false">
                <i class="fas fa-ellipsis-h" aria-hidden="true"></i>
              </button>
              <div class="products-catalog-menu hidden" id="productsCatalogMenu" role="menu">
                <button type="button" class="products-catalog-menu-item" id="productsCatalogDownloadBtn" data-catalog-action="download" role="menuitem">
                  <i class="fas fa-download" aria-hidden="true"></i><span>Загрузить все</span>
                </button>
                <button type="button" class="products-catalog-menu-item" id="productsCatalogSyncBtn" data-catalog-action="sync" role="menuitem">
                  <i class="fas fa-sync-alt" aria-hidden="true"></i><span>Синхронизировать</span>
                </button>
                <button type="button" class="products-catalog-menu-item is-danger" id="productsCatalogClearBtn" data-catalog-action="clear" role="menuitem">
                  <i class="fas fa-times" aria-hidden="true"></i><span>Очистить сохранённое</span>
                </button>
              </div>
            </div>
          </div>
          <div class="products-catalog-progress hidden" id="productsCatalogCoverageTrack" aria-hidden="true">
            <span id="productsCatalogCoverageBar"></span>
          </div>
        </div>

        <div class="cl-search-wrap hidden" id="productsSearchWrap">
          <input
            id="productsSearchInput"
            class="cl-search-input"
            type="text"
            placeholder="Поиск..."
            autocomplete="off"
          />
          <button id="productsSearchToggle" class="icon-btn cl-search-toggle" type="button" aria-label="Поиск" title="Поиск">
            <i class="fas fa-search"></i>
          </button>
        </div>

        <div class="cl-sort-wrap hidden" id="productsFilterWrap">
          <button id="productsFilterToggle" class="icon-btn" type="button" aria-label="Фильтр" title="Фильтр">
            <i class="fas fa-filter"></i>
          </button>
          <div class="cl-sort-dropdown hidden products-filter-dropdown" id="productsFilterDropdown" role="menu" aria-label="Фильтр"></div>
        </div>

        <div class="add-main-wrapper" id="addMainWrapper">
        <button class="btn btn-icon btn-primary" id="addMainBtn" type="button" title="Создать">
          <i class="fas fa-plus"></i>
        </button>
        <div class="add-main-dropdown hidden" id="addMainDropdown" role="menu" aria-label="Создать">
          <button type="button" class="add-main-dropdown-item" data-add-action="product" role="menuitem">
            <i class="fas fa-box"></i>
            <span>Товар</span>
          </button>
          <div class="add-main-dropdown-sep" aria-hidden="true"></div>
          <button type="button" class="add-main-dropdown-item" data-add-action="combo" role="menuitem">
            <i class="fas fa-layer-group"></i>
            <span>Комбо-набор</span>
          </button>
          <button type="button" class="add-main-dropdown-item" data-add-action="subcategory" role="menuitem" disabled>
            <i class="fas fa-folder-plus"></i>
            <span>Подкатегория</span>
          </button>
        </div>
        </div>
      </div>
    <div class="products-bulk-toolbar hidden" id="productsBulkFooter">
      <div class="products-bulk-footer-actions">
        <div class="products-bulk-footer-count">

          <span>Выбрано: <b id="productsBulkSelectedCount">0</b></span>
        </div>
        <div class="products-bulk-actions" id="productsBulkActions">
          <div class="products-bulk-production-zone-control">
            <label class="products-bulk-production-zone-label" for="productsBulkProductionZoneId">Зона производства</label>
            <select class="control control-sm products-bulk-production-zone-select native-hidden" id="productsBulkProductionZoneId" aria-label="Зона производства">
              <option value="">-</option>
            </select>
            <div class="products-bulk-production-zone-select-wrap" id="productsBulkProductionZoneSelectWrap">
              <button class="products-bulk-production-zone-trigger" type="button" id="productsBulkProductionZoneTrigger" aria-haspopup="menu" aria-expanded="false">
                <span id="productsBulkProductionZoneTriggerText">-</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div class="products-bulk-production-zone-menu hidden" id="productsBulkProductionZoneMenu" role="menu" aria-label="Зона производства">
                <button type="button" class="products-bulk-production-zone-option" data-bulk-production-zone-id="" role="menuitem">-</button>
              </div>
            </div>
          </div>
          <div class="products-bulk-production-zone-control">
            <span class="products-bulk-production-zone-label">Режим продажи</span>
            <div class="products-bulk-production-zone-select-wrap" id="productsBulkSaleModeWrap">
              <button class="products-bulk-production-zone-trigger" type="button" id="productsBulkSaleModeTrigger" aria-label="Режим продажи" aria-haspopup="menu" aria-expanded="false"><span id="productsBulkSaleModeText">Не менять</span><i class="fas fa-chevron-down" aria-hidden="true"></i></button>
              <div class="products-bulk-production-zone-menu hidden" id="productsBulkSaleModeMenu" role="menu">
                <button class="products-bulk-production-zone-option" type="button" data-bulk-sale-mode="" role="menuitem">Не менять</button>
                <button class="products-bulk-production-zone-option" type="button" data-bulk-sale-mode="order" role="menuitem">Заказ</button>
                <button class="products-bulk-production-zone-option" type="button" data-bulk-sale-mode="preorder" role="menuitem">Предзаказ…</button>
              </div>
            </div>
          </div>
          <div class="products-bulk-category-control">
            <label class="products-bulk-category-label" for="productsBulkCategoryMode">Категории</label>
            <select class="control control-sm products-bulk-category-select native-hidden" id="productsBulkCategoryMode" aria-label="Категории">
              <option value="none">-</option>
              <option value="add">Добавить</option>
              <option value="remove">Удалить</option>
              <option value="replace">Переместить</option>
            </select>
            <div class="products-bulk-category-select-wrap" id="productsBulkCategorySelectWrap">
              <button class="products-bulk-category-trigger" type="button" id="productsBulkCategoryTrigger" aria-haspopup="menu" aria-expanded="false">
                <span id="productsBulkCategoryTriggerText">-</span>
                <i class="fas fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div class="products-bulk-category-menu hidden" id="productsBulkCategoryMenu" role="menu" aria-label="Категории">
                <button type="button" class="products-bulk-category-option" data-bulk-category-mode="none" role="menuitem">-</button>
                <button type="button" class="products-bulk-category-option" data-bulk-category-mode="add" role="menuitem">Добавить</button>
                <button type="button" class="products-bulk-category-option" data-bulk-category-mode="remove" role="menuitem">Удалить</button>
                <button type="button" class="products-bulk-category-option" data-bulk-category-mode="replace" role="menuitem">Переместить</button>
              </div>
            </div>
            <button class="btn btn-ghost icon-btn hidden" type="button" id="productsBulkCategoryPickerBtn" aria-label="Выбрать категории">+</button>
          </div>
          <div class="products-bulk-menu-wrap" id="productsBulkMenuWrap">
            <button class="btn btn-ghost icon-btn" type="button" id="productsBulkMenuToggleBtn" aria-label="Действия">...</button>
            <div class="products-bulk-menu hidden" id="productsBulkMenu">
              <div class="products-bulk-switch" role="group" aria-label="Неактивные / Активные">
                <button type="button" data-bulk-choice="deactivate" aria-pressed="false">Неактивные</button>
                <button type="button" data-bulk-choice="" aria-pressed="true" title="Не менять" aria-label="Не менять">—</button>
                <button type="button" data-bulk-choice="activate" aria-pressed="false">Активные</button>
              </div>
              <div class="products-bulk-switch" role="group" aria-label="Скрытые / Видимые">
                <button type="button" data-bulk-choice="hide" aria-pressed="false">Скрытые</button>
                <button type="button" data-bulk-choice="" aria-pressed="true" title="Не менять" aria-label="Не менять">—</button>
                <button type="button" data-bulk-choice="show" aria-pressed="false">Видимые</button>
              </div>
              <div class="products-bulk-switch" role="group" aria-label="Обнулить / Бесконечный">
                <button type="button" data-bulk-choice="zero_stock" aria-pressed="false">Обнулить</button>
                <button type="button" data-bulk-choice="" aria-pressed="true" title="Не менять" aria-label="Не менять">—</button>
                <button type="button" data-bulk-choice="infinite_stock" aria-pressed="false">Бесконечный</button>
              </div>
              <div class="products-bulk-switch" role="group" aria-label="Готовый товар / По рецептуре">
                <button type="button" data-bulk-choice="fulfillment_stock" aria-pressed="false">Готовый товар</button>
                <button type="button" data-bulk-choice="" aria-pressed="true" title="Не менять" aria-label="Не менять">—</button>
                <button type="button" data-bulk-choice="fulfillment_made_to_order" aria-pressed="false">По рецептуре</button>
              </div>
            </div>
          </div>
          <button class="btn btn-ghost icon-btn" type="button" id="productsBulkCancelBtn" title="Отменить изменения и снять выбор" aria-label="Отменить изменения и снять выбор">✕</button>
          <button class="btn icon-btn" type="button" id="productsBulkApplyBtn" title="Применить действия" aria-label="Применить действия">✓</button>
        </div>
      </div>
    </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-body no-scrollbar">

      <div class="content-view" data-view-content="products">
        <div class="product-list-header" id="productListHeader" aria-hidden="true">
          <span></span><span>Товар</span><span>Учёт и списание</span><span>Остаток</span>
          <span>Цена</span><span>Старая цена</span><span>Себест.</span><span>Маржа, %</span><span>Скидка, %</span><span></span>
        </div>
        <div class="orders-list" id="productsList"></div>
        <div class="empty-hint" id="productsEmptyHint">Пока нет товаров...</div>
      </div>

      <div class="content-view hidden" data-view-content="categories">
        <div class="category-list-header" id="categoryListHeader" aria-hidden="true">
          <span></span>
          <span></span>
          <span>Активен</span>
          <span>На сайте</span>
          <span>При заказе</span>
          <span>В корзине</span>
        </div>
        <div class="orders-list" id="categoriesMainList"></div>
        <div class="empty-hint" id="categoriesEmptyHint">Пока нет категорий...</div>
      </div>

      <div class="content-view hidden" data-view-content="variants">
        <div class="options-list" id="variantsGroupsList"></div>
        <div class="empty-hint" id="variantsGroupsEmpty">Пока нет модификаций...</div>
      </div>
      <div class="content-view hidden" data-view-content="options">
        <div class="options-list" id="optionsGroupsList"></div>
        <div class="empty-hint" id="optionsGroupsEmpty">Пока нет опций...</div>
      </div>
      <div class="content-view hidden" data-view-content="badges">
        <div class="options-list" id="badgeDefinitionsList"></div>
      </div>
      <div class="content-view hidden" data-view-content="auto-add">
        <div class="options-list" id="autoAddGroupsList"></div>
        <div class="empty-hint" id="autoAddGroupsEmpty">Пока нет автодобавлений...</div>
      </div>
      
<div class="content-view hidden" data-view-content="units">
        <div class="options-list" id="unitsList"></div>
        <div class="empty-hint" id="unitsEmptyHint">Пока нет единиц измерения...</div>
      </div>
      <div class="content-view hidden" data-view-content="allergens"><div class="info-card">Аллергены...</div></div>
      <div class="content-view hidden" data-view-content="diets"><div class="info-card">Диеты...</div></div>
      <div class="content-view hidden" data-view-content="combo-blocks">
        <div class="options-list" id="comboBlocksList"></div>
        <div class="empty-hint" id="comboBlocksEmptyHint">Пока нет блоков. Нажмите «+» для создания.</div>
      </div>
      <div class="content-view hidden" data-view-content="stock-in">
        <div class="options-list" id="stockInList"></div>
        <div class="empty-hint" id="stockInEmpty">Нет документов прихода</div>
      </div>
      <div class="content-view hidden" data-view-content="stock-out">
        <div class="options-list" id="stockOutList"></div>
        <div class="empty-hint" id="stockOutEmpty">Нет документов списания</div>
      </div>
      <div class="content-view hidden" data-view-content="stock-movements">
        <div class="options-list" id="stockMovementsList"></div>
        <div class="empty-hint" id="stockMovementsEmpty">Нет движений</div>
      </div>
      <div class="content-view hidden" data-view-content="production-plan"><div class="info-card">План производства...</div></div>
      <div class="content-view hidden" data-view-content="production-history"><div class="info-card">История производства...</div></div>

    </div>

  </div>
</div>

<!-- Product editor -->
<template id="tplProductEditor">
  <form id="productEditorForm" class="form-grid" autocomplete="off">

    <div class="product-editor-top">
      <div>
        <div class="product-photo-main" id="pePhotoMainContainer">
          <div class="photo-main-wrapper">
            <img id="pePhotoMain" class="img-main hidden" alt="" />
            <div class="product-photo-placeholder" id="pePhotoPlaceholder">Нет фото<br><small>Перетащите файлы сюда</small></div>
            
            <!-- Стрелки навигации -->
            <button class="photo-nav-btn photo-nav-prev hidden" type="button" id="pePhotoPrev" aria-label="Предыдущее фото">
              <i class="fas fa-chevron-left"></i>
            </button>
            <button class="photo-nav-btn photo-nav-next hidden" type="button" id="pePhotoNext" aria-label="Следующее фото">
              <i class="fas fa-chevron-right"></i>
            </button>
            
            <!-- Точки-индикаторы -->
            <div class="photo-dots hidden" id="pePhotoDots"></div>
          </div>
        </div>

        <!-- миниатюры с прокруткой (JS рисует .img-thumb внутри) -->
        <div class="product-photo-thumbs-wrapper hidden">
          <button class="product-thumbs-nav product-thumbs-prev hidden" type="button" id="peThumbsPrev" aria-label="Листать миниатюры влево">
            <i class="fas fa-chevron-left"></i>
          </button>
          <div class="product-photo-thumbs img-thumbs" id="pePhotoThumbs"></div>
          <button class="product-thumbs-nav product-thumbs-next hidden" type="button" id="peThumbsNext" aria-label="Листать миниатюры вправо">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>

        <div class="product-photo-tools hidden">
          <input id="pePhotosInput" type="file" accept="image/*" multiple class="hidden" />
          <button class="btn" type="button" id="peAddPhotosBtn">
            <i class="fas fa-image"></i> Фото
          </button>
          <div class="muted" id="pePhotosCounter">0/10</div>
        </div>
      </div>

    </div>

    <section class="info-card product-editor-meta">
      <div class="kv-label">Данные товара</div>
      <div class="field-wrap">
        <label class="field-label" for="pe_name">Название *</label>
        <input class="control" id="pe_name" name="name" type="text" required />
      </div>
      <div>
        <span class="field-label">Категории</span>
        <div class="product-editor-category-links" id="peCategoryChips"></div>
      </div>
      <input id="pe_sku" name="sku" type="hidden" />
      <div class="form-row-2">
        <label class="switch">
          <input class="switch-input" type="checkbox" name="is_active" checked />
          <span class="switch-ui" aria-hidden="true"></span>
          <span class="switch-text">Активен</span>
        </label>

        <label class="switch">
          <input class="switch-input" type="checkbox" name="site_visibility" checked />
          <span class="switch-ui" aria-hidden="true"></span>
          <span class="switch-text">Показывать на сайте</span>
        </label>
      </div>
      <details class="product-data-description" id="peDescriptionAccordion">
        <summary>Описание <i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
        <label class="product-description-label" for="pe_desc_short">Короткое описание</label>
        <textarea class="textarea" id="pe_desc_short" name="description_short" rows="1"></textarea>
        <label class="product-description-label" for="pe_desc">Описание</label>
        <textarea class="textarea" id="pe_desc" name="description" rows="1"></textarea>
      </details>
    </section>

    <div class="product-nutrition-card product-price-card" id="pePriceBlock">
      <div class="product-nutrition-head">
        <div class="product-price-heading">
          <div class="kv-label">Цена</div>
          <button class="product-nutrition-warning product-price-variant-warning hidden" id="pePriceVariantWarning" type="button">!</button>
          <div class="product-price-source-summary" id="pePriceSourceHint">Ручной ввод</div>
        </div>
        <div class="product-price-config">
          <button class="btn btn-sm product-price-config-trigger" id="pePriceConfigTrigger" type="button" aria-expanded="false" aria-controls="pePriceConfigMenu">
            Расчёт цены <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
          <div class="product-footer-more-dropdown hidden" id="pePriceConfigMenu" role="group" aria-label="Источники цены">
            <label class="product-footer-more-dropdown-item product-price-config-choice">
              <span class="option-item-flag-control"><input class="product-row-select-input" type="checkbox" data-product-price-source="composition" /><span class="product-row-select-box" aria-hidden="true"></span></span>
              <span>Из состава</span>
            </label>
            <label class="product-footer-more-dropdown-item product-price-config-choice">
              <span class="option-item-flag-control"><input class="product-row-select-input" type="checkbox" data-product-price-source="variants" /><span class="product-row-select-box" aria-hidden="true"></span></span>
              <span>Из вариантов</span>
            </label>
            <label class="product-footer-more-dropdown-item product-price-config-choice">
              <span class="option-item-flag-control"><input class="product-row-select-input" type="checkbox" data-product-price-source="options" /><span class="product-row-select-box" aria-hidden="true"></span></span>
              <span>Из опций</span>
            </label>
            <label class="product-footer-more-dropdown-item product-price-config-choice">
              <span class="option-item-flag-control"><input class="product-row-select-input" type="checkbox" data-product-price-source="manual" /><span class="product-row-select-box" aria-hidden="true"></span></span>
              <span>Ручное</span>
            </label>
          </div>
        </div>
      </div>
      <div class="product-price-grid">
        <div class="field-wrap product-nutrition-field product-price-field">
          <label class="field-label" for="pe_price">Цена</label>
          <input class="control" id="pe_price" name="price" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
        <div class="field-wrap product-nutrition-field product-price-field">
          <label class="field-label" for="pe_old_price">Старая цена</label>
          <input class="control" id="pe_old_price" name="old_price" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="—" />
        </div>
        <div class="field-wrap product-nutrition-field product-price-field">
          <label class="field-label" for="pe_cost_price">Себест.</label>
          <input class="control" id="pe_cost_price" name="cost_price" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
        <div class="field-wrap product-nutrition-field product-price-field">
          <label class="field-label" for="pe_margin_percent">Маржа %</label>
          <input class="control" id="pe_margin_percent" name="margin_percent" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
        <div class="field-wrap product-nutrition-field product-price-field">
          <label class="field-label" for="pe_promo_discount_percent">Скидка, %</label>
          <input class="control" id="pe_promo_discount_percent" name="promo_discount_percent" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
      </div>
      <input class="hidden" id="pe_promo_enabled" name="promo_enabled" type="checkbox" />
      <input name="promo_title" type="hidden" />
    </div>

    <details class="info-card product-accounting-card">
      <summary>
        <span>Учёт и производство</span>
        <span class="field-wrap product-fulfillment-mode-field product-accounting-stock-field">
          <label class="field-label" for="pe_stock">Остаток</label>
          <span class="product-accounting-stock">
            <input class="control" id="pe_stock" name="stock" type="text" inputmode="decimal" autocomplete="off" data-numeric-input aria-describedby="peStockUnit" />
            <small id="peStockUnit"></small>
          </span>
        </span>
        <i class="fas fa-chevron-down" aria-hidden="true"></i>
      </summary>
      <div class="product-fulfillment-row">
    <div class="field-wrap product-fulfillment-mode-field">
      <label class="field-label" for="pe_fulfillment_mode">Учёт и списание</label>
      <select class="control hidden" id="pe_fulfillment_mode" name="fulfillment_mode">
        <option value="stock">Готовый товар</option>
        <option value="made_to_order">По рецептуре</option>
      </select>
      <div class="new-order-right-select-wrap settings-delivery-city-selector product-fulfillment-select" id="peFulfillmentModeWrap">
        <button class="new-order-right-select-trigger product-fulfillment-select-trigger" id="peFulfillmentModeTrigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Учёт и списание">
          <span id="peFulfillmentModeText">Готовый товар</span>
