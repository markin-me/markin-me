<div class="center-stack">
  <div class="panel toolbar-island">
    <div class="toolbar">
      <div class="toolbar-title">
        <i class="fas fa-box" id="productsToolbarIcon"></i>
        <span id="productsToolbarText">Товары</span>
      </div>

      <div class="toolbar-right products-toolbar-controls" id="productsToolbarControls">
        <div class="cl-search-wrap hidden" id="productsSearchWrap">
          <input
            id="productsSearchInput"
            class="cl-search-input"
            type="text"
            placeholder="Поиск..."
            autocomplete="off"
          />
          <button id="productsSearchToggle" class="icon-btn cl-search-toggle" type="button" aria-label="Поиск" title="Поиск">
            <i class="fas fa-search"></i>
          </button>
        </div>

        <div class="cl-sort-wrap hidden" id="productsFilterWrap">
          <button id="productsFilterToggle" class="icon-btn" type="button" aria-label="Фильтр" title="Фильтр">
            <i class="fas fa-filter"></i>
          </button>
          <div class="cl-sort-dropdown hidden products-filter-dropdown" id="productsFilterDropdown" role="menu" aria-label="Фильтр"></div>
        </div>

        <div class="add-main-wrapper" id="addMainWrapper">
        <button class="btn btn-icon btn-primary" id="addMainBtn" type="button" title="Создать">
          <i class="fas fa-plus"></i>
        </button>
        <div class="add-main-dropdown hidden" id="addMainDropdown" role="menu" aria-label="Создать">
          <button type="button" class="add-main-dropdown-item" data-add-action="product" role="menuitem">
            <i class="fas fa-box"></i>
            <span>Товар</span>
          </button>
          <div class="add-main-dropdown-sep" aria-hidden="true"></div>
          <button type="button" class="add-main-dropdown-item" data-add-action="combo" role="menuitem">
            <i class="fas fa-layer-group"></i>
            <span>Комбо-набор</span>
          </button>
        </div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-body no-scrollbar">

      <div class="content-view" data-view-content="products">
        <div class="product-list-header" id="productListHeader" aria-hidden="true">
          <span></span>
          <span></span>
          <span>Активен</span>
          <span>Видимость</span>
          <span>Режим продажи</span>
          <span>Остаток</span>
          <span>Себестоимость</span>
          <span>Цена</span>
          <span></span>
        </div>
        <div class="orders-list" id="productsList"></div>
        <div class="empty-hint" id="productsEmptyHint">Пока нет товаров...</div>
      </div>

      <div class="content-view hidden" data-view-content="categories">
        <div class="orders-list" id="categoriesMainList"></div>
        <div class="empty-hint" id="categoriesEmptyHint">Пока нет категорий...</div>
      </div>

      <div class="content-view hidden" data-view-content="variants">
        <div class="options-list" id="variantsGroupsList"></div>
        <div class="empty-hint" id="variantsGroupsEmpty">Пока нет модификаций...</div>
      </div>
      <div class="content-view hidden" data-view-content="options">
        <div class="options-list" id="optionsGroupsList"></div>
        <div class="empty-hint" id="optionsGroupsEmpty">Пока нет опций...</div>
      </div>
      <div class="content-view hidden" data-view-content="auto-add">
        <div class="options-list" id="autoAddGroupsList"></div>
        <div class="empty-hint" id="autoAddGroupsEmpty">Пока нет автодобавлений...</div>
      </div>
      
<div class="content-view hidden" data-view-content="units">
        <div class="options-list" id="unitsList"></div>
        <div class="empty-hint" id="unitsEmptyHint">Пока нет единиц измерения...</div>
      </div>
      <div class="content-view hidden" data-view-content="allergens"><div class="info-card">Аллергены...</div></div>
      <div class="content-view hidden" data-view-content="diets"><div class="info-card">Диеты...</div></div>
      <div class="content-view hidden" data-view-content="combo-blocks">
        <div class="options-list" id="comboBlocksList"></div>
        <div class="empty-hint" id="comboBlocksEmptyHint">Пока нет блоков. Нажмите «+» для создания.</div>
      </div>
      <div class="content-view hidden" data-view-content="stock-in">
        <div class="options-list" id="stockInList"></div>
        <div class="empty-hint" id="stockInEmpty">Нет документов прихода</div>
      </div>
      <div class="content-view hidden" data-view-content="stock-out">
        <div class="options-list" id="stockOutList"></div>
        <div class="empty-hint" id="stockOutEmpty">Нет документов списания</div>
      </div>
      <div class="content-view hidden" data-view-content="stock-movements">
        <div class="options-list" id="stockMovementsList"></div>
        <div class="empty-hint" id="stockMovementsEmpty">Нет движений</div>
      </div>
      <div class="content-view hidden" data-view-content="production-plan"><div class="info-card">План производства...</div></div>
      <div class="content-view hidden" data-view-content="production-history"><div class="info-card">История производства...</div></div>

    </div>
    <div class="panel-footer hidden" id="productsBulkFooter">
      <div class="products-bulk-footer-actions">
        <div class="products-bulk-footer-count">
          <label class="products-bulk-toggle-all" aria-label="Выделить все товары в текущей группе">
            <input class="products-bulk-toggle-all-input" type="checkbox" id="productsBulkToggleAllInput" />
            <span class="products-bulk-toggle-all-box" aria-hidden="true"></span>
          </label>
          <span>Выбрано: <b id="productsBulkSelectedCount">0</b></span>
        </div>
        <div class="products-bulk-actions" id="productsBulkActions">
          <span class="products-bulk-actions-count">Выбрано: <b id="productsBulkActionsSelectedCount">0</b></span>
          <div class="products-bulk-menu-wrap" id="productsBulkMenuWrap">
            <button class="btn btn-ghost icon-btn" type="button" id="productsBulkMenuToggleBtn" aria-label="Действия">...</button>
            <div class="products-bulk-menu hidden" id="productsBulkMenu">
              <label class="products-bulk-menu-item">
                <input type="checkbox" data-bulk-action="activate" />
                <span>Сделать активными</span>
              </label>
              <label class="products-bulk-menu-item">
                <input type="checkbox" data-bulk-action="deactivate" />
                <span>Сделать неактивными</span>
              </label>
              <label class="products-bulk-menu-item">
                <input type="checkbox" data-bulk-action="show" />
                <span>Сделать видимыми</span>
              </label>
              <label class="products-bulk-menu-item">
                <input type="checkbox" data-bulk-action="hide" />
                <span>Сделать невидимыми</span>
              </label>
              <label class="products-bulk-menu-item">
                <input type="checkbox" data-bulk-action="infinite_stock" />
                <span>Бесконечный остаток</span>
              </label>
              <label class="products-bulk-menu-item">
                <input type="checkbox" data-bulk-action="zero_stock" />
                <span>Обнулить остаток</span>
              </label>
              <label class="products-bulk-menu-item">
                <input type="checkbox" data-bulk-action="fulfillment_stock" />
                <span>Сделать Со склада</span>
              </label>
              <label class="products-bulk-menu-item">
                <input type="checkbox" data-bulk-action="fulfillment_made_to_order" />
                <span>Сделать Под заказ</span>
              </label>
            </div>
          </div>
          <button class="btn btn-ghost icon-btn" type="button" id="productsBulkCancelBtn" aria-label="Сбросить действия">✕</button>
          <button class="btn icon-btn" type="button" id="productsBulkApplyBtn" aria-label="Применить действия">✓</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Product editor -->
<template id="tplProductEditor">
  <form id="productEditorForm" class="form-grid" autocomplete="off">

    <!-- TOP: Фото 150x150 слева, справа основные поля -->
    <div class="product-editor-top">
      <div>
        <div class="product-photo-main" id="pePhotoMainContainer">
          <div class="photo-main-wrapper">
            <img id="pePhotoMain" class="img-main hidden" alt="" />
            <div class="product-photo-placeholder" id="pePhotoPlaceholder">Нет фото<br><small>Перетащите файлы сюда</small></div>
            
            <!-- Стрелки навигации -->
            <button class="photo-nav-btn photo-nav-prev hidden" type="button" id="pePhotoPrev" aria-label="Предыдущее фото">
              <i class="fas fa-chevron-left"></i>
            </button>
            <button class="photo-nav-btn photo-nav-next hidden" type="button" id="pePhotoNext" aria-label="Следующее фото">
              <i class="fas fa-chevron-right"></i>
            </button>
            
            <!-- Точки-индикаторы -->
            <div class="photo-dots hidden" id="pePhotoDots"></div>
          </div>
        </div>

        <!-- миниатюры с прокруткой (JS рисует .img-thumb внутри) -->
        <div class="product-photo-thumbs-wrapper hidden">
          <button class="product-thumbs-nav product-thumbs-prev hidden" type="button" id="peThumbsPrev" aria-label="Листать миниатюры влево">
            <i class="fas fa-chevron-left"></i>
          </button>
          <div class="product-photo-thumbs img-thumbs" id="pePhotoThumbs"></div>
          <button class="product-thumbs-nav product-thumbs-next hidden" type="button" id="peThumbsNext" aria-label="Листать миниатюры вправо">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>

        <div class="product-photo-tools hidden">
          <input id="pePhotosInput" type="file" accept="image/*" multiple class="hidden" />
          <button class="btn" type="button" id="peAddPhotosBtn">
            <i class="fas fa-image"></i> Фото
          </button>
          <div class="muted" id="pePhotosCounter">0/10</div>
        </div>
      </div>

      <div class="product-editor-meta">
        <div class="field-wrap">
          <label class="field-label" for="pe_name">Название *</label>
          <input class="control" id="pe_name" name="name" type="text" placeholder="Например: Бургер" required />
        </div>

        <div>
          <label class="field-label">Категории</label>
          <div class="chips" id="peCategoryChips"></div>
        </div>

        <div class="field-wrap">
          <label class="field-label" for="pe_sku">Артикул (SKU)</label>
          <input class="control" id="pe_sku" name="sku" type="text" placeholder="BRG-001" />
        </div>
      </div>
    </div>

    <div class="product-nutrition-card product-price-card" id="pePriceBlock">
      <div class="product-nutrition-head">
        <div>
          <div class="product-nutrition-title">Цена</div>
          <div class="product-nutrition-subtitle" id="pePriceSourceHint">Ручной ввод</div>
        </div>
        <div class="product-price-source-toggle" role="group" aria-label="Источник цены">
          <button class="product-price-source-btn" id="pePriceSourceAuto" type="button" data-price-source="auto">Из состава</button>
          <button class="product-price-source-btn" id="pePriceSourceManual" type="button" data-price-source="manual">Ручное</button>
        </div>
      </div>
      <div class="product-price-grid">
        <div class="field-wrap product-nutrition-field product-price-field">
          <label class="field-label" for="pe_cost_price">Себест.</label>
          <input class="control" id="pe_cost_price" name="cost_price" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
        <div class="field-wrap product-nutrition-field product-price-field">
          <label class="field-label" for="pe_margin_percent">Маржа %</label>
          <input class="control" id="pe_margin_percent" name="margin_percent" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
        <div class="field-wrap product-nutrition-field product-price-field">
          <label class="field-label" for="pe_price">Цена</label>
          <input class="control" id="pe_price" name="price" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
      </div>
    </div>
    <input id="pe_old_price" name="old_price" type="hidden" value="0" />

    <!-- Единицы в один ряд: Норма / Ед. изм / Остаток -->
    <div class="form-row-3">
      <div class="field-wrap">
        <label class="field-label" for="pe_base_qty">Норма</label>
        <input class="control" id="pe_base_qty" name="base_qty" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="1" />
      </div>
      <div class="field-wrap">
        <label class="field-label" for="pe_base_unit_id">Ед. изм</label>
        <select class="control" id="pe_base_unit_id" name="base_unit_id">
          <option value="">—</option>
        </select>
      </div>
      <div class="field-wrap">
        <label class="field-label" for="pe_stock">Остаток</label>
        <input class="control" id="pe_stock" name="stock" type="text" inputmode="decimal" autocomplete="off" data-numeric-input />
      </div>
    </div>

    <!-- Конвертер для штучных товаров: 1 штука = X [ед.] (показывается только при Ед. изм = Штука) -->
    <div class="form-row-pcs-converter hidden" id="pePcsToUnitWrap">
      <div class="field-wrap">
        <label class="field-label" for="pe_pcs_to_unit_factor">1 штука =</label>
        <input class="control" id="pe_pcs_to_unit_factor" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
      </div>
      <div class="field-wrap">
        <label class="field-label" for="pe_pcs_to_unit_id">Ед.</label>
        <select class="control" id="pe_pcs_to_unit_id">
          <option value="">—</option>
        </select>
      </div>
    </div>

    <div class="form-row-2">
      <label class="switch">
        <input class="switch-input" type="checkbox" name="is_active" checked />
        <span class="switch-ui" aria-hidden="true"></span>
        <span class="switch-text">Активен</span>
      </label>

      <label class="switch">
        <input class="switch-input" type="checkbox" name="site_visibility" checked />
        <span class="switch-ui" aria-hidden="true"></span>
        <span class="switch-text">Показывать на сайте</span>
      </label>
    </div>

    <div class="field-wrap product-fulfillment-mode-field">
      <label class="field-label" for="pe_fulfillment_mode">Режим продажи</label>
      <select class="control hidden" id="pe_fulfillment_mode" name="fulfillment_mode">
        <option value="stock">Со склада</option>
        <option value="made_to_order">Под заказ</option>
      </select>
      <div class="new-order-right-select-wrap settings-delivery-city-selector product-fulfillment-select" id="peFulfillmentModeWrap">
        <button class="new-order-right-select-trigger product-fulfillment-select-trigger" id="peFulfillmentModeTrigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Режим продажи">
          <span id="peFulfillmentModeText">Со склада</span>
          <i class="fas fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div class="new-order-right-select-menu no-scrollbar hidden" id="peFulfillmentModeMenu" role="listbox" aria-label="Режим продажи">
          <button class="new-order-right-select-option" type="button" data-value="stock">Со склада</button>
          <button class="new-order-right-select-option" type="button" data-value="made_to_order">Под заказ</button>
        </div>
      </div>
    </div>

    <div class="product-nutrition-card" id="peNutritionBlock">
      <div class="product-nutrition-head">
        <div>
          <div class="product-nutrition-title">КБЖУ</div>
          <div class="product-nutrition-subtitle">Значения на 100 г</div>
        </div>
        <div class="product-nutrition-actions">
          <button class="product-nutrition-warning hidden" id="peNutritionWarning" type="button" title="КБЖУ не заполнено">!</button>
          <div class="product-nutrition-badge">100 г</div>
        </div>
      </div>
      <div class="product-nutrition-grid">
        <div class="field-wrap product-nutrition-field">
          <label class="field-label" for="pe_nutrition_kcal">Ккал</label>
          <input class="control" id="pe_nutrition_kcal" type="text" inputmode="decimal" autocomplete="off" placeholder="0" readonly />
        </div>
        <div class="field-wrap product-nutrition-field">
          <label class="field-label" for="pe_nutrition_protein">Белки</label>
          <input class="control" id="pe_nutrition_protein" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
        <div class="field-wrap product-nutrition-field">
          <label class="field-label" for="pe_nutrition_fat">Жиры</label>
          <input class="control" id="pe_nutrition_fat" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
        <div class="field-wrap product-nutrition-field">
          <label class="field-label" for="pe_nutrition_carbs">Углеводы</label>
          <input class="control" id="pe_nutrition_carbs" type="text" inputmode="decimal" autocomplete="off" data-numeric-input placeholder="0" />
        </div>
      </div>
    </div>

    <div class="info-card info-accordion" id="peDescriptionAccordion" data-product-block="description">
      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger>
          <span class="stage-meta stage-text">
            <b>Описание</b>
          </span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>
        <div class="acc-panel" data-acc-panel>
          <div class="acc-panel-inner">
            <div class="product-description-field">
              <div class="product-description-field-head">
                <label class="product-description-label" for="pe_desc_short">Короткое описание</label>
                <label class="product-description-switch">
                  <input class="switch-input" id="pe_show_description_short" name="show_description_short" type="checkbox" checked />
                  <span class="switch-ui" aria-hidden="true"></span>
                  <span class="product-description-switch-text">Витрина</span>
                </label>
              </div>
              <textarea class="textarea" id="pe_desc_short" name="description_short" rows="3"></textarea>
            </div>

            <div class="product-description-field">
              <div class="product-description-field-head">
                <label class="product-description-label" for="pe_desc">Описание</label>
                <label class="product-description-switch">
                  <input class="switch-input" id="pe_show_description" name="show_description" type="checkbox" checked />
                  <span class="switch-ui" aria-hidden="true"></span>
                  <span class="product-description-switch-text">Витрина</span>
                </label>
              </div>
              <textarea class="textarea" id="pe_desc" name="description" rows="5"></textarea>
            </div>

            <div class="product-description-field">
              <div class="product-description-field-head">
                <label class="product-description-label" for="pe_client_composition">Состав</label>
                <div class="product-description-actions">
                  <button class="btn btn-sm" type="button" id="peGenerateCompositionBtn">Сгенерировать</button>
                  <label class="product-description-switch">
                    <input class="switch-input" id="pe_show_client_composition" name="show_client_composition" type="checkbox" checked />
                    <span class="switch-ui" aria-hidden="true"></span>
                    <span class="product-description-switch-text">Витрина</span>
                  </label>
                </div>
              </div>
              <textarea class="textarea" id="pe_client_composition" name="client_composition" rows="4"></textarea>
            </div>

            <div class="product-description-field">
              <div class="product-description-field-head">
                <label class="product-description-label" for="pe_tech_process">Тех процесс</label>
                <label class="product-description-switch">
                  <input class="switch-input" id="pe_show_tech_process" name="show_tech_process" type="checkbox" checked />
                  <span class="switch-ui" aria-hidden="true"></span>
                  <span class="product-description-switch-text">Витрина</span>
                </label>
              </div>
              <textarea class="textarea" id="pe_tech_process" name="tech_process" rows="5"></textarea>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="info-card product-options-card" id="peVariantBlock" data-product-block="variants">
      <div class="option-section-header">
        <div class="kv-label">Варианты товара</div>
        <div class="option-actions">
          <button class="btn btn-sm btn-icon" type="button" id="peVariantManageBtn" title="Добавить">
            <i class="fas fa-plus"></i>
          </button>
        </div>
      </div>
      <div class="info-accordion" id="peVariantAccordion"></div>
    </div>

    <div class="info-card product-options-card" id="peOptionBlock" data-product-block="options">
      <div class="option-section-header">
        <div class="kv-label">Опции</div>
        <div class="option-actions">
          <button class="btn btn-sm btn-icon" type="button" id="peOptionManageBtn" title="Добавить">
            <i class="fas fa-plus"></i>
          </button>
        </div>
      </div>
      <div class="info-accordion" id="peOptionAccordion"></div>
    </div>

    <div class="inline-backdrop hidden" id="peOptionBackdrop"></div>
    <div class="inline-modal hidden" id="peOptionModal" role="dialog" aria-modal="true">
      <div class="inline-modal-header">
        <div class="inline-modal-title">Опции товара</div>
        <button class="btn btn-icon" type="button" id="peOptionClose"><i class="fas fa-times"></i></button>
      </div>
      <div class="inline-modal-body no-scrollbar">
        <div class="option-picker-search">
          <input class="control" id="peOptionSearch" type="search" placeholder="Поиск по названию" />
        </div>
        <div class="option-picker-list" id="peOptionList"></div>
      </div>
      <div class="inline-modal-footer">
        <button class="btn" type="button" id="peOptionCancel">Отмена</button>
        <button class="btn btn-primary" type="button" id="peOptionApply">Добавить</button>
      </div>
    </div>

    <div class="info-card product-ingredients-card" id="peIngredientBlock" data-product-block="ingredients">
      <div class="option-section-header">
        <div class="kv-label">Состав</div>
        <div class="option-actions" style="display: flex; align-items: center; gap: 12px;">
          <div style="position: relative;">
            <span class="ingredient-control-label">Себест.</span>
            <span class="chip" id="peIngredientCostTotal" style="width: 80px; height: 34px; padding: 0 10px; border-radius: 8px; font-size: 13px; display: inline-flex; align-items: center; justify-content: center; margin-top: 0;">0 ₽</span>
          </div>
          <div style="position: relative;">
            <span class="ingredient-control-label">Цена</span>
            <span class="chip" id="peIngredientPriceTotal" style="width: 80px; height: 34px; padding: 0 10px; border-radius: 8px; font-size: 13px; display: inline-flex; align-items: center; justify-content: center; margin-top: 0;">0 ₽</span>
          </div>
          <div style="position: relative;">
            <span class="ingredient-control-label">Вес</span>
            <span class="chip" id="peIngredientWeightTotal" style="width: 80px; height: 34px; padding: 0 10px; border-radius: 8px; font-size: 13px; display: inline-flex; align-items: center; justify-content: center; margin-top: 0;">—</span>
          </div>
          <button class="btn btn-sm btn-icon" type="button" id="peIngredientAddBtn" title="Добавить">
            <i class="fas fa-plus"></i>
          </button>
        </div>
      </div>
      <div class="info-accordion" id="peIngredientAccordion"></div>
    </div>

    <div class="info-card product-options-card" id="pePromotionsBlock" data-product-block="promotions">
      <div class="option-section-header">
        <div class="kv-label">Участие в акциях</div>
      </div>
      <div class="info-accordion" id="peDiscountAccordion"></div>
      <div class="empty-hint hidden" id="peDiscountEmpty">Товар не участвует в акциях</div>
    </div>

    <div class="inline-backdrop hidden" id="peIngredientBackdrop"></div>
    <div class="inline-modal hidden" id="peIngredientModal" role="dialog" aria-modal="true">
      <div class="inline-modal-header">
        <div class="inline-modal-title">Добавить ингредиент</div>
        <button class="btn btn-icon" type="button" id="peIngredientModalClose"><i class="fas fa-times"></i></button>
      </div>
      <div class="inline-modal-body no-scrollbar">
        <div class="option-picker-search">
          <input class="control" id="peIngredientModalSearch" type="search" placeholder="Поиск товара..." />
        </div>
        <div class="option-picker-list" id="peIngredientModalList"></div>
      </div>
      <div class="inline-modal-footer">
        <button class="btn" type="button" id="peIngredientModalCancel">Отмена</button>
        <button class="btn btn-primary" type="button" id="peIngredientModalCreate">Создать новый товар</button>
      </div>
    </div>
  </form>
</template>

<!-- Category editor -->
<template id="tplCategoryEditor">
  <form id="categoryEditorForm" class="form-grid" autocomplete="off">
    <div class="category-editor-layout">
      <div class="category-editor-photo">
        <label class="field-label">Фото категории</label>
        <div class="category-editor-preview">
          <img id="ceIconPreview" class="category-editor-img hidden" alt="" />
          <div class="product-photo-placeholder" id="ceIconPlaceholder">Нет изображения</div>
        </div>
        <input id="ceIconFile" type="file" accept="image/*" class="hidden" />
        <div class="category-editor-actions">
          <button class="btn" type="button" id="ceIconUploadBtn">
            <i class="fas fa-image"></i> Загрузить
          </button>
          <button class="btn hidden" type="button" id="ceIconDeleteBtn">
            <i class="fas fa-times"></i> Удалить
          </button>
        </div>
      </div>

      <div class="category-editor-fields">
        <div>
          <label class="field-label" for="ce_title">Название *</label>
          <input class="control" id="ce_title" name="title" type="text" required />
        </div>

        <div class="form-row-2">
          <label class="switch">
            <input class="switch-input" type="checkbox" name="is_active" checked />
            <span class="switch-ui" aria-hidden="true"></span>
            <span class="switch-text">Активна</span>
          </label>

          <label class="switch">
            <input class="switch-input" type="checkbox" name="site_visibility" checked />
            <span class="switch-ui" aria-hidden="true"></span>
            <span class="switch-text">Показывать на сайте</span>
          </label>

          <label class="switch">
            <input class="switch-input" type="checkbox" name="cart_visibility" />
            <span class="switch-ui" aria-hidden="true"></span>
            <span class="switch-text">Показывать в корзине</span>
          </label>

          <label class="switch">
            <input class="switch-input" type="checkbox" name="checkout_visibility" checked />
            <span class="switch-ui" aria-hidden="true"></span>
            <span class="switch-text">Показывать при оформлении заказа</span>
          </label>
        </div>
      </div>
    </div>

    <input id="ce_code" name="code" type="hidden" />
    <input id="ce_icon" name="icon" type="hidden" />
    <input id="ce_sort" name="sort_order" type="hidden" />
  </form>
</template>
