<div class="center-stack">
  <!-- Toolbar как отдельный "остров" -->
  <div class="panel toolbar-island">
    <div class="toolbar clients-toolbar">
      <div class="toolbar-left">
        <button id="clientsToolbarBackBtn" class="icon-btn clients-toolbar-back hidden" type="button" aria-label="Назад" title="Назад">
          <i class="fas fa-arrow-left"></i>
        </button>
        <div class="toolbar-title" id="clientsToolbarTitle">
          <i class="fas fa-users"></i>
          <span id="clientsToolbarText">Клиенты</span>
        </div>
      </div>

      <div class="toolbar-right">
        <!-- Expandable search with toggle -->
        <div class="cl-search-wrap" id="clientsSearchWrap">
          <input
            id="clientsSearch"
            class="cl-search-input"
            type="text"
            placeholder="Имя или телефон..."
            autocomplete="off"
          />
          <button id="clientsSearchToggle" class="icon-btn cl-search-toggle" type="button" aria-label="Поиск" title="Поиск">
            <i class="fas fa-search"></i>
          </button>
        </div>

        <!-- Sort toggle -->
        <div class="cl-sort-wrap" id="clientsSortWrap">
          <button id="clientsSortToggle" class="icon-btn" type="button" aria-label="Сортировка" title="Сортировка">
            <i class="fas fa-arrow-up"></i>
            <i class="fas fa-arrow-down"></i>
          </button>
          <div class="cl-sort-dropdown hidden" id="clientsSortDropdown">
            <button class="cl-sort-option is-active" type="button" data-sort-val="last_desc">По активности</button>
            <button class="cl-sort-option" type="button" data-sort-val="name_asc">По имени (А→Я)</button>
            <button class="cl-sort-option" type="button" data-sort-val="orders_desc">По заказам (убыв.)</button>
            <button class="cl-sort-option" type="button" data-sort-val="created_desc">По дате создания</button>
          </div>
        </div>

        <!-- Add button (context-dependent) -->
        <label class="switch settings-chat-subheader-switch hidden" id="clientsBannersSwitchWrap" title="Показывать блоки на витрине">
          <input class="switch-input" type="checkbox" id="clientsBannersEnabledSwitch" />
          <span class="switch-ui" aria-hidden="true"></span>
          <span class="switch-text">Показывать на витрине</span>
        </label>

        <label class="bonus-point-rate-control hidden" id="clientsBonusPointRateWrap" title="Курс бонусов">
          <input class="bonus-point-rate-input" type="text" inputmode="decimal" id="clientsBonusPointAmountInput" value="1" />
          <span>&#1041; =</span>
          <input class="bonus-point-rate-input" type="text" inputmode="decimal" id="clientsBonusRubleAmountInput" value="1" />
          <span>&#8381;</span>
        </label>

        <label class="switch settings-chat-subheader-switch hidden" id="clientsBonusProgramSwitchWrap" title="Включить бонусную программу">
          <input class="switch-input" type="checkbox" id="clientsBonusProgramSwitch" />
          <span class="switch-ui" aria-hidden="true"></span>
          <span class="switch-text">Бонусная программа</span>
        </label>

        <label class="switch settings-chat-subheader-switch hidden" id="clientsReferralProgramSwitchWrap" title="Включить реферальную систему">
          <input class="switch-input" type="checkbox" id="clientsReferralProgramSwitch" />
          <span class="switch-ui" aria-hidden="true"></span>
          <span class="switch-text">Реферальная система</span>
        </label>
        <button id="clientsBonusEditCancelBtn" class="icon-btn hidden" type="button" aria-label="Отменить изменения" title="Отменить изменения">
          <i class="fas fa-times"></i>
        </button>
        <button id="clientsBonusEditSaveBtn" class="icon-btn hidden" type="button" aria-label="Сохранить изменения" title="Сохранить изменения">
          <i class="fas fa-check"></i>
        </button>
        <button id="clientsBonusEditBtn" class="icon-btn hidden" type="button" aria-label="Режим редактирования" title="Режим редактирования">
          <i class="fas fa-cog"></i>
        </button>
        <button id="bonusSettingsEditBtn" class="icon-btn hidden" type="button" aria-label="Редактировать настройки" title="Редактировать настройки">
          <i class="fas fa-pencil-alt"></i>
        </button>

        <button id="clientsAddBtn" class="icon-btn" type="button" aria-label="Добавить" title="Добавить">
          <i class="fas fa-plus"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Основной контент -->
  <div class="panel clients-panel">
    <div class="panel-body no-scrollbar">
      <!-- View: Список клиентов -->
      <div class="content-view" data-view-content="clients">
        <div class="orders-list" id="clientsList">
          <!-- JS отрисует сюда список клиентов -->
        </div>
        <div class="empty-hint hidden" id="clientsEmptyHint">Клиентов нет</div>
      </div>

      <!-- View: Список выборок/фильтров -->
      <div class="content-view hidden" data-view-content="filter-categories">
        <div class="orders-list" id="filterCategoriesList">
          <!-- JS отрисует сюда список фильтров -->
        </div>
        <div class="empty-hint hidden" id="filterCategoriesEmptyHint">Пока нет выборок. Нажмите «+» для создания.</div>
      </div>

      <!-- View: Список скидок -->
      <div class="content-view hidden" data-view-content="discounts">
        <div class="orders-list" id="discountsList">
          <!-- JS отрисует сюда список скидок или заказов -->
        </div>
        <div class="empty-hint hidden" id="discountsEmptyHint">Пока нет скидок. Нажмите «+» для создания.</div>
      </div>

      <div class="content-view hidden banners-content-view" data-view-content="banners">
        <div class="banners-layout">
          <div class="banners-placement-zone" id="bannersPlacementZone">
            <div class="banners-placement-head">
              <div class="banners-placement-copy">
                <div class="banners-placement-title">Размещение на витрине</div>
              </div>
            </div>

            <div class="banners-placement-body">
              <div class="banners-placement-track no-scrollbar" id="bannersPlacementTrack"></div>
            </div>
          </div>

          <div class="banners-list-scroll" id="bannersListScroll">
            <div class="orders-list" id="bannersList">
              <!-- JS отрисует сюда список баннеров -->
            </div>
            <div class="empty-hint hidden" id="bannersEmptyHint">Пока нет баннеров. Нажмите «+» для создания.</div>
          </div>
        </div>
      </div>

      <div class="content-view hidden" data-view-content="important-messages">
        <div class="orders-list" id="importantMessagesList"></div>
        <div class="empty-hint hidden" id="importantMessagesEmptyHint">Пока нет Promo рассылок. Нажмите «+», чтобы создать новую рассылку.</div>
      </div>

      <div class="content-view hidden banners-content-view" data-view-content="bonus-cards">
        <div class="banners-layout">
          <div class="banners-placement-zone" id="bonusLevelsZone">
            <div class="banners-placement-head">
              <div class="banners-placement-copy">
                <div class="banners-placement-title">Уровни</div>
              </div>
            </div>
            <div class="banners-placement-body">
              <div class="bonus-levels-scroll no-scrollbar" id="bonusLevelsScroll">
                <div class="bonus-levels-canvas" id="bonusLevelsCanvas">
                  <div class="banners-placement-track" id="bonusLevelsTrack"></div>
                  <div class="bonus-levels-scale" id="bonusLevelsScale">
                    <div class="bonus-levels-scale-line" aria-hidden="true"></div>
                    <div class="bonus-levels-scale-points" id="bonusLevelsScalePoints"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="banners-list-scroll" id="bonusClientsListScroll">
            <div class="orders-list" id="bonusClientsList"></div>
            <div class="empty-hint hidden" id="bonusClientsEmptyHint">Пока нет истории бонусной программы.</div>
            <div class="bonus-history-pagination hidden" id="bonusHistoryPagination"></div>
          </div>
        </div>
      </div>

      <div class="content-view hidden banners-content-view" data-view-content="bonus-referrals">
        <div class="banners-layout">
          <div class="banners-placement-zone" id="bonusReferralLevelsZone">
            <div class="banners-placement-head">
              <div class="banners-placement-copy">
                <div class="banners-placement-title">Уровни рефералов</div>
              </div>
            </div>
            <div class="banners-placement-body">
              <div class="bonus-referral-levels-scroll no-scrollbar" id="bonusReferralLevelsScroll">
                <div class="banners-placement-track" id="bonusReferralLevelsTrack"></div>
              </div>
            </div>
          </div>

          <div class="banners-list-scroll" id="bonusReferralsListScroll">
            <div class="orders-list" id="bonusReferralsList"></div>
            <div class="empty-hint hidden" id="bonusReferralsEmptyHint">Пока нет реферальных событий.</div>
          </div>
        </div>
      </div>

      <div class="content-view hidden" data-view-content="bonus-settings">
      </div>

      <div class="content-view hidden" data-view-content="subscription-history">
        <div class="orders-list" id="subscriptionHistoryList"></div>
        <div class="empty-hint hidden" id="subscriptionHistoryEmptyHint">Пока нет оформленных подписок.</div>
      </div>

      <div class="content-view hidden" data-view-content="subscription-settings">
        <div class="orders-list" id="subscriptionPlansList"></div>
        <div class="empty-hint hidden" id="subscriptionPlansEmptyHint">Пока нет условий подписки. Нажмите «+», чтобы создать первое.</div>
      </div>
    </div>
  </div>

  <div class="admin-sheet-overlay hidden" id="bannerPickerOverlay" aria-hidden="true">
    <div class="admin-sheet-backdrop" id="bannerPickerBackdrop"></div>
    <div class="admin-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="bannerPickerTitle">
      <div class="admin-sheet-header">
        <div>
          <div class="admin-sheet-title" id="bannerPickerTitle">Размещение баннеров</div>
          <div class="admin-sheet-subtitle" id="bannerPickerSubtitle">Выберите баннеры для блока на витрине</div>
        </div>
        <button
          type="button"
          class="icon-btn admin-sheet-close"
          id="bannerPickerCloseBtn"
          aria-label="Закрыть"
          title="Закрыть"
        >
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="admin-sheet-body no-scrollbar">
        <div class="admin-sheet-list" id="bannerPickerList"></div>
        <div class="empty-hint hidden" id="bannerPickerEmptyHint">Нет баннеров этого типа для размещения.</div>
      </div>

      <div class="panel-footer admin-sheet-footer">
        <div class="product-footer-actions">
          <div class="product-footer-view">
            <button class="product-footer-btn product-footer-cancel is-fullwidth" type="button" id="bannerPickerCancelBtn">Отменить</button>
            <button class="product-footer-btn product-footer-save" type="button" id="bannerPickerSaveBtn">Сохранить</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
