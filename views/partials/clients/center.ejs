<div class="panel clients-panel">
  <div class="panel-header" style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <div class="panel-title">Клиенты</div>

    <div style="display:flex; gap:8px; align-items:center; width: min(420px, 100%);">
      <input
        id="clientsSearch"
        class="control"
        type="text"
        placeholder="Поиск: имя или телефон"
        autocomplete="off"
        style="width:100%;"
      />
      <button id="clientsSearchClear" class="icon-btn" type="button" aria-label="Очистить поиск" title="Очистить">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>

  <div class="panel-body no-scrollbar">
    <div class="orders-list" id="clientsList">
      <!-- JS отрисует сюда список клиентов -->
    </div>

    <div class="empty-hint hidden" id="clientsEmptyHint">Клиентов нет</div>
  </div>
</div>
