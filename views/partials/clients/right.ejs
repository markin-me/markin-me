<div class="panel client-info-panel">
  <div class="panel-header">
    <div class="panel-title">Данные клиента</div>
  </div>

  <div class="panel-body no-scrollbar">
    <div class="order-info">
      <div class="order-info-title" id="clientInfoTitle">Клиент не выбран</div>
      <div class="order-info-meta" id="clientInfoMeta">Выбери клиента в центре</div>

      <div class="info-grid" style="margin-top:14px;">
        <div class="info-row">
          <div class="info-label">Имя</div>
          <div class="info-value" id="clientInfoName">—</div>
        </div>
        <div class="info-row">
          <div class="info-label">Телефон</div>
          <div class="info-value" id="clientInfoPhone">—</div>
        </div>
        <div class="info-row">
          <div class="info-label">Дата рождения</div>
          <div class="info-value" id="clientInfoBirthday">—</div>
        </div>
        <div class="info-row">
          <div class="info-label">Заказов</div>
          <div class="info-value" id="clientInfoOrders">—</div>
        </div>
        <div class="info-row">
          <div class="info-label">Сумма</div>
          <div class="info-value" id="clientInfoSpent">—</div>
        </div>
        <div class="info-row">
          <div class="info-label">Последний заказ</div>
          <div class="info-value" id="clientInfoLastOrder">—</div>
        </div>
      </div>

      <div style="height:14px;"></div>

      <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
        <div class="panel-title" style="font-size:14px;">Адреса</div>
        <button id="clientReloadAddresses" class="icon-btn" type="button" aria-label="Обновить адреса" title="Обновить">
          <i class="fas fa-rotate"></i>
        </button>
      </div>

      <div id="clientAddresses" style="display:grid; gap:10px; margin-top:10px;">
        <!-- JS: список адресов -->
      </div>

      <div style="height:14px;"></div>

      <div class="panel-title" style="font-size:14px;">Добавить адрес</div>

      <div class="shop-auth-form" style="margin-top:10px;">
        <label class="field-label">Улица</label>
        <input id="addrStreet" class="control" type="text" placeholder="Улица" />

        <label class="field-label">Дом</label>
        <input id="addrHouse" class="control" type="text" placeholder="Дом" />

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
          <div>
            <label class="field-label">Подъезд</label>
            <input id="addrEntrance" class="control" type="text" placeholder="1" />
          </div>
          <div>
            <label class="field-label">Этаж</label>
            <input id="addrFloor" class="control" type="text" placeholder="5" />
          </div>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
          <div>
            <label class="field-label">Квартира</label>
            <input id="addrApartment" class="control" type="text" placeholder="12" />
          </div>
          <div>
            <label class="field-label">По умолчанию</label>
            <label style="display:flex; gap:10px; align-items:center; height:44px; border:1px solid var(--color-border); border-radius:12px; padding:0 12px; background:var(--color-surface-2);">
              <input id="addrIsDefault" type="checkbox" />
              <span style="font-weight:700; color:var(--color-text);">Да</span>
            </label>
          </div>
        </div>

        <label class="field-label">Комментарий</label>
        <input id="addrComment" class="control" type="text" placeholder="Домофон, ориентир..." />

        <button id="addrAddBtn" type="button" class="btn btn-primary" style="width:100%;">
          Добавить адрес
        </button>
      </div>
    </div>
  </div>
</div>
