<div class="panel client-info-panel">
  <div class="panel-header product-tabs-header hidden" id="clientTabsHeader">
    <div class="product-tabs" id="clientTabs"></div>
    <button
      type="button"
      class="icon-btn client-mobile-sheet-close"
      id="clientMobileSheetCloseBtn"
      aria-label="Закрыть"
      title="Закрыть"
    >
      <i class="fas fa-times" aria-hidden="true"></i>
    </button>
  </div>

  <div class="panel-body no-scrollbar" id="clientInfoBody">
    <!-- Empty state для клиентов -->
    <div id="clientEmpty" class="empty-state">
      <div class="empty-icon"><i class="fas fa-mouse-pointer"></i></div>
      <div class="empty-title">Выберите клиента</div>
      <div class="empty-text">Нажмите на клиента в списке для просмотра подробной информации</div>
    </div>

    <!-- Empty state для выборок -->
    <div id="filterCategoryEmpty" class="empty-state hidden">
      <div class="empty-icon"><i class="fas fa-filter"></i></div>
      <div class="empty-title">Выберите выборку</div>
      <div class="empty-text">Нажмите на выборку слева, чтобы увидеть детали</div>
    </div>

    <!-- Empty state для скидок -->
    <div id="discountEmpty" class="empty-state hidden">
      <div class="empty-icon"><i class="fas fa-percentage"></i></div>
      <div class="empty-title">Выберите скидку</div>
      <div class="empty-text">Нажмите на скидку слева или создайте новую</div>
    </div>

    <!-- Форма редактирования фильтра/выборки -->
    <div id="filterEditorWrap" class="hidden">
      <form id="filterEditorForm" class="form-grid" autocomplete="off">
        <div class="field-wrap">
          <label class="field-label" for="fe_title">Название *</label>
          <input class="control" id="fe_title" name="title" type="text" placeholder="Например: VIP клиенты" required />
        </div>

        <div class="field-wrap">
          <label class="field-label">Логика условий</label>
          <div class="custom-select logic-select" id="fe_logic" data-value="AND">
            <button type="button" class="cs-trigger control">
              <span class="cs-value">Все условия (И)</span>
              <i class="fas fa-chevron-down cs-arrow"></i>
            </button>
            <div class="cs-dropdown hidden">
              <button type="button" class="cs-option is-selected" data-value="AND">Все условия (И)</button>
              <button type="button" class="cs-option" data-value="OR">Любое условие (ИЛИ)</button>
            </div>
          </div>
        </div>

        <div class="field-wrap">
          <label class="field-label">Условия фильтрации</label>
          <div id="filterRulesContainer"></div>
          <button type="button" class="btn btn-sm" id="filterAddRuleBtn" style="margin-top:8px;">
            <i class="fas fa-plus"></i> Добавить условие
          </button>
        </div>

        <div class="form-row-3" style="margin-top:12px;">
          <label class="switch">
            <input class="switch-input" type="checkbox" name="is_active" id="fe_is_active" checked />
            <span class="switch-ui" aria-hidden="true"></span>
            <span class="switch-text">Активна</span>
          </label>
        </div>

        <input type="hidden" id="fe_id" name="id" value="" />
      </form>
    </div>

    <!-- Форма редактирования скидки -->
    <div id="discountEditorWrap" class="hidden">
      <form id="discountEditorForm" class="form-grid" autocomplete="off">
        <div class="field-wrap">
          <input class="control" id="de_title" name="title" type="text" placeholder="Название" required />
        </div>

        <div class="field-wrap">
          <textarea class="control" id="de_description" name="description" rows="3" placeholder="Описание"></textarea>
        </div>

        <div class="field-wrap">
          <div class="discount-choice-scroll" id="de_mechanic_choice_scroller">
            <div class="discount-choice-grid" id="de_mechanic_choice_grid">
              <button class="cash-payment-method-pill discount-choice-pill" type="button" data-discount-mechanic-choice="simple_discount" aria-pressed="false">
                <span class="cash-payment-method-pill-icon"><i class="fas fa-percent"></i></span>
                <span class="cash-payment-method-pill-title">Скидка</span>
              </button>
              <button class="cash-payment-method-pill discount-choice-pill" type="button" data-discount-mechanic-choice="promo_code" aria-pressed="false">
                <span class="cash-payment-method-pill-icon"><i class="fas fa-ticket-alt"></i></span>
                <span class="cash-payment-method-pill-title">Промокод</span>
              </button>
              <button class="cash-payment-method-pill discount-choice-pill" type="button" data-discount-mechanic-choice="buy_x_get_y" aria-pressed="false">
                <span class="cash-payment-method-pill-icon"><i class="fas fa-gift"></i></span>
                <span class="cash-payment-method-pill-title">1+1</span>
              </button>
              <button class="cash-payment-method-pill discount-choice-pill" type="button" data-discount-mechanic-choice="loyalty_progress" aria-pressed="false">
                <span class="cash-payment-method-pill-icon"><i class="fas fa-chart-line"></i></span>
                <span class="cash-payment-method-pill-title">Накопительная</span>
              </button>
              <button class="cash-payment-method-pill discount-choice-pill" type="button" data-discount-mechanic-choice="threshold" aria-pressed="false">
                <span class="cash-payment-method-pill-icon"><i class="fas fa-layer-group"></i></span>
                <span class="cash-payment-method-pill-title">Пороговая</span>
              </button>
            </div>
          </div>
          <select class="control hidden" id="de_mechanic_type" name="mechanic_type">
            <option value="simple_discount">Скидка</option>
            <option value="buy_x_get_y">1+1</option>
            <option value="loyalty_progress">Накопительная</option>
            <option value="threshold">Пороговая</option>
          </select>
        </div>

        <div class="discount-editor-section discount-editor-section--centered" id="de_simple_wrap">
          <select class="control hidden" id="de_simple_variant" name="simple_variant">
            <option value="promo_code">Промокод</option>
            <option value="percent">Процент</option>
            <option value="fixed">Фикс. сумма</option>
            <option value="special_price">Спеццена</option>
          </select>
          <select class="control hidden" id="de_discount_type" name="discount_type">
            <option value="percent">Процент</option>
            <option value="fixed">Сумма</option>
            <option value="special_price" hidden>Специальная цена</option>
          </select>

          <div class="discount-editor-centered-flow" id="de_simple_regular_wrap">
            <div class="field-wrap">
              <select class="control hidden" id="de_apply_to" name="apply_to">
                <option value="order">Весь заказ</option>
                <option value="product">Конкретный товар</option>
                <option value="category">Категория товаров</option>
                <option value="combo" hidden>Комбо</option>
              </select>
              <div class="discount-help-row">
                <div class="discount-promo-apply-chips" data-discount-choice-group="de_apply_to" id="de_apply_to_chips">
                  <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="order" aria-pressed="false">Весь заказ</button>
                  <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="product" aria-pressed="false">Товар</button>
                  <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="category" aria-pressed="false">Категория</button>
                </div>
                <button type="button" class="order-summary-discount-info-btn discount-help-info-btn" data-discount-help-trigger="simple_apply_to" aria-expanded="false" aria-label="Что означает этот ряд">
                  <i class="fas fa-info"></i>
                </button>
              </div>
              <div class="discount-help-popover hidden" id="de_help_simple_apply_to_popover" role="dialog" aria-hidden="true">
                <div class="discount-help-popover-text">Определяет, на что именно распространяется правило: на весь заказ, на товары или на категории.</div>
              </div>
            </div>

            <div class="discount-editor-inline-row discount-editor-inline-row--value" id="de_simple_value_row">
              <div class="field-wrap discount-inline-value-field">
                <div class="discount-inline-value-control">
                  <input class="control discount-inline-value-input" id="de_discount_value" name="discount_value" type="number" step="0.01" min="0" placeholder="Значение" />
                  <div class="discount-inline-value-toggle" data-discount-choice-group="de_discount_type" id="de_discount_type_chips" aria-label="Тип скидки">
                    <button class="discount-inline-value-type" type="button" data-discount-choice-value="percent" aria-pressed="false" title="Процент">
                      <span class="discount-inline-value-type-symbol">%</span>
                    </button>
                    <button class="discount-inline-value-type" type="button" data-discount-choice-value="fixed" aria-pressed="false" title="Сумма">
                      <span class="discount-inline-value-type-symbol">₽</span>
                    </button>
                    <button class="discount-inline-value-type hidden" type="button" data-discount-choice-value="special_price" aria-pressed="false" aria-hidden="true" title="Спеццена">
                      <i class="fas fa-tag"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="field-wrap" id="de_products_wrap">
              <label class="field-label" id="de_products_label">Товары</label>
              <div class="discount-entity-toolbar">
                <button type="button" class="discount-audience-add-btn" id="de_add_products_btn" aria-label="Добавить товар или категорию" title="Добавить товар или категорию">
                  <span class="discount-audience-add-btn-main">
                    <span class="discount-audience-add-btn-icon"><i class="fas fa-plus"></i></span>
                    <span class="discount-audience-add-btn-copy">
                      <span class="discount-audience-add-btn-title" id="de_add_products_btn_text">Товары не выбраны</span>
                      <span class="discount-audience-add-btn-meta">Нажмите, чтобы выбрать товары</span>
                    </span>
                  </span>
                  <span class="discount-audience-add-btn-caret"><i class="fas fa-chevron-down"></i></span>
                </button>
              </div>
              <div class="discount-audience-list discount-entity-list" id="de_products_chips"></div>
            </div>
          </div>
        </div>

        <div class="discount-editor-section hidden discount-editor-section--centered" id="de_buy_x_get_y_wrap">
          <div class="field-wrap">
            <div class="discount-help-row">
              <div class="discount-promo-apply-chips" data-discount-choice-group="de_buy_repeat_mode" id="de_buy_repeat_mode_chips">
                <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="single" aria-pressed="false">Один раз за заказ</button>
                <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="repeat" aria-pressed="false">Кратно условию</button>
              </div>
              <button type="button" class="order-summary-discount-info-btn discount-help-info-btn" data-discount-help-trigger="buy_repeat" aria-expanded="false" aria-label="Что означает этот ряд">
                <i class="fas fa-info"></i>
              </button>
            </div>
            <div class="discount-help-popover hidden" id="de_help_buy_repeat_popover" role="dialog" aria-hidden="true">
              <div class="discount-help-popover-text">Определяет, срабатывает акция один раз в заказе или повторяется столько раз, сколько раз выполнено условие.</div>
            </div>
          </div>

          <div class="form-row-2">
            <div class="field-wrap">
              <label class="field-label" for="de_buy_qty">Сколько покупаем</label>
              <div class="discount-stepper">
                <button
                  type="button"
                  class="discount-stepper-btn"
                  id="de_buy_qty_minus"
                  aria-label="Уменьшить количество товаров для условия"
                >
                  <span aria-hidden="true">−</span>
                </button>
                <input class="control discount-stepper-input" id="de_buy_qty" type="number" min="1" step="1" value="1" />
                <button
                  type="button"
                  class="discount-stepper-btn"
                  id="de_buy_qty_plus"
                  aria-label="Увеличить количество товаров для условия"
                >
                  <span aria-hidden="true">+</span>
                </button>
              </div>
            </div>
            <div class="field-wrap">
              <label class="field-label" for="de_reward_qty">Сколько даем</label>
              <div class="discount-stepper">
                <button
                  type="button"
                  class="discount-stepper-btn"
                  id="de_reward_qty_minus"
                  aria-label="Уменьшить количество награды"
                >
                  <span aria-hidden="true">−</span>
                </button>
                <input class="control discount-stepper-input" id="de_reward_qty" type="number" min="1" step="1" value="1" />
                <button
                  type="button"
                  class="discount-stepper-btn"
                  id="de_reward_qty_plus"
                  aria-label="Увеличить количество награды"
                >
                  <span aria-hidden="true">+</span>
                </button>
              </div>
            </div>
          </div>

          <input type="hidden" id="de_buy_condition_ui_mode" value="product" />
          <select class="control hidden" id="de_buy_qualifying_mode">
            <option value="same_sku">same_sku</option>
            <option value="pool">pool</option>
          </select>
          <select class="control hidden" id="de_buy_repeat_mode">
            <option value="single">Один раз за заказ</option>
            <option value="repeat">Кратно условию</option>
          </select>
          <select class="control hidden" id="de_buy_reward_source">
            <option value="same_pool">Из условия</option>
            <option value="reward_list">Отдельный список</option>
          </select>
          <select class="control hidden" id="de_buy_reward_kind">
            <option value="gift">Подарок</option>
            <option value="product_discount">Скидка</option>
          </select>

          <div class="discount-buy-visual-card" id="de_buy_visual_card">
            <div class="discount-buy-visual-rows" id="de_buy_visual_rows"></div>
          </div>

          <select class="control hidden" id="de_buy_reward_discount_type">
            <option value="percent">Процент</option>
            <option value="fixed">Сумма</option>
            <option value="special_price">Спеццена</option>
          </select>
          <div class="discount-editor-inline-row discount-editor-inline-row--value hidden" id="de_buy_reward_discount_wrap">
            <div class="field-wrap discount-inline-value-field">
              <div class="discount-inline-value-control">
                <input class="control discount-inline-value-input" id="de_buy_reward_discount_value" type="number" step="0.01" min="0" placeholder="Значение" />
                <div class="discount-inline-value-toggle" data-discount-choice-group="de_buy_reward_discount_type" id="de_buy_reward_discount_type_chips" aria-label="Тип скидки награды">
                  <button class="discount-inline-value-type" type="button" data-discount-choice-value="percent" aria-pressed="false" title="Процент">
                    <span class="discount-inline-value-type-symbol">%</span>
                  </button>
                  <button class="discount-inline-value-type" type="button" data-discount-choice-value="fixed" aria-pressed="false" title="Сумма">
                    <span class="discount-inline-value-type-symbol">₽</span>
                  </button>
                  <button class="discount-inline-value-type" type="button" data-discount-choice-value="special_price" aria-pressed="false" title="Спеццена">
                    <i class="fas fa-tag"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="discount-editor-section hidden discount-editor-section--centered" id="de_threshold_wrap">
          <select class="control hidden" id="de_threshold_basis">
            <option value="before_discounts">До скидок</option>
            <option value="after_discounts">После скидок</option>
          </select>
          <select class="control hidden" id="de_threshold_apply_mode">
            <option value="best_only">Только лучшая ступень</option>
            <option value="cumulative">Суммировать ступени</option>
          </select>

          <div class="field-wrap">
            <label class="field-label" for="de_threshold_slot_count">Сколько покупаем</label>
            <div class="discount-stepper" id="de_threshold_slot_count_stepper">
              <button
                type="button"
                class="discount-stepper-btn"
                id="de_threshold_slot_count_minus"
                aria-label="Уменьшить количество порогов"
              >
                <span aria-hidden="true">−</span>
              </button>
              <input class="control discount-stepper-input" id="de_threshold_slot_count" type="number" min="1" step="1" value="1" />
              <button
                type="button"
                class="discount-stepper-btn"
                id="de_threshold_slot_count_plus"
                aria-label="Увеличить количество порогов"
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>
          </div>

          <div class="discount-buy-visual-card discount-selection-visual-card">
            <div class="discount-threshold-slot-rows" id="de_threshold_tiers_list"></div>
          </div>

          <div class="discount-threshold-reward-picker hidden" id="de_threshold_reward_picker" hidden>
            <div class="discount-threshold-reward-picker-card">
              <div class="discount-threshold-reward-picker-title">Что добавить в порог</div>
              <div class="discount-threshold-reward-picker-types" id="de_threshold_reward_picker_types">
                <button type="button" class="shop-chip-btn discount-promo-apply-chip" data-threshold-reward-kind-choice="product">Товар</button>
                <button type="button" class="shop-chip-btn discount-promo-apply-chip" data-threshold-reward-kind-choice="product_list">Список товаров</button>
                <button type="button" class="shop-chip-btn discount-promo-apply-chip" data-threshold-reward-kind-choice="discount_ref">Скидка</button>
                <button type="button" class="shop-chip-btn discount-promo-apply-chip" data-threshold-reward-kind-choice="promo_code_ref">Промокод</button>
              </div>
              <div class="discount-threshold-reward-picker-list hidden" id="de_threshold_reward_picker_list" hidden></div>
            </div>
          </div>
        </div>

        <div class="discount-editor-section hidden discount-editor-section--centered" id="de_loyalty_progress_wrap">
          <div class="field-wrap">
            <select class="control hidden" id="de_progress_basis">
              <option value="orders">Чеки</option>
              <option value="items">Товары</option>
              <option value="amount">Сумму</option>
            </select>
            <div class="discount-help-row">
              <div class="discount-promo-apply-chips" data-discount-choice-group="de_progress_basis" id="de_progress_basis_chips">
                <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="orders" aria-pressed="false">Чеки</button>
                <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="items" aria-pressed="false">Товары</button>
                <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="amount" aria-pressed="false">Сумму</button>
              </div>
              <button type="button" class="order-summary-discount-info-btn discount-help-info-btn" data-discount-help-trigger="progress_basis" aria-expanded="false" aria-label="Что означает этот ряд">
                <i class="fas fa-info"></i>
              </button>
            </div>
            <div class="discount-help-popover hidden" id="de_help_progress_basis_popover" role="dialog" aria-hidden="true">
              <div class="discount-help-popover-text">Определяет, что именно накапливает клиент: завершенные чеки, покупки товаров или сумму заказов.</div>
            </div>
          </div>

          <input class="control hidden" id="de_progress_threshold_value" type="number" min="1" step="1" value="1" />
          <input class="control hidden" id="de_progress_status_filter" type="hidden" value="completed" />

          <div class="form-row-2">
            <div class="field-wrap">
              <label class="field-label" for="de_progress_buy_qty">Сколько покупаем</label>
              <div class="discount-stepper">
                <button
                  type="button"
                  class="discount-stepper-btn"
                  id="de_progress_buy_qty_minus"
                  aria-label="Уменьшить количество покупок"
                >
                  <span aria-hidden="true">−</span>
                </button>
                <input class="control discount-stepper-input" id="de_progress_buy_qty" type="number" min="1" step="1" value="1" />
                <button
                  type="button"
                  class="discount-stepper-btn"
                  id="de_progress_buy_qty_plus"
                  aria-label="Увеличить количество покупок"
                >
                  <span aria-hidden="true">+</span>
                </button>
              </div>
            </div>
            <div class="field-wrap">
              <label class="field-label" for="de_progress_reward_qty">Сколько даем</label>
              <div class="discount-stepper">
                <button
                  type="button"
                  class="discount-stepper-btn"
                  id="de_progress_reward_qty_minus"
                  aria-label="Уменьшить количество награды"
                >
                  <span aria-hidden="true">−</span>
                </button>
                <input class="control discount-stepper-input" id="de_progress_reward_qty" type="number" min="1" step="1" value="1" />
                <button
                  type="button"
                  class="discount-stepper-btn"
                  id="de_progress_reward_qty_plus"
                  aria-label="Увеличить количество награды"
                >
                  <span aria-hidden="true">+</span>
                </button>
              </div>
            </div>
          </div>

          <div class="discount-buy-visual-card discount-selection-visual-card">
            <div class="discount-buy-visual-rows" id="de_progress_counts_visual_rows"></div>
          </div>

          <select class="control hidden" id="de_progress_scope_mode">
            <option value="none">Не используется</option>
            <option value="product">Товар</option>
            <option value="product_list">Список товаров</option>
            <option value="category">Категория</option>
          </select>

          <div class="field-wrap">
            <select class="control hidden" id="de_progress_pending_reward_mode">
              <option value="stack">Копить награды</option>
              <option value="single_pending">Только одна награда</option>
            </select>
            <div class="discount-help-row">
              <div class="discount-promo-apply-chips" data-discount-choice-group="de_progress_pending_reward_mode" id="de_progress_pending_reward_mode_chips">
                <button class="shop-chip-btn discount-promo-apply-chip" type="button" data-discount-choice-value="stack" aria-pressed="false">Копить награды</button>
