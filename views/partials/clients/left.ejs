<div class="panel clients-filters">
  <div class="panel-header">
    <div class="panel-title">Маркетинг</div>
  </div>

  <div class="panel-body no-scrollbar">
    <div class="clients-accordion" id="clientsAccordion">
      <!-- Аккордеон Клиенты -->
      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger>
          <span class="stage-icon"><i class="fas fa-users"></i></span>
          <span class="stage-meta stage-text"><b>Клиенты</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <!-- Базовые фильтры -->
          <div class="acc-panel-inner" id="clientsFiltersList"></div>

          <!-- Кнопка "Выборки" для открытия списка кастомных фильтров -->
          <div class="acc-panel-inner">
            <button class="stage-item is-dashed" type="button" id="openFilterCategoriesBtn">
              <span class="stage-icon"><i class="fas fa-plus"></i></span>
              <span class="stage-meta stage-text"><b>Выборки</b></span>
              <span class="acc-spacer"></span>
            </button>
          </div>
        </div>
      </div>

      <!-- Аккордеон Скидки -->
      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger>
          <span class="stage-icon"><i class="fas fa-percentage"></i></span>
          <span class="stage-meta stage-text"><b>Скидки</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <!-- Фильтры скидок -->
          <div class="acc-panel-inner" id="discountsFiltersList"></div>
        </div>
      </div>

      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger>
          <span class="stage-icon"><i class="fas fa-images"></i></span>
          <span class="stage-meta stage-text"><b>Баннеры</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <div class="acc-panel-inner" id="bannersFiltersList"></div>
        </div>
      </div>

      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger>
          <span class="stage-icon"><i class="fas fa-gift"></i></span>
          <span class="stage-meta stage-text"><b>Бонусы</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <div class="acc-panel-inner">
            <button class="stage-item" type="button" id="bonusCardsBtn">
              <span class="stage-meta stage-text"><b>Базовый тариф</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="bonusPaidTariffBtn">
              <span class="stage-meta stage-text"><b>Платный тариф</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="bonusReferralsBtn">
              <span class="stage-meta stage-text"><b>Рефералы</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="bonusProgramsBtn">
              <span class="stage-meta stage-text"><b>Бонусы</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="bonusSettingsNavBtn">
              <span class="stage-meta stage-text"><b>Настройки</b></span>
              <span class="acc-spacer"></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
