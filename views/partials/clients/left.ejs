<div class="panel clients-filters">
  <div class="panel-header">
    <div class="panel-title">Маркетинг</div>
  </div>

  <div class="panel-body no-scrollbar">
    <div class="clients-accordion" id="clientsAccordion">
      <!-- Аккордеон Клиенты -->
      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger data-rbac-node="marketing.clients">
          <span class="stage-icon"><i class="fas fa-users"></i></span>
          <span class="stage-meta stage-text"><b>Клиенты</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <!-- Базовые фильтры -->
          <div class="acc-panel-inner" id="clientsFiltersList"></div>

          <!-- Кнопка "Выборки" для открытия списка кастомных фильтров -->
          <div class="acc-panel-inner">
            <button class="stage-item is-dashed" type="button" id="openFilterCategoriesBtn" data-rbac-node="marketing.segments">
              <span class="stage-icon"><i class="fas fa-plus"></i></span>
              <span class="stage-meta stage-text"><b>Выборки</b></span>
              <span class="acc-spacer"></span>
            </button>
          </div>
        </div>
      </div>

      <!-- Аккордеон Скидки -->
      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger data-rbac-node="marketing.discounts">
          <span class="stage-icon"><i class="fas fa-percentage"></i></span>
          <span class="stage-meta stage-text"><b>Скидки</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <!-- Фильтры скидок -->
          <div class="acc-panel-inner" id="discountsFiltersList"></div>
        </div>
      </div>

      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger data-rbac-node="marketing.banners">
          <span class="stage-icon"><i class="fas fa-images"></i></span>
          <span class="stage-meta stage-text"><b>Баннеры</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <div class="acc-panel-inner" id="bannersFiltersList"></div>
        </div>
      </div>

      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger data-rbac-node="marketing.bonus">
          <span class="stage-icon"><i class="fas fa-gift"></i></span>
          <span class="stage-meta stage-text"><b>Бонусы</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <div class="acc-panel-inner">
            <button class="stage-item" type="button" id="bonusCardsBtn" data-rbac-node="marketing.bonus_base">
              <span class="stage-meta stage-text"><b>Базовый тариф</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="bonusPaidTariffBtn" data-rbac-node="marketing.bonus_paid">
              <span class="stage-meta stage-text"><b>Платный тариф</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="bonusReferralsBtn" data-rbac-node="marketing.referrals">
              <span class="stage-meta stage-text"><b>Рефералы</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="bonusProgramsBtn" data-rbac-node="marketing.bonus_programs">
              <span class="stage-meta stage-text"><b>Бонусы</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="bonusSettingsNavBtn" data-rbac-node="marketing.bonus_settings">
              <span class="stage-meta stage-text"><b>Настройки</b></span>
              <span class="acc-spacer"></span>
            </button>
          </div>
        </div>
      </div>

      <div class="acc-item">
        <button class="stage-item acc-trigger" type="button" data-acc-trigger data-rbac-node="marketing.subscriptions">
          <span class="stage-icon"><i class="fas fa-calendar-check"></i></span>
          <span class="stage-meta stage-text"><b>Подписка</b></span>
          <span class="acc-chevron"><i class="fas fa-chevron-down"></i></span>
        </button>

        <div class="acc-panel" data-acc-panel style="max-height:0;">
          <div class="acc-panel-inner">
            <button class="stage-item" type="button" id="subscriptionHistoryBtn" data-rbac-node="marketing.subscription_history">
              <span class="stage-meta stage-text"><b>История подписок</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="subscriptionSettingsBtn" data-rbac-node="marketing.subscription_plans">
              <span class="stage-meta stage-text"><b>Настройка подписки</b></span>
              <span class="acc-spacer"></span>
            </button>
            <button class="stage-item" type="button" id="subscriptionInfoBtn" data-rbac-node="marketing.subscription_info">
              <span class="stage-meta stage-text"><b>Информация</b></span>
              <span class="acc-spacer"></span>
            </button>
          </div>
        </div>
      </div>

      <div class="acc-item">
        <button class="stage-item" type="button" id="importantMessagesBtn" data-rbac-node="marketing.broadcasts">
          <span class="stage-icon"><i class="fas fa-bullhorn"></i></span>
          <span class="stage-meta stage-text"><b style="white-space:nowrap;">Promo рассылки</b></span>
          <span class="acc-spacer"></span>
        </button>
      </div>
    </div>
  </div>
</div>
