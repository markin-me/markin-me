<header>
  <div class="header-content">
    <div class="header-left">
      <div class="logo">
        <div class="logo-icon">
          <img id="headerLogoImg" class="logo-img hidden" alt="Логотип" />
          <span id="headerLogoFallback">П</span>
        </div>
        <div class="logo-text" id="headerBrandName">По щам</div>
        <% const hasCitySelector = (typeof showCitySelector !== 'undefined' && showCitySelector === true); %>
        <% if (hasCitySelector) { %>
          <div class="logo-city-wrapper" id="headerCitySelector">
            <button
              type="button"
              class="header-city-button"
              id="headerCityButton"
              aria-haspopup="menu"
              aria-expanded="false"
              disabled
            >
              <span class="header-city-name" id="headerCityName">—</span>
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div
              class="header-city-dropdown hidden"
              id="headerCityDropdown"
              role="menu"
              aria-label="Выбор города доставки"
            ></div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="header-actions">
      <button class="header-btn" id="theme-toggle" type="button" aria-label="Переключить тему">
        <i class="fas fa-moon"></i>
      </button>

      <!-- Важно: id для перехвата на витрине -->
      <div class="user-menu-wrapper">
        <div class="header-profile-wrapper">
          <div class="shop-active-orders-badge hidden" id="shopActiveOrdersBadge">
            <span class="shop-active-orders-text">Активный заказ</span>
            <span class="shop-active-orders-count"></span>
          </div>
          <button class="header-btn" id="shopProfileBtn" type="button" aria-label="Профиль">
            <i class="fas fa-user"></i>
          </button>
        </div>
        <div class="user-menu-dropdown" id="userMenuDropdown">
          <div class="user-menu-header">
            <div class="user-menu-avatar">
              <i class="fas fa-user-circle"></i>
            </div>
            <div class="user-menu-info">
              <div class="user-menu-name" id="userMenuName">Загрузка...</div>
              <div class="user-menu-email" id="userMenuEmail"></div>
              <div class="user-menu-tenant" id="userMenuTenant"></div>
              <div class="user-menu-time" id="userMenuTime">--:--:-- UTC</div>
            </div>
          </div>
          <div class="user-menu-divider"></div>

          <!-- Селектор точек продаж -->
          <div class="user-menu-section" id="userMenuStoreSection">
            <div class="user-menu-section-title">Филиал</div>
            <div class="user-menu-store-selector" id="userMenuStoreSelector">
              <button class="user-menu-store-btn" id="userMenuStoreButton" type="button">
                <i class="fas fa-store"></i>
                <span id="userMenuStoreName">Загрузка...</span>
                <i class="fas fa-chevron-down"></i>
              </button>
              <div class="user-menu-store-dropdown hidden" id="userMenuStoreDropdown"></div>
            </div>
          </div>
          <div class="user-menu-divider"></div>

          <div class="user-menu-actions">
            <button class="user-menu-btn" id="userMenuLogout">
              <i class="fas fa-sign-out-alt"></i>
              <span>Выйти</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
