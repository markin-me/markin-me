<div class="toolbar orders-toolbar" id="ordersToolbar">
  <div class="toolbar-left">
    <div class="toolbar-title">
      <% if (activePage === 'orders') { %>
      <label class="products-bulk-toggle-all" title="Выделить все заказы этапа">
        <input class="products-bulk-toggle-all-input" type="checkbox" id="ordersStageToggleAll" aria-label="Выделить все заказы текущего этапа за выбранный период" />
        <span class="products-bulk-toggle-all-box" aria-hidden="true"></span>
      </label>
      <% } %>
      <i class="fas fa-shopping-cart"></i>
      <span id="ordersToolbarTitle"><%= activePage === 'new-order' ? 'Новый заказ' : 'Заказы' %></span>
    </div>
    <% if (activePage === 'orders') { %>
      <div id="ordersConnectionBannerDesktop" class="courier-connection-banner orders-connection-banner-desktop hidden" data-orders-connection-banner aria-live="polite" role="status">
        <span class="courier-connection-banner__indicator" aria-hidden="true"></span>
        <span class="courier-connection-banner__text"></span>
        <button
          type="button"
          class="courier-connection-banner__retry hidden"
          data-action="orders-connection-retry"
          aria-label="Повторить обновление"
          title="Повторить"
        >
          <span aria-hidden="true">↻</span>
        </button>
      </div>
    <% } %>
  </div>

  <div class="toolbar-right">
    <% if (activePage === 'orders') { %>
    <form class="cl-search-wrap" id="ordersPhoneSearch" role="search">
      <input class="cl-search-input" id="ordersPhoneSearchInput" type="search" placeholder="№ заказа / телефон" aria-label="Поиск по номеру заказа, контактному телефону или телефону владельца" autocomplete="off" tabindex="-1" />
      <button id="ordersSearchToggle" class="icon-btn cl-search-toggle" type="button" aria-label="Поиск" title="Поиск" aria-controls="ordersPhoneSearchInput" aria-expanded="false">
        <i class="fas fa-search" aria-hidden="true"></i>
      </button>
    </form>
    <% } %>
    <button class="icon-btn hidden" type="button" data-order-print-activity title="Фоновая печать" aria-label="Фоновая печать"><i class="fas fa-print" aria-hidden="true"></i></button>
    <% if (activePage !== 'orders') { %>
    <button class="btn btn-ghost btn-icon" type="button" id="ordersNotifyBtn" title="Включить уведомления о новых заказах" aria-label="Уведомления">
      <i class="fas fa-bell"></i>
    </button>
    <% } %>
    <% if (activePage === 'orders') { %>
    <div class="orders-print-menu">
      <button type="button" class="btn btn-ghost" id="ordersPrintQueueBtn" title="Очередь печати" aria-label="Очередь печати" aria-haspopup="menu" aria-expanded="false"><i class="fas fa-print" aria-hidden="true"></i><span id="ordersPrintQueueCount">—</span><span id="ordersPrintErrorCount" class="orders-print-errors">—</span></button>
      <div id="ordersPrintConnections" class="order-row-popover" popover="manual" role="menu"></div>
    </div>
    <% } %>
    <div class="date-filter" id="ordersDateFilter">
      <button class="btn btn-ghost" type="button" id="ordersDateBtn" aria-haspopup="dialog" aria-expanded="false">
        <i class="fas fa-calendar-day"></i>
        <span class="btn-text" id="ordersDateLabel">Сегодня</span>
      </button>

      <div class="date-popover hidden" id="ordersDatePopover" role="dialog" aria-label="Фильтр даты">
        <div class="date-popover-header">
          <button class="icon-btn btn-xs" id="ordersDatePrev" type="button" aria-label="Предыдущий месяц">
            <i class="fas fa-chevron-left"></i>
          </button>
          <div class="date-popover-title" id="ordersDateTitle"></div>
          <button class="icon-btn btn-xs" id="ordersDateNext" type="button" aria-label="Следующий месяц">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>

        <div class="date-weekdays">
          <span>Пн</span>
          <span>Вт</span>
          <span>Ср</span>
          <span>Чт</span>
          <span>Пт</span>
          <span>Сб</span>
          <span>Вс</span>
        </div>
        <div class="date-grid" id="ordersDateGrid"></div>

        <div class="date-popover-actions">
          <button class="btn btn-ghost btn-sm" id="ordersDateReset" type="button">Сбросить</button>
        </div>
      </div>
    </div>

    <button class="btn btn-primary" type="button" id="ordersAddBtn">
      <i class="fas fa-plus"></i>
    </button>
  </div>
      <div class="toolbar-right orders-selection-actions hidden" id="ordersBulkActions" role="toolbar" aria-label="Управление выделенными заказами">
        <div class="orders-selection-controls">
          <div class="orders-selection-count">
            <label class="products-bulk-toggle-all" title="Выделить все / снять выделение">
              <input class="products-bulk-toggle-all-input" type="checkbox" id="ordersBulkToggleAll" aria-label="Выделить все заказы текущего списка" />
              <span class="products-bulk-toggle-all-box" aria-hidden="true"></span>
            </label>
            <button class="icon-btn" id="ordersBulkPrint" type="button" title="Печать выбранных заказов" aria-label="Печать выбранных заказов"><i class="fas fa-print"></i></button>
            <button class="icon-btn hidden" type="button" data-order-print-activity title="Фоновая печать" aria-label="Фоновая печать"><i class="fas fa-print" aria-hidden="true"></i></button>
            <span>Выбрано: <b id="ordersBulkSelectedCount" aria-live="polite">0</b></span>
          </div>
          <button class="icon-btn" id="ordersBulkClear" type="button" title="Снять всё выделение" aria-label="Снять всё выделение"><i class="fas fa-times"></i></button>
        </div>
      </div>
</div>
