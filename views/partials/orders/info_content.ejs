<div class="order-info-empty empty-state" data-info="empty">
  <div class="empty-icon"><i class="fas fa-receipt"></i></div>
  <div class="empty-title">Выберите заказ слева</div>
  <div class="empty-text">Чтобы увидеть детали заказа, выберите его в списке.</div>
</div>

<div class="order-info-cards hidden" data-info="content">
  <div class="info-card order-info-head">
    <div class="order-head-top">
      <div class="order-head-title-row">
        <span class="order-refund-badge hidden" data-info="refund-badge">Возврат</span>
        <span class="order-head-title" data-info="order-title">ЗАКАЗ #—</span>
        <span class="order-head-meta muted" data-info="order-meta">—</span>
      </div>
    </div>
  </div>

  <div class="info-card order-info-delivery">
    <div class="delivery-kv">
      <div class="delivery-kv-row">
        <span class="delivery-kv-label">Статус</span>
        <div class="delivery-kv-value delivery-kv-value-status">
          <div class="order-status-inline" data-role="order-inline-status">
            <button
              class="order-status-inline-trigger"
              type="button"
              data-action="order-status-menu-toggle"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span data-info="order-status">—</span>
              <i class="fas fa-chevron-down order-status-inline-chevron" aria-hidden="true"></i>
            </button>
            <div class="order-status-inline-dropdown hidden" data-role="order-status-menu" role="listbox"></div>
          </div>
        </div>
      </div>

      <div class="delivery-kv-row hidden" data-info="delivery-interval-row">
        <span class="delivery-kv-label">Время доставки</span>
        <span class="delivery-kv-value" data-info="delivery-interval">—</span>
      </div>

      <div class="delivery-kv-row hidden" data-info="delivery-urgent">
        <span class="delivery-kv-label">Срочность</span>
        <span class="delivery-kv-value delivery-kv-value-urgent">Срочно</span>
      </div>

      <div class="delivery-kv-row">
        <span class="delivery-kv-label">Клиент</span>
        <span class="delivery-kv-value" data-info="client-name">—</span>
      </div>

      <div class="delivery-kv-row">
        <span class="delivery-kv-label">Телефон</span>
        <a class="delivery-kv-value delivery-kv-link" data-info="client-phone" href="#">—</a>
      </div>
    </div>

    <div class="delivery-address-block">
      <div class="delivery-section-title" data-info="delivery-address-title">Адрес доставки</div>
      <div class="delivery-address" data-info="delivery-address">—</div>
    </div>

    <div class="delivery-address-comment muted hidden" data-info="delivery-address-comment">
      <span class="comment-label">Комментарий к адресу:</span>
      <span data-info="delivery-address-comment-text"></span>
    </div>
    <div class="order-comment-block muted hidden" data-info="order-comment-block">
      <span class="comment-label">Комментарий к заказу:</span>
      <span data-info="order-comment-text"></span>
    </div>
  </div>

  <div class="info-card order-info-items">
    <div class="info-title">Состав заказа</div>
    <div class="order-items" data-info="items-list"></div>
  </div>

  <div class="info-card order-summary">
    <div class="order-summary-title">Суммы:</div>
    <div class="order-summary-row">
      <span class="order-summary-label">Оплата</span>
      <span class="order-summary-value">
        <span class="order-summary-pay-icon" data-info="payment-icon"><i class="fas fa-credit-card"></i></span>
        <span data-info="payment-method">—</span>
      </span>
    </div>
    <div class="order-summary-row hidden" data-info="change-from-row">
      <span class="order-summary-label">Сдача с</span>
      <span class="order-summary-value" data-info="change-from">—</span>
    </div>
    <div class="order-summary-row hidden" data-info="change-amount-row">
      <span class="order-summary-label">Сдача</span>
      <span class="order-summary-value" data-info="change-amount">—</span>
    </div>
    <div class="order-summary-row hidden" data-info="subtotal-row">
      <span class="order-summary-label">Сумма товаров</span>
      <span class="order-summary-value" data-info="subtotal">—</span>
    </div>
    <div class="order-summary-row hidden" data-info="discount-row">
      <span class="order-summary-discount-label-wrap">
        <span class="order-summary-label">Скидка</span>
        <button
          class="order-summary-discount-info-btn"
          type="button"
          data-info="discount-info-btn"
          aria-label="Показать расшифровку скидки"
          aria-expanded="false"
        >
          <i class="fas fa-info"></i>
        </button>
      </span>
      <span class="order-summary-value order-summary-discount" data-info="discount-amount">—</span>
    </div>
    <div class="order-summary-discount-breakdown hidden" data-info="discount-breakdown" aria-hidden="true"></div>
    <div class="order-summary-row hidden" data-info="delivery-row">
      <span class="order-summary-label">Доставка</span>
      <span class="order-summary-value" data-info="delivery-cost">—</span>
    </div>
    <div class="order-summary-row hidden" data-info="refund-state-row">
      <span class="order-summary-label">Возврат</span>
      <span class="order-summary-value" data-info="refund-state">—</span>
    </div>
    <div class="order-summary-row hidden" data-info="refunded-total-row">
      <span class="order-summary-label">Возвращено</span>
      <span class="order-summary-value order-summary-refund is-negative" data-info="refunded-total">—</span>
    </div>
    <div class="order-summary-row hidden" data-info="refundable-total-row">
      <span class="order-summary-label">Доступно к возврату</span>
      <span class="order-summary-value" data-info="refundable-total">—</span>
    </div>
    <div class="order-summary-divider"></div>
    <div class="order-summary-total-row">
      <span class="order-summary-total-label">ИТОГО</span>
      <span class="order-summary-total-value" data-info="order-total">—</span>
    </div>
    <div class="order-refund-history hidden" data-info="refund-history-block">
      <div class="order-refund-history-title">История возвратов</div>
      <div class="order-refund-history-list" data-info="refund-history"></div>
    </div>
    <div class="order-summary-thanks">Спасибо за заказ!</div>
  </div>
</div>

<% if (typeof includeClientProfile === 'undefined' || includeClientProfile) { %>
<%- include('../clients/profile_content') %>
<% } %>
