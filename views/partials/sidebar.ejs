<aside id="app-sidebar" class="panel app-sidebar">
  <% const sidebarTenantChatWidgetRaw = (typeof tenant !== 'undefined' && tenant) ? tenant.chat_widget_enabled : undefined; %>
  <% const sidebarTenantChatWidgetNorm = String(sidebarTenantChatWidgetRaw == null ? '' : sidebarTenantChatWidgetRaw).trim().toLowerCase(); %>
  <% const isSidebarChatEnabled = !(
       sidebarTenantChatWidgetRaw === 0
       || sidebarTenantChatWidgetRaw === false
       || sidebarTenantChatWidgetNorm === '0'
       || sidebarTenantChatWidgetNorm === 'false'
     ); %>
  <nav class="app-sidebar-nav no-scrollbar">
    <ul class="app-sidebar-list">
      <li>
        <a href="/dashboard/cash" class="nav-item <%= activePage === 'cash' ? 'active-nav' : '' %>">
          <i class="fas fa-cash-register nav-icon"></i>
          <span class="nav-text">Касса</span>
        </a>
      </li>
      <li>
        <a href="/dashboard/products" class="nav-item <%= activePage === 'products' ? 'active-nav' : '' %>">
          <i class="fas fa-box nav-icon"></i>
          <span class="nav-text">Товары</span>
        </a>
      </li>

      <li>
        <a href="/dashboard/orders" id="sidebarOrdersNavLink" class="nav-item nav-item--chat nav-item--orders <%= activePage === 'orders' ? 'active-nav' : '' %>">
          <i class="fas fa-shopping-cart nav-icon"></i>
          <span class="sidebar-chat-unread hidden" id="sidebarOrdersUnreadBadge" aria-live="polite" aria-atomic="true"></span>
          <span class="nav-text">Заказы</span>
        </a>
      </li>

      <li>
        <a href="/dashboard/new-order" class="nav-item <%= activePage === 'new-order' ? 'active-nav' : '' %>">
          <i class="fas fa-plus-circle nav-icon"></i>
          <span class="nav-text">Новый заказ</span>
        </a>
      </li>

      <li>
        <a href="/dashboard/clients" class="nav-item <%= activePage === 'clients' ? 'active-nav' : '' %>">
          <i class="fas fa-bullhorn nav-icon"></i>
          <span class="nav-text">Маркетинг</span>
        </a>
      </li>

      <li>
        <a href="/dashboard/team" class="nav-item <%= activePage === 'team' ? 'active-nav' : '' %>">
          <i class="fas fa-user-tie nav-icon"></i>
          <span class="nav-text">Команда</span>
        </a>
      </li>

      <li class="<%= isSidebarChatEnabled ? '' : 'hidden' %>">
        <a href="/dashboard/chat" id="sidebarChatNavLink" class="nav-item nav-item--chat <%= activePage === 'chat' ? 'active-nav' : '' %>">
          <i class="fas fa-comments nav-icon"></i>
          <span class="nav-text">Чаты</span>
          <span class="sidebar-chat-unread hidden" id="sidebarChatUnreadBadge" aria-live="polite" aria-atomic="true"></span>
        </a>
      </li>

      <li>
        <a href="/dashboard/settings" class="nav-item <%= activePage === 'settings' ? 'active-nav' : '' %>">
          <i class="fas fa-cog nav-icon"></i>
          <span class="nav-text">Настройки</span>
        </a>
      </li>
    </ul>
  </nav>
  <button id="sidebar-edge-toggle" class="sidebar-edge-toggle" type="button" aria-label="Свернуть/развернуть меню">
    <i class="fas fa-chevron-left sidebar-edge-icon sidebar-edge-expanded" aria-hidden="true"></i>
    <i class="fas fa-chevron-right sidebar-edge-icon sidebar-edge-collapsed" aria-hidden="true"></i>
  </button>
</aside>
<div id="sidebar-open-tab" class="sidebar-open-tab" aria-label="Открыть меню" title="Открыть меню"><i class="fas fa-chevron-right"></i></div>
